[{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/496942256","html_url":"https://github.com/spdx/license-list-XML/issues/867#issuecomment-496942256","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/867","id":496942256,"node_id":"MDEyOklzc3VlQ29tbWVudDQ5Njk0MjI1Ng==","user":{"login":"rohieb","id":192014,"node_id":"MDQ6VXNlcjE5MjAxNA==","avatar_url":"https://avatars.githubusercontent.com/u/192014?v=4","gravatar_id":"","url":"https://api.github.com/users/rohieb","html_url":"https://github.com/rohieb","followers_url":"https://api.github.com/users/rohieb/followers","following_url":"https://api.github.com/users/rohieb/following{/other_user}","gists_url":"https://api.github.com/users/rohieb/gists{/gist_id}","starred_url":"https://api.github.com/users/rohieb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rohieb/subscriptions","organizations_url":"https://api.github.com/users/rohieb/orgs","repos_url":"https://api.github.com/users/rohieb/repos","events_url":"https://api.github.com/users/rohieb/events{/privacy}","received_events_url":"https://api.github.com/users/rohieb/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-05-29T13:43:24Z","updated_at":"2019-05-29T13:43:24Z","body":"The other supplemental URLs which I submitted in the form somehow didn't make it into the issue:\r\n* https://salsa.debian.org/ssh-team/openssh/blob/master/debian/copyright\r\n* https://enterprise.dejacode.com/licenses/public/openssh/","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/496942256/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/497370972","html_url":"https://github.com/spdx/license-list-XML/issues/867#issuecomment-497370972","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/867","id":497370972,"node_id":"MDEyOklzc3VlQ29tbWVudDQ5NzM3MDk3Mg==","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-05-30T15:26:54Z","updated_at":"2019-05-30T15:26:54Z","body":"this file has 8 licenses listed for different files/part of the code (and some of the parts seemed to contain multiple licenses themselves). some of the licenses listed are already on the SPDX License List - is this request to add just the license in part 1?","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/497370972/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/497479375","html_url":"https://github.com/spdx/license-list-XML/issues/867#issuecomment-497479375","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/867","id":497479375,"node_id":"MDEyOklzc3VlQ29tbWVudDQ5NzQ3OTM3NQ==","user":{"login":"rohieb","id":192014,"node_id":"MDQ6VXNlcjE5MjAxNA==","avatar_url":"https://avatars.githubusercontent.com/u/192014?v=4","gravatar_id":"","url":"https://api.github.com/users/rohieb","html_url":"https://github.com/rohieb","followers_url":"https://api.github.com/users/rohieb/followers","following_url":"https://api.github.com/users/rohieb/following{/other_user}","gists_url":"https://api.github.com/users/rohieb/gists{/gist_id}","starred_url":"https://api.github.com/users/rohieb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rohieb/subscriptions","organizations_url":"https://api.github.com/users/rohieb/orgs","repos_url":"https://api.github.com/users/rohieb/repos","events_url":"https://api.github.com/users/rohieb/events{/privacy}","received_events_url":"https://api.github.com/users/rohieb/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-05-30T20:44:34Z","updated_at":"2019-05-30T20:44:34Z","body":"Ah yes. The license text I submitted in the [form](http://13.57.134.254/app/submit_new_license/) also didn't make it here, I see :) It was meant to be only the first part from the links:\r\n\r\n```\r\nCopyright (c) 1995 Tatu Ylonen <ylo@cs.hut.fi>, Espoo, Finland\r\nAll rights reserved\r\n\r\nAs far as I am concerned, the code I have written for this software\r\ncan be used freely for any purpose.  Any derived versions of this\r\nsoftware must be clearly marked as such, and if the derived work is\r\nincompatible with the protocol description in the RFC file, it must be\r\ncalled by a name other than \"ssh\" or \"Secure Shell\".\r\n```","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/497479375/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/499217375","html_url":"https://github.com/spdx/license-list-XML/issues/867#issuecomment-499217375","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/867","id":499217375,"node_id":"MDEyOklzc3VlQ29tbWVudDQ5OTIxNzM3NQ==","user":{"login":"swinslow","id":678569,"node_id":"MDQ6VXNlcjY3ODU2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/678569?v=4","gravatar_id":"","url":"https://api.github.com/users/swinslow","html_url":"https://github.com/swinslow","followers_url":"https://api.github.com/users/swinslow/followers","following_url":"https://api.github.com/users/swinslow/following{/other_user}","gists_url":"https://api.github.com/users/swinslow/gists{/gist_id}","starred_url":"https://api.github.com/users/swinslow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/swinslow/subscriptions","organizations_url":"https://api.github.com/users/swinslow/orgs","repos_url":"https://api.github.com/users/swinslow/repos","events_url":"https://api.github.com/users/swinslow/events{/privacy}","received_events_url":"https://api.github.com/users/swinslow/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-06-05T19:14:06Z","updated_at":"2019-06-05T19:14:06Z","body":"Hmmm... this is an interesting (and messy) one. \r\n\r\nIf we'd be trying to capture Tatu's original license, then based on the text from https://github.com/openssh/openssh-portable/blob/V_7_3_P1/LICENCE, it reads to me like it should be:\r\n- both parts prefixed by `*` (lines 10-17 and 20-25), and\r\n- the two paragraphs after `the license continues` (lines 44-53), and\r\n- the `NO WARRANTY` all-caps text (lines 58-76).\r\n\r\nBut that's just guessing, based on the modified original license text that openssh is using here.\r\n\r\n@rohieb, do you know if there's anywhere still available online where we can find the original code (and license text) from Tatu Ylonen, where it hasn't been modified / edited as in the examples here?","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/499217375/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/499229550","html_url":"https://github.com/spdx/license-list-XML/issues/867#issuecomment-499229550","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/867","id":499229550,"node_id":"MDEyOklzc3VlQ29tbWVudDQ5OTIyOTU1MA==","user":{"login":"rohieb","id":192014,"node_id":"MDQ6VXNlcjE5MjAxNA==","avatar_url":"https://avatars.githubusercontent.com/u/192014?v=4","gravatar_id":"","url":"https://api.github.com/users/rohieb","html_url":"https://github.com/rohieb","followers_url":"https://api.github.com/users/rohieb/followers","following_url":"https://api.github.com/users/rohieb/following{/other_user}","gists_url":"https://api.github.com/users/rohieb/gists{/gist_id}","starred_url":"https://api.github.com/users/rohieb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rohieb/subscriptions","organizations_url":"https://api.github.com/users/rohieb/orgs","repos_url":"https://api.github.com/users/rohieb/repos","events_url":"https://api.github.com/users/rohieb/events{/privacy}","received_events_url":"https://api.github.com/users/rohieb/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-06-05T19:50:39Z","updated_at":"2019-06-05T19:50:39Z","body":"Huh, that's a good question. I've never encountered the original license, only the ones used by OpenSSH and dropbear, and the latter only uses the first paragraph (lines 10-17 in your link). So that sounds kind of like the BSD 1/2/3-clause situation to me… :)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/499229550/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/516879027","html_url":"https://github.com/spdx/license-list-XML/issues/867#issuecomment-516879027","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/867","id":516879027,"node_id":"MDEyOklzc3VlQ29tbWVudDUxNjg3OTAyNw==","user":{"login":"pombredanne","id":675997,"node_id":"MDQ6VXNlcjY3NTk5Nw==","avatar_url":"https://avatars.githubusercontent.com/u/675997?v=4","gravatar_id":"","url":"https://api.github.com/users/pombredanne","html_url":"https://github.com/pombredanne","followers_url":"https://api.github.com/users/pombredanne/followers","following_url":"https://api.github.com/users/pombredanne/following{/other_user}","gists_url":"https://api.github.com/users/pombredanne/gists{/gist_id}","starred_url":"https://api.github.com/users/pombredanne/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pombredanne/subscriptions","organizations_url":"https://api.github.com/users/pombredanne/orgs","repos_url":"https://api.github.com/users/pombredanne/repos","events_url":"https://api.github.com/users/pombredanne/events{/privacy}","received_events_url":"https://api.github.com/users/pombredanne/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-07-31T14:41:11Z","updated_at":"2019-07-31T14:41:11Z","body":"\r\n@swinslow you would have to go far back last century to find anything but what is in the current openssh or dropbear licenses.\r\nHere is the first occurrence in the CSV ;] for openssh, https://cvsweb.openbsd.org/cgi-bin/cvsweb/~checkout~/src/usr.bin/ssh/LICENCE?rev=1.1&content-type=text/plain about 20 years ago.\r\n\r\nEarlier would be 1.0: https://ftp.nluug.nl/security/ssh/old/ssh-1.0.0.tar.gz\r\nand 1.2: https://ftp.nluug.nl/security/ssh/old/ssh-1.2.0.tar.gz\r\nBut these are likely different licenses... and the versions in between are even more funky (licensing-wise)\r\n \r\nFWIW this has been tracked as the `tatu-ylonen` license in Scancode: https://github.com/nexB/scancode-toolkit/blob/develop/src/licensedcode/data/licenses/tatu-ylonen.LICENSE\r\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/516879027/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/519539319","html_url":"https://github.com/spdx/license-list-XML/issues/867#issuecomment-519539319","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/867","id":519539319,"node_id":"MDEyOklzc3VlQ29tbWVudDUxOTUzOTMxOQ==","user":{"login":"swinslow","id":678569,"node_id":"MDQ6VXNlcjY3ODU2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/678569?v=4","gravatar_id":"","url":"https://api.github.com/users/swinslow","html_url":"https://github.com/swinslow","followers_url":"https://api.github.com/users/swinslow/followers","following_url":"https://api.github.com/users/swinslow/following{/other_user}","gists_url":"https://api.github.com/users/swinslow/gists{/gist_id}","starred_url":"https://api.github.com/users/swinslow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/swinslow/subscriptions","organizations_url":"https://api.github.com/users/swinslow/orgs","repos_url":"https://api.github.com/users/swinslow/repos","events_url":"https://api.github.com/users/swinslow/events{/privacy}","received_events_url":"https://api.github.com/users/swinslow/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-08-08T14:21:10Z","updated_at":"2019-08-08T14:21:10Z","body":"Thanks @pombredanne. So it looks like Scancode uses `tatu-ylonen` to reference the first 5 lines of that \"original\" license.\r\n\r\nHaving now spent more time than I should have doing archaeology into this  =)  here are some thoughts:\r\n\r\nWhere this notice appears outside of OpenSSH, it appears to be just those same 5 lines. Examples:\r\n- http://ftp.nchc.org.tw/NetBSD/NetBSD-current/src/crypto/external/bsd/openssh/dist/pathnames.h\r\n- http://web.mit.edu/kolya/.f/root/athena.mit.edu/sipb.mit.edu/project/openssh/OldFiles/src/openssh-2.9.9p2/ssh-add.1 (also includes BSD-2-Clause below it)\r\n- https://joinup.ec.europa.eu/svn/lesoll/trunk/italc/lib/src/dsa_key.cpp (scroll down - GPL and other notices at top)\r\n\r\nAll of which suggests that this short version functioned as a standalone license for at least some code.\r\n\r\nHowever, [this](https://web.archive.org/web/20070909182914/https://wwwcip.informatik.uni-erlangen.de/~msfriedl/LIC/ssh-1.2.12/COPYING) appears to be a copy of the COPYING file from 1.2.12, which [OpenSSH describes](https://www.openssh.com/history.html) as the release they worked from.\r\n\r\nAnd it appears that OpenSSH annotated that version into the text that makes up item 1 in https://github.com/openssh/openssh-portable/blob/V_7_3_P1/LICENCE. It's this annotated version that appears to be widely used, given OpenSSH's use in the wild.\r\n\r\nSo I'd suggest we add two entries to the SPDX License List:\r\n1) The first, for the \"short\" 5-line version reflected in https://github.com/nexB/scancode-toolkit/blob/develop/src/licensedcode/data/licenses/tatu-ylonen.LICENSE\r\n2) The second, for the text that currently makes up the entirety of item 1 from https://github.com/openssh/openssh-portable/blob/V_7_3_P1/LICENCE -- including the \"annotations\" there\r\n\r\nDoes that all make sense? If so, we'll just want to sort out names and identifiers for these two versions that would hopefully help to minimize the confusion...","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/519539319/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/520568884","html_url":"https://github.com/spdx/license-list-XML/issues/867#issuecomment-520568884","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/867","id":520568884,"node_id":"MDEyOklzc3VlQ29tbWVudDUyMDU2ODg4NA==","user":{"login":"rohieb","id":192014,"node_id":"MDQ6VXNlcjE5MjAxNA==","avatar_url":"https://avatars.githubusercontent.com/u/192014?v=4","gravatar_id":"","url":"https://api.github.com/users/rohieb","html_url":"https://github.com/rohieb","followers_url":"https://api.github.com/users/rohieb/followers","following_url":"https://api.github.com/users/rohieb/following{/other_user}","gists_url":"https://api.github.com/users/rohieb/gists{/gist_id}","starred_url":"https://api.github.com/users/rohieb/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rohieb/subscriptions","organizations_url":"https://api.github.com/users/rohieb/orgs","repos_url":"https://api.github.com/users/rohieb/repos","events_url":"https://api.github.com/users/rohieb/events{/privacy}","received_events_url":"https://api.github.com/users/rohieb/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-08-12T19:48:28Z","updated_at":"2019-08-12T19:48:28Z","body":"Thank you for adding more research to this!\r\n\r\n> Where this notice appears outside of OpenSSH, it appears to be just those same 5 lines. Examples:\r\n> […]\r\n> All of which suggests that this short version functioned as a standalone license for at least some code.\r\n\r\nAgreed.\r\n\r\n> However, [this](https://web.archive.org/web/20070909182914/https://wwwcip.informatik.uni-erlangen.de/~msfriedl/LIC/ssh-1.2.12/COPYING) appears to be a copy of the COPYING file from 1.2.12, which [OpenSSH describes](https://www.openssh.com/history.html) as the release they worked from.\r\n> \r\n> And it appears that OpenSSH annotated that version into the text that makes up item 1 in https://github.com/openssh/openssh-portable/blob/V_7_3_P1/LICENCE. It's this annotated version that appears to be widely used, given OpenSSH's use in the wild.\r\n\r\nThe very first Git commit of OpenSSH also has a file [https://github.com/openssh/openssh-portable/blob/d4a8b7e34dd619a4debf9a206c81db26d1402ea6/COPYING.Ylonen COPYING.Ylonen], which also includes the original SSH license with the warranty disclaimer at the end, except for the parts about the code base that was stripped out. Otherwise the text is the same as in your linked version. So I can follow your argument here.\r\n\r\n> So I'd suggest we add two entries to the SPDX License List:\r\n\r\nAgreed.\r\n\r\n> 1. The first, for the \"short\" 5-line version reflected in https://github.com/nexB/scancode-toolkit/blob/develop/src/licensedcode/data/licenses/tatu-ylonen.LICENSE\r\n\r\nI did not find any other licenses related to Tatu Ylonen until now, but I think this text is specific to SSH, so I would include it in the identifiers. We could use `Ylonen-SSH` and `Tatu Ylonen SSH License` for that one.\r\n\r\n> 2. The second, for the text that currently makes up the entirety of item 1 from https://github.com/openssh/openssh-portable/blob/V_7_3_P1/LICENCE -- including the \"annotations\" there\r\n\r\nFor version 2, I would suggest the identifiers `Ylonen-OpenSSH` and `Tatu Ylonen SSH License (annotated version used by OpenSSH)`.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/520568884/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/537955384","html_url":"https://github.com/spdx/license-list-XML/issues/867#issuecomment-537955384","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/867","id":537955384,"node_id":"MDEyOklzc3VlQ29tbWVudDUzNzk1NTM4NA==","user":{"login":"swinslow","id":678569,"node_id":"MDQ6VXNlcjY3ODU2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/678569?v=4","gravatar_id":"","url":"https://api.github.com/users/swinslow","html_url":"https://github.com/swinslow","followers_url":"https://api.github.com/users/swinslow/followers","following_url":"https://api.github.com/users/swinslow/following{/other_user}","gists_url":"https://api.github.com/users/swinslow/gists{/gist_id}","starred_url":"https://api.github.com/users/swinslow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/swinslow/subscriptions","organizations_url":"https://api.github.com/users/swinslow/orgs","repos_url":"https://api.github.com/users/swinslow/repos","events_url":"https://api.github.com/users/swinslow/events{/privacy}","received_events_url":"https://api.github.com/users/swinslow/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-10-03T13:52:58Z","updated_at":"2019-10-03T13:52:58Z","body":"Thanks @rohieb. All sounds good to me, except I'm going to suggest `SSH-short` for the first one and `SSH-OpenSSH` for the second, to avoid using individuals' names in the license identifiers themselves.\r\n\r\nThese two formats were discussed briefly during the prior legal team call, and I'll raise them again on today's call to see if we can finalize for the upcoming 3.7 release.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/537955384/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML