.com/u/1179636?v=4","gravatar_id":"","url":"https://api.github.com/users/richardfontana","html_url":"https://github.com/richardfontana","followers_url":"https://api.github.com/users/richardfontana/followers","following_url":"https://api.github.com/users/richardfontana/following{/other_user}","gists_url":"https://api.github.com/users/richardfontana/gists{/gist_id}","starred_url":"https://api.github.com/users/richardfontana/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/richardfontana/subscriptions","organizations_url":"https://api.github.com/users/richardfontana/orgs","repos_url":"https://api.github.com/users/richardfontana/repos","events_url":"https://api.github.com/users/richardfontana/events{/privacy}","received_events_url":"https://api.github.com/users/richardfontana/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-12-21T15:37:58Z","updated_at":"2022-12-21T15:37:58Z","body":"I just noticed the following similar license:\r\n\r\n```\r\nCopyright (C) 2004, 2005, 2006 by the Massachusetts Institute of Technology.\r\nAll rights reserved.\r\n \r\n    Export of this software from the United States of America may\r\n    require a specific license from the United States Government.\r\n    It is the responsibility of any person or organization contemplating\r\n    export to obtain such a license before exporting.\r\n \r\n  WITHIN THAT CONSTRAINT, permission to use, copy, modify, and\r\n  distribute this software and its documentation for any purpose and\r\n  without fee is hereby granted, provided that the above copyright\r\n  notice appear in all copies and that both that copyright notice and\r\n  this permission notice appear in supporting documentation, and that\r\n  the name of M.I.T. not be used in advertising or publicity pertaining\r\n  to distribution of the software without specific, written prior\r\n  permission.  Furthermore if you modify this software you must label\r\n  your software as modified software and not distribute it in such a\r\n  fashion that it might be confused with the original M.I.T. software.\r\n  M.I.T. makes no representations about the suitability of\r\n  this software for any purpose.  It is provided \"as is\" without express\r\n  or implied warranty.\r\n```\r\n\r\nThis seems to differ in adding the sentence `Furthermore if you modify this software you must label\r\n  your software as modified software and not distribute it in such a\r\n  fashion that it might be confused with the original M.I.T. software.` Should that variant be submitted as a separate license? I believe it covers at least some source files in the Fedora krb5 package.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1361513366/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1362217211","html_url":"https://github.com/spdx/license-list-XML/issues/1724#issuecomment-1362217211","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1724","id":1362217211,"node_id":"IC_kwDOA0JFE85RMcj7","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-12-21T23:28:48Z","updated_at":"2022-12-21T23:28:48Z","body":"@richardfontana - ugh, yes, that would be a different license","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1362217211/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1363352809","html_url":"https://github.com/spdx/license-list-XML/issues/1724#issuecomment-1363352809","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1724","id":1363352809,"node_id":"IC_kwDOA0JFE85RQxzp","user":{"login":"swinslow","id":678569,"node_id":"MDQ6VXNlcjY3ODU2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/678569?v=4","gravatar_id":"","url":"https://api.github.com/users/swinslow","html_url":"https://github.com/swinslow","followers_url":"https://api.github.com/users/swinslow/followers","following_url":"https://api.github.com/users/swinslow/following{/other_user}","gists_url":"https://api.github.com/users/swinslow/gists{/gist_id}","starred_url":"https://api.github.com/users/swinslow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/swinslow/subscriptions","organizations_url":"https://api.github.com/users/swinslow/orgs","repos_url":"https://api.github.com/users/swinslow/repos","events_url":"https://api.github.com/users/swinslow/events{/privacy}","received_events_url":"https://api.github.com/users/swinslow/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-12-22T21:19:04Z","updated_at":"2022-12-22T21:19:04Z","body":"So, apologies all for raising this after the earlier approval, but wanted to raise one thing I just realized regarding the ID and name. (Still +1 to adding this license, just possibly with a different name and ID.)\r\n\r\nAlthough this license text mentions M.I.T. the institution, this isn't really an \"MIT\" license in the way that SPDX generally refers to [the `MIT` license](https://spdx.org/licenses/MIT.html). This is actually essentially a perfect match with [`HPND`](https://spdx.org/licenses/HPND.html), given its optional parts, and with the added export language that was originally flagged.\r\n\r\nGiven that, I'd suggest the following instead for the name and ID:\r\n\r\n* ID: `HPND-export-US`\r\n* Name: HPND with US Government export control warning\r\n\r\n@jlovejoy and others, are you okay with this change? If so, I'm happy to quickly make and submit the PR to add this.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1363352809/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1364159988","html_url":"https://github.com/spdx/license-list-XML/issues/1724#issuecomment-1364159988","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1724","id":1364159988,"node_id":"IC_kwDOA0JFE85RT230","user":{"login":"richardfontana","id":1179636,"node_id":"MDQ6VXNlcjExNzk2MzY=","avatar_url":"https://avatars.githubusercontent.com/u/1179636?v=4","gravatar_id":"","url":"https://api.github.com/users/richardfontana","html_url":"https://github.com/richardfontana","followers_url":"https://api.github.com/users/richardfontana/followers","following_url":"https://api.github.com/users/richardfontana/following{/other_user}","gists_url":"https://api.github.com/users/richardfontana/gists{/gist_id}","starred_url":"https://api.github.com/users/richardfontana/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/richardfontana/subscriptions","organizations_url":"https://api.github.com/users/richardfontana/orgs","repos_url":"https://api.github.com/users/richardfontana/repos","events_url":"https://api.github.com/users/richardfontana/events{/privacy}","received_events_url":"https://api.github.com/users/richardfontana/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-12-23T18:09:52Z","updated_at":"2022-12-23T18:09:52Z","body":"@swinslow good idea, this occurred to me too that \"MIT\" might be undesirable in the name. \r\n\r\nI will hold off on submitting a possible \"HPND-export-US-label\" for now at @jlovejoy's request :smile: There may be a couple of other licenses related to this particular variety, which I'm seeing in the rather complex krb5 package. ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1364159988/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1364755050","html_url":"https://github.com/spdx/license-list-XML/issues/1724#issuecomment-1364755050","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1724","id":1364755050,"node_id":"IC_kwDOA0JFE85RWIJq","user":{"login":"swinslow","id":678569,"node_id":"MDQ6VXNlcjY3ODU2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/678569?v=4","gravatar_id":"","url":"https://api.github.com/users/swinslow","html_url":"https://github.com/swinslow","followers_url":"https://api.github.com/users/swinslow/followers","following_url":"https://api.github.com/users/swinslow/following{/other_user}","gists_url":"https://api.github.com/users/swinslow/gists{/gist_id}","starred_url":"https://api.github.com/users/swi