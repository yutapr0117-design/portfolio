ithub.com/repos/spdx/license-list-XML/issues/comments/2048974715/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2049117774","html_url":"https://github.com/spdx/license-list-XML/issues/2446#issuecomment-2049117774","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/2446","id":2049117774,"node_id":"IC_kwDOA0JFE856Iw5O","user":{"login":"voxik","id":14406,"node_id":"MDQ6VXNlcjE0NDA2","avatar_url":"https://avatars.githubusercontent.com/u/14406?v=4","gravatar_id":"","url":"https://api.github.com/users/voxik","html_url":"https://github.com/voxik","followers_url":"https://api.github.com/users/voxik/followers","following_url":"https://api.github.com/users/voxik/following{/other_user}","gists_url":"https://api.github.com/users/voxik/gists{/gist_id}","starred_url":"https://api.github.com/users/voxik/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/voxik/subscriptions","organizations_url":"https://api.github.com/users/voxik/orgs","repos_url":"https://api.github.com/users/voxik/repos","events_url":"https://api.github.com/users/voxik/events{/privacy}","received_events_url":"https://api.github.com/users/voxik/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-04-11T07:43:07Z","updated_at":"2024-04-11T07:43:07Z","body":"> **ScanCode** matched id: [w3m](https://github.com/nexB/scancode-toolkit/blob/develop/src/licensedcode/data/licenses/w3m.LICENSE)\r\n\r\nRight.\r\n\r\nLooking into this, what caught my attention is that the author mentioned in [SPDX](https://spdx.org/licenses/w3m) is `Akinori Ito`, who is likely the same person as the author of the `pty` Ruby library.\r\n\r\nWhat is also worth of noting is that in the [original commit](https://github.com/ruby/ruby/commit/0a64817fb80016030c03518fb9459f63c11605ea), there is also [Japanese version of the license](https://github.com/ruby/ruby/commit/0a64817fb80016030c03518fb9459f63c11605ea#diff-fedf217c1ce44bda01f0a678d3ff8b198bed478754d699c527a698ad933979a0).\r\n\r\nAlso, if this is deemed that same license as `w3m`, then the `w3m` would not be probably the best identifier.\r\n\r\nMaybe we can ask the author about the license history and evolution?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2049117774/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2216414684","html_url":"https://github.com/spdx/license-list-XML/issues/2446#issuecomment-2216414684","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/2446","id":2216414684,"node_id":"IC_kwDOA0JFE86EG83c","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-07-09T03:58:14Z","updated_at":"2024-07-09T03:58:14Z","body":"Given the difference of \"Use, modification and redistribution of this software is hereby granted, provided that ...\" in `w3m` \r\nversus\r\n\"This software may be redistributed freely for this purpose, in full or in part, provided that...\"  in this license,\r\n\r\nI'd be in favor of adding as a new license. \r\n\r\n(Not sure if @karsten-klein comment above means that ScanCode \"matched\" this license to `w3m`, but I hope not, as that would be an incorrect match.)\r\n\r\nAs for a license name and id, I don't have a strong opinion, so would be inclined to go with @voxik suggestion.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2216414684/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2216692779","html_url":"https://github.com/spdx/license-list-XML/issues/2446#issuecomment-2216692779","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/2446","id":2216692779,"node_id":"IC_kwDOA0JFE86EIAwr","user":{"login":"voxik","id":14406,"node_id":"MDQ6VXNlcjE0NDA2","avatar_url":"https://avatars.githubusercontent.com/u/14406?v=4","gravatar_id":"","url":"https://api.github.com/users/voxik","html_url":"https://github.com/voxik","followers_url":"https://api.github.com/users/voxik/followers","following_url":"https://api.github.com/users/voxik/following{/other_user}","gists_url":"https://api.github.com/users/voxik/gists{/gist_id}","starred_url":"https://api.github.com/users/voxik/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/voxik/subscriptions","organizations_url":"https://api.github.com/users/voxik/orgs","repos_url":"https://api.github.com/users/voxik/repos","events_url":"https://api.github.com/users/voxik/events{/privacy}","received_events_url":"https://api.github.com/users/voxik/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-07-09T06:30:09Z","updated_at":"2024-07-09T06:30:09Z","body":"> (Not sure if @karsten-klein comment above means that ScanCode \"matched\" this license to `w3m`, but I hope not, as that would be an incorrect match.)\r\n\r\nYes, ScanCode (incorrectly) matches this as `w3m`","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2216692779/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2217241416","html_url":"https://github.com/spdx/license-list-XML/issues/2446#issuecomment-2217241416","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/2446","id":2217241416,"node_id":"IC_kwDOA0JFE86EKGtI","user":{"login":"swinslow","id":678569,"node_id":"MDQ6VXNlcjY3ODU2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/678569?v=4","gravatar_id":"","url":"https://api.github.com/users/swinslow","html_url":"https://github.com/swinslow","followers_url":"https://api.github.com/users/swinslow/followers","following_url":"https://api.github.com/users/swinslow/following{/other_user}","gists_url":"https://api.github.com/users/swinslow/gists{/gist_id}","starred_url":"https://api.github.com/users/swinslow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/swinslow/subscriptions","organizations_url":"https://api.github.com/users/swinslow/orgs","repos_url":"https://api.github.com/users/swinslow/repos","events_url":"https://api.github.com/users/swinslow/events{/privacy}","received_events_url":"https://api.github.com/users/swinslow/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-07-09T10:12:08Z","updated_at":"2024-07-09T10:12:08Z","body":"+1 to add as a new license.\r\n\r\nFor the name / ID, I think what @voxik proposed is fine too, though I might suggest capitalizing the \"R\" in the ID to mirror the existing [`Ruby`](https://spdx.org/licenses/Ruby.html) license on the License List. (Not a related license at all; but should probably capitalize Ruby in the same manner for both.) So:\r\n\r\nID: `Ruby-pty`\r\nName: \"Ruby pty extension license\"","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2217241416/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2217782130","html_url":"https://github.com/spdx/license-list-XML/issues/2446#issuecomment-2217782130","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/2446","id":2217782130,"node_id":"IC_kwDOA0JFE86EMKty","user":{"login":"karsten-klein","id":20038021,"node_id":"MDQ6VXNlcjIwMDM4MDIx","avatar_url":"https://avatars.githubusercontent.com/u/20038021?v=4","gravatar_id":"","url":"https://api.github.com/users/karsten-klein","html_url":"https://github.com/karsten-klein","followers_url":"https://api.github.com/users/karsten-klein/followers","following_url":"https://api.github.com/users/karsten-klein/following{/other_user}","gists_url":"https://api.github.com/users/karsten-klein/gists{/gist_id}","starred_url":"https://api.github.com/users/karsten-klein/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/karsten-klein/subscriptions","organizations_url":"https://api.github.com/users/karsten-klein/orgs","repos_url":"https://api.github.com/users/karsten-klein/repos","events_url":"https://api.github.com/users/karsten-klein/events{/privacy}","received_events_url":"https://api.github.com/users/karsten-klein/received_events","type":"User","user_view_type":"public","site_admin":fal