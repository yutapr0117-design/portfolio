ocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1894868601","html_url":"https://github.com/spdx/license-list-XML/issues/2017#issuecomment-1894868601","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/2017","id":1894868601,"node_id":"IC_kwDOA0JFE85w8WZ5","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-01-17T03:13:19Z","updated_at":"2024-01-17T03:13:19Z","body":"Response from Khronos group:\r\n\r\n\"They consider this license obsolete and are no longer using this license. Once they get agreement from the repository owners, they will be converting any other uses of this license to one of their standard outbound licenses.\"\r\n\r\nChecking back to confirm that all uses are within Khronos Group control to update, as old license sometimes die a slow death... but inclination from Khronos Group is to not add to SPDX License List.\r\n\r\nThis would mean markup to MIT","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/licens