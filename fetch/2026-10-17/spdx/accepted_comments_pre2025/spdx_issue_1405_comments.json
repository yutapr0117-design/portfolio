[{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1033807659","html_url":"https://github.com/spdx/license-list-XML/issues/1405#issuecomment-1033807659","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1405","id":1033807659,"node_id":"IC_kwDOA0JFE849nqcr","user":{"login":"swinslow","id":678569,"node_id":"MDQ6VXNlcjY3ODU2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/678569?v=4","gravatar_id":"","url":"https://api.github.com/users/swinslow","html_url":"https://github.com/swinslow","followers_url":"https://api.github.com/users/swinslow/followers","following_url":"https://api.github.com/users/swinslow/following{/other_user}","gists_url":"https://api.github.com/users/swinslow/gists{/gist_id}","starred_url":"https://api.github.com/users/swinslow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/swinslow/subscriptions","organizations_url":"https://api.github.com/users/swinslow/orgs","repos_url":"https://api.github.com/users/swinslow/repos","events_url":"https://api.github.com/users/swinslow/events{/privacy}","received_events_url":"https://api.github.com/users/swinslow/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-02-09T14:16:57Z","updated_at":"2022-02-09T14:16:57Z","body":"# New submission review\r\n\r\n## Has the license been approved by the OSI?\r\n*All OSI-approved license will be included on the SPDX License List, regardless of other factors*\r\n\r\nNo\r\n\r\n## Definitive factors\r\n*These must all be satisfied to allow inclusion in the license list*\r\n\r\n### Is the submitted license unique, that is, it does not match another license already on the License List as per the matching guidelines?\r\n\r\nYes\r\n\r\n### If a software license, does it apply to source code and not only to executables?\r\n\r\nN/A - not a software license\r\n\r\n### Does the license have identifiable and stable text, and is not in the midst of drafting?\r\n\r\nYes, appears to be a historical license\r\n\r\n### Has the license steward, if any, committed to versioning new versions in the future and to not modify it after addition to the list?\r\n\r\nNot sure whether there is a \"license steward\" for this historical license\r\n\r\n## Other factors for inclusion\r\n*Roughly in order of descending importance*\r\n\r\n### 1. Does the license substantially comply with one of the free/open content definitions?\r\n*Approval by the organisation that publishes the definition is not required*\r\n\r\nYes, appears to be sort of a modified version of [HPND](https://spdx.org/licenses/HPND.html) specific to fonts, as a broadly permissive license permitting free use, redistribution and modification.\r\n\r\n### 2. Does the license have substantial use such that it is likely to be encountered (ie. use in many projects, or in one significant project)?\r\n*For recently written licenses, definitive plans for it to be used in at least one significant project satisfies this*\r\n\r\nYes, appears to be used in fonts redistributed by Fedora as well as embedded in some programs in Fedora\r\n\r\n### 3. Is the license structured to be generally usable by anyone, and not specific to one organisation or project?\r\n\r\nSort of? The acknowledgement in the last line is specific to the font author, but that line could be templated if it were to be used elsewhere.\r\n\r\n### 4. Is the license primarily intended to facilitate the free distribution of content with limited restrictions?\r\n\r\nYes\r\n\r\n### 5. Does the license steward support this submission, or is at least aware of and not in opposition of it?\r\n\r\nSee above re: license steward\r\n\r\n## Summary of factors / outcome\r\n*Comments on the totality of these \"other factors\" in light of the SPDX License List's overall goals and objectives*\r\n\r\n+1 to add, as a broadly permissive historical license used in Fedora and likely elsewhere","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1033807659/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1033917382","html_url":"https://github.com/spdx/license-list-XML/issues/1405#issuecomment-1033917382","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1405","id":1033917382,"node_id":"IC_kwDOA0JFE849oFPG","user":{"login":"capfei","id":5489711,"node_id":"MDQ6VXNlcjU0ODk3MTE=","avatar_url":"https://avatars.githubusercontent.com/u/5489711?v=4","gravatar_id":"","url":"https://api.github.com/users/capfei","html_url":"https://github.com/capfei","followers_url":"https://api.github.com/users/capfei/followers","following_url":"https://api.github.com/users/capfei/following{/other_user}","gists_url":"https://api.github.com/users/capfei/gists{/gist_id}","starred_url":"https://api.github.com/users/capfei/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/capfei/subscriptions","organizations_url":"https://api.github.com/users/capfei/orgs","repos_url":"https://api.github.com/users/capfei/repos","events_url":"https://api.github.com/users/capfei/events{/privacy}","received_events_url":"https://api.github.com/users/capfei/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-02-09T15:59:18Z","updated_at":"2022-02-09T15:59:18Z","body":"+1 to add.","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1033917382/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1050088411","html_url":"https://github.com/spdx/license-list-XML/issues/1405#i