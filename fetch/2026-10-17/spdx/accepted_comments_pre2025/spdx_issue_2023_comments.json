[{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1631595023","html_url":"https://github.com/spdx/license-list-XML/issues/2023#issuecomment-1631595023","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/2023","id":1631595023,"node_id":"IC_kwDOA0JFE85hQCoP","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-07-11T22:35:20Z","updated_at":"2023-07-11T22:36:37Z","body":"here is the license text for convenience:\r\n\r\n`\r\nEveryone is permitted to do anything on this program including copying,\r\nmodifying, and improving, unless you try to pretend that you wrote it.\r\ni.e., the above copyright notice has to appear in all copies.\r\nTHE AUTHOR DISCLAIMS ANY RESPONSIBILITY WITH REGARD TO THIS SOFTWARE.`\r\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1631595023/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1634432379","html_url":"https://github.com/spdx/license-list-XML/issues/2023#issuecomment-1634432379","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/2023","id":1634432379,"node_id":"IC_kwDOA0JFE85ha3V7","user":{"login":"swinslow","id":678569,"node_id":"MDQ6VXNlcjY3ODU2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/678569?v=4","gravatar_id":"","url":"https://api.github.com/users/swinslow","html_url":"https://github.com/swinslow","followers_url":"https://api.github.com/users/swinslow/followers","following_url":"https://api.github.com/users/swinslow/following{/other_user}","gists_url":"https://api.github.com/users/swinslow/gists{/gist_id}","starred_url":"https://api.github.com/users/swinslow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/swinslow/subscriptions","organizations_url":"https://api.github.com/users/swinslow/orgs","repos_url":"https://api.github.com/users/swinslow/repos","events_url":"https://api.github.com/users/swinslow/events{/privacy}","received_events_url":"https://api.github.com/users/swinslow/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-07-13T15:17:02Z","updated_at":"2023-07-13T15:17:02Z","body":"+1 to add as a simple, historical / broadly permissive license. The identifier `SL` and the name \"SL License\" make sense to me given the context for this one.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1634432379/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1646731552","html_url":"https://github.com/spdx/license-list-XML/issues/2023#issuecomment-1646731552","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/2023","id":1646731552,"node_id":"IC_kwDOA0JFE85iJyEg","user":{"login":"BrianInglis","id":23089181,"node_id":"MDQ6VXNlcjIzMDg5MTgx","avatar_url":"https://avatars.githubusercontent.com/u/23089181?v=4","gravatar_id":"","url":"https://api.github.com/users/BrianInglis","html_url":"https://github.com/BrianInglis","followers_url":"https://api.github.com/users/BrianInglis/followers","following_url":"https://api.github.com/users/BrianInglis/following{/other_user}","gists_url":"https://api.github.com/users/BrianInglis/gists{/gist_id}","starred_url":"https://api.github.com/users/BrianInglis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BrianInglis/subscriptions","organizations_url":"https://api.github.com/users/BrianInglis/orgs","repos_url":"https://api.github.com/users/BrianInglis/repos","events_url":"https://api.github.com/users/BrianInglis/events{/privacy}","received_events_url":"https://api.github.com/users/BrianInglis/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-07-23T02:52:16Z","updated_at":"2023-07-23T02:52:16Z","body":"Mandate the identifier SL and similar confusable character sequences *always UPPERCASE* (or using some distinguishing markup, or a longer distinguished contraction) as *GH*, *SPDX*, etc. sites' CSS often use fonts with indistinguishable glyphs for commonly used alphanumeric characters. \r\nI often see no or minimal difference between e.g. *Sl SI S1 51* Sl SI S1 51 **Sl SI S1 51** `Sl SI S1 51` etc. especially below recommended 12-16 points sizes. \r\nHopefully we never have an `SI` licence.\r\n[I had `Sl` and `SI` swapped before correcting the order to put *SL* first in all cases!]","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1646731552/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.g