ithub.com/users/Conan-Kudo/following{/other_user}","gists_url":"https://api.github.com/users/Conan-Kudo/gists{/gist_id}","starred_url":"https://api.github.com/users/Conan-Kudo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Conan-Kudo/subscriptions","organizations_url":"https://api.github.com/users/Conan-Kudo/orgs","repos_url":"https://api.github.com/users/Conan-Kudo/repos","events_url":"https://api.github.com/users/Conan-Kudo/events{/privacy}","received_events_url":"https://api.github.com/users/Conan-Kudo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-04-10T00:34:23Z","updated_at":"2019-04-10T00:34:23Z","body":"I'd really rather be more comfortable with this being OSI reviewed first. Aside from my own misgivings about the license itself (arguably, I think it's dangerously too permissive...), I would rather not see SPDX add new licenses that aren't OSI approved, especially when they have no significant users to warrant an exception.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/481489317/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/481492831","html_url":"https://github.com/spdx/license-list-XML/issues/800#issuecomment-481492831","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/800","id":481492831,"node_id":"MDEyOklzc3VlQ29tbWVudDQ4MTQ5MjgzMQ==","user":{"login":"kemitchell","id":205760,"node_id":"MDQ6VXNlcjIwNTc2MA==","avatar_url":"https://avatars.githubusercontent.com/u/205760?v=4","gravatar_id":"","url":"https://api.github.com/users/kemitchell","html_url":"https://github.com/kemitchell","followers_url":"https://api.github.com/users/kemitchell/followers","following_url":"https://api.github.com/users/kemitchell/following{/other_user}","gists_url":"https://api.github.com/users/kemitchell/gists{/gist_id}","starred_url":"https://api.github.com/users/kemitchell/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kemitchell/subscriptions","organizations_url":"https://api.github.com/users/kemitchell/orgs","repos_url":"https://api.github.com/users/kemitchell/repos","events_url":"https://api.github.com/users/kemitchell/events{/privacy}","received_events_url":"https://api.github.com/users/kemitchell/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-04-10T00:56:10Z","updated_at":"2019-04-10T00:56:10Z","body":"@Conan-Kudo, @jlovejoy can speak to SPDX' criteria and history more authoritatively than I. But I will point out that SPDX has identified many licenses that OSI has not approved, including licenses that nobody expects they would, as well as licenses extending beyond even Blue Oak's permissivity, such as Fair, WTFPL, 0BSD, and MIT-0, that extend into what the Council considers dubious legal territory.\r\n\r\nBlue Oak Council has no current plans to submit its license to OSI, though we won't object if someone else does.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/481492831/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/481619785","html_url":"https://github.com/spdx/license-list-XML/issues/800#issuecomment-481619785","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/800","id":481619785,"node_id":"MDEyOklzc3VlQ29tbWVudDQ4MTYxOTc4NQ==","user":{"login":"Conan-Kudo","id":276796,"node_id":"MDQ6VXNlcjI3Njc5Ng==","avatar_url":"https://avatars.githubusercontent.com/u/276796?v=4","gravatar_id":"","url":"https://api.github.com/users/Conan-Kudo","html_url":"https://github.com/Conan-Kudo","followers_url":"https://api.github.com/users/Conan-Kudo/followers","following_url":"https://api.github.com/users/Conan-Kudo/following{/other_user}","gists_url":"https://api.github.com/users/Conan-Kudo/gists{/gist_id}","starred_url":"https://api.github.com/users/Conan-Kudo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Conan-Kudo/subscriptions","organizations_url":"https://api.github.com/users/Conan-Kudo/orgs","repos_url":"https://api.github.com/users/Conan-Kudo/repos","events_url":"https://api.github.com/users/Conan-Kudo/events{/privacy}","received_events_url":"https://api.github.com/users/Conan-Kudo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-04-10T09:42:21Z","updated_at":"2019-04-10T09:42:21Z","body":"@kemitchell Just because they've done arguably bad things in the past doesn't give them license to keep doing it in the future (heh, pun!). If the Blue Oak Council has no intent to have it peer-reviewed by OSI, then that is enough for me to say that it should not be recognized by SPDX either. OSI's job is to provide a clear list of licenses that follow principles consistent with OSD, DFSG, _et al_, while SPDX's job is to identify those licenses in a way that can be easily checked and referenced.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/481619785/reactions","total_count":3,"+1":2,"-1":1,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/481747337","html_url":"https://github.com/spdx/license-list-XML/issues/800#issuecomment-481747337","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/800","id":481747337,"node_id":"MDEyOklzc3VlQ29tbWVudDQ4MTc0NzMzNw==","user":{"login":"swinslow","id":678569,"node_id":"MDQ6VXNlcjY3ODU2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/678569?v=4","gravatar_id":"","url":"https://api.github.com/users/swinslow","html_url":"https://github.com/swinslow","followers_url":"https://api.github.com/users/swinslow/followers","following_url":"https://api.github.com/users/swinslow/following{/other_user}","gists_url":"https://api.github.com/users/swinslow/gists{/gist_id}","starred_url":"https://api.github.com/users/swinslow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/swinslow/subscriptions","organizations_url":"https://api.github.com/users/swinslow/orgs","repos_url":"https://api.github.com/users/swinslow/repos","events_url":"https://api.github.com/users/swinslow/events{/privacy}","received_events_url":"https://api.github.com/users/swinslow/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-04-10T15:48:09Z","updated_at":"2019-04-10T15:48:09Z","body":"The SPDX legal team does not require OSI approval before adding licenses. If OSI does approve a license, it can be noted with a flag in the XML entry for the license (same for licenses determined by FSF to be free / libre; this can be seen in the right-hand columns at https://spdx.org/licenses).\r\n\r\nThe SPDX License Inclusion Principles can be found at https://spdx.org/spdx-license-list/license-list-overview (this document also provides an overview of the purpose of the SPDX license list)","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/481747337/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/484588322","html_url":"https://github.com/spdx/license-list-XML/issues/800#issuecomment-484588322","issue_url":"https://api.github.com/repos/spdx/license-list-XML/i