9492/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/527687381","html_url":"https://github.com/spdx/license-list-XML/issues/894#issuecomment-527687381","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/894","id":527687381,"node_id":"MDEyOklzc3VlQ29tbWVudDUyNzY4NzM4MQ==","user":{"login":"johnmhoran","id":11096678,"node_id":"MDQ6VXNlcjExMDk2Njc4","avatar_url":"https://avatars.githubusercontent.com/u/11096678?v=4","gravatar_id":"","url":"https://api.github.com/users/johnmhoran","html_url":"https://github.com/johnmhoran","followers_url":"https://api.github.com/users/johnmhoran/followers","following_url":"https://api.github.com/users/johnmhoran/following{/other_user}","gists_url":"https://api.github.com/users/johnmhoran/gists{/gist_id}","starred_url":"https://api.github.com/users/johnmhoran/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/johnmhoran/subscriptions","organizations_url":"https://api.github.com/users/johnmhoran/orgs","repos_url":"https://api.github.com/users/johnmhoran/repos","events_url":"https://api.github.com/users/johnmhoran/events{/privacy}","received_events_url":"https://api.github.com/users/johnmhoran/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-09-04T00:12:52Z","updated_at":"2019-09-04T00:12:52Z","body":"Hi @swinslow .  I'm belatedly tackling this issue, have just completed my initial draft of `UCL-1.0.xml`, and have one item to draw your attention to:\r\n\r\nIn subsection (ii) of Section 16 (Modification of This License), the OSL-3.0 license on which this is based, [as displayed by OSI](https://opensource.org/licenses/OSL-3.0), reads as follows:\r\n\r\n```\r\n(ii) You must replace the notice specified in the first paragraph above with the notice \"Licensed under <insert your license name here>\" . . . .\r\n```\r\n\r\nThe [OSI version of UCL-1.0](https://opensource.org/licenses/UCL-1.0), on the other hand, omits the angle bracketed-language:\r\n\r\n```\r\n(ii) You must replace the notice specified in the first paragraph above with the notice \"Licensed under \" . . . .\r\n```\r\n\r\nI suspect this is inadvertent and have included the missing bracketed language in the new .xml file.  \r\n\r\nWhat is our normal protocol in this sort of circumstance?  (I assume we need to contact the License Author/steward but meanwhile will push and open a PR once I've proofed etc.)","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/527687381/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/527692629","html_url":"https://github.com/spdx/license-list-XML/issues/894#issuecomment-527692629","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/894","id":527692629,"node_id":"MDEyOklzc3VlQ29tbWVudDUyNzY5MjYyOQ==","user":{"login":"swinslow","id":678569,"node_id":"MDQ6VXNlcjY3ODU2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/678569?v=4","gravatar_id":"","url":"https://api.github.com/users/swinslow","html_url":"https://github.com/swinslow","followers_url":"https://api.github.com/users/swinslow/followers","following_url":"https://api.github.com/users/swinslow/following{/other_user}","gists_url":"https://api.github.com/users/swinslow/gists{/gist_id}","starred_url":"https://api.github.com/users/swinslow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/swinslow/subscriptions","organizations_url":"https://api.github.com/users/swinslow/orgs","repos_url":"https://api.github.com/users/swinslow/repos","events_url":"https://api.github.com/users/swinslow/events{/privacy}","received_events_url":"https://api.github.com/users/swinslow/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-09-04T00:41:35Z","updated_at":"2019-09-04T00:41:35Z","body":"Thanks @johnmhoran! Great catch on the missing bracketed language. I suspect you're correct and that the angle-bracketed language got dropped somewhere along the way -- perhaps getting mistaken for an HTML tag somewhere.\r\n\r\nAgree for the moment with creating the PR _including_ the bracketed language you expect to see -- but I think this is something we'd want to raise with OSI for them to confirm / potentially correct on their site.\r\n\r\n@jlovejoy, do you know who at OSI we should mention this to? Can discuss briefly at the beginning of the legal team call on Thursday to give context here...","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/527692629/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/527705998","html_url":"https://github.com/spdx/license-list-XML/issues/894#issuecomment-527705998","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/894","id":527705998,"node_id":"MDEyOklzc3VlQ29tbWVudDUyNzcwNTk5OA==","user":{"login":"johnmhoran","id":11096678,"node_id":"MDQ6VXNlcjExMDk2Njc4","avatar_url":"https://avatars.githubusercontent.com/u/11096678?v=4","gravatar_id":"","url":"https://api.github.com/users/johnmhoran","html_url":"https://github.com/johnmhoran","followers_url":"https://api.github.com/users/johnmhoran/followers","following_url":"https://api.github.com/users/johnmhoran/following{/other_user}","gists_url":"https://api.github.com/users/johnmhoran/gists{/gist_id}","starred_url":"https://api.github.com/users/johnmhoran/starred{/owner}{/repo}","su