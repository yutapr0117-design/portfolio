M THE FURNISHING, PERFORMANCE, OR\r\n> USE OF THIS SOFTWARE.\r\n\r\nFurthermore, we do try to not qualify the license attributes in a fashion that it is legacy, outdated, historic. This is why we introduced the concept _Permission Terms_. There is quite a lot to say about the organization of these Permission Terms and naming conventions. Check the universe for further references. We keep managing, merging, splitting and organizing there continuously.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1962432597/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1998875647","html_url":"https://github.com/spdx/license-list-XML/issues/2395#issuecomment-1998875647","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/2395","id":1998875647,"node_id":"IC_kwDOA0JFE853JGv_","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_a