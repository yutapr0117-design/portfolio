.github.com/users/richardfontana/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/richardfontana/subscriptions","organizations_url":"https://api.github.com/users/richardfontana/orgs","repos_url":"https://api.github.com/users/richardfontana/repos","events_url":"https://api.github.com/users/richardfontana/events{/privacy}","received_events_url":"https://api.github.com/users/richardfontana/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-03-17T17:10:56Z","updated_at":"2023-03-17T17:10:56Z","body":"@jlovejoy Side comment, I am curious why CentOS and Ubuntu wouldn't meet the criteria for a major distro. Considered together, RHEL/CentOS Linux/CentOS Stream is one of the most widely used commercial Linux distributions; of course relatively few packages in it are not also in Fedora since it is derived from Fedora. Ubuntu is also one of the most widely used Linux distributions, both commercially and otherwise; though similarly, I assume relatively few Ubuntu packages are not also in Debian. ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1474149504/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1476488917","html_url":"https://github.com/spdx/license-list-XML/issues/1870#issuecomment-1476488917","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1870","id":1476488917,"node_id":"IC_kwDOA0JFE85YAW7V","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-03-20T15:50:50Z","updated_at":"2023-03-20T15:50:50Z","body":"@richardfontana - the \"major distro\" label was created when we updated the approval process that licenses in Fedora or Debian only needed 2 SPDX legal team members approval to add, versus 3. https://github.com/spdx/license-list-XML/blob/main/DOCS/request-new-license.md#review-process\r\n\r\nThe rationale for starting with Fedora and Debian was that both have their own license criteria. I think it was discussed that we might add more in the future.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1476488917/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1506808105","html_url":"https://github.com/spdx/license-list-XML/issues/1870#issuecomment-1506808105","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1870","id":1506808105,"node_id":"IC_kwDOA0JFE85Z0BEp","user":{"login":"swinslow","id":678569,"node_id":"MDQ6VXNlcjY3ODU2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/678569?v=4","gravatar_id":"","url":"https://api.github.com/users/swinslow","html_url":"https://github.com/swinslow","followers_url":"https://api.github.com/users/swinslow/followers","following_url":"https://api.github.com/users/swinslow/following{/other_user}","gists_url":"https://api.github.com/users/swinslow/gists{/gist_id}","starred_url":"https://api.github.com/users/swinslow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/swinslow/subscriptions","organizations_url":"https://api.github.com/users/swinslow/orgs","repos_url":"https://api.github.com/users/swinslow/repos","events_url":"https://api.github.com/users/swinslow/events{/privacy}","received_events_url":"https://api.github.com/users/swinslow/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-04-13T11:35:15Z","updated_at":"2023-04-13T11:35:15Z","body":"Here's the exception text:\r\n\r\n```\r\nvsftpd is licensed under version 2 of the GNU GPL.\r\nAs copyright holder, I give permission for vsftpd to be linked to the OpenSSL\r\nlibraries. This includes permission for vsftpd binaries to be distributed\r\nlinked against the OpenSSL libraries. All other obligations under the GPL v2\r\nremain intact.\r\n```\r\n\r\n@jlovejoy Are you picturing that we would include the first sentence as well (\"vsftpd is licensed under version 2 of the GNU GPL.\") in the exception? Or just the rest of it (\"As copyright holder, ...\")?\r\n\r\nI'm +1 to add in either case, and fine with the proposed name and ID.\r\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1506808105/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1507192530","html_url":"https://github.com/spdx/license-list-XML/issues/1870#issuecomment-1507192530","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1870","id":1507192530,"node_id":"IC_kwDOA0JFE