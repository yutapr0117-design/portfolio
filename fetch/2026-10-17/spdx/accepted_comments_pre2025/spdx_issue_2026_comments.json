vejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-08-10T15:23:23Z","updated_at":"2023-08-10T15:23:23Z","body":"@n8willis - not sure what you are getting at with your comment above, can you explain? \r\n\r\nDo you think this license should be added to SPDX?","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1673440194/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1673467517","html_url":"https://github.com/spdx/license-list-XML/issues/2026#issuecomment-1673467517","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/2026","id":1673467517,"node_id":"IC_kwDOA0JFE85jvxZ9","user":{"login":"n8willis","id":2192132,"node_id":"MDQ6VXNlcjIxOTIxMzI=","avatar_url":"https://avatars.githubusercontent.com/u/2192132?v=4","gravatar_id":"","url":"https://api.github.com/users/n8willis","html_url":"https://github.com/n8willis","followers_url":"https://api.github.com/users/n8willis/followers","following_url":"https://api.github.com/users/n8willis/following{/other_user}","gists_url":"https://api.github.com/users/n8willis/gists{/gist_id}","starred_url":"https://api.github.com/users/n8willis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/n8willis/subscriptions","organizations_url":"https://api.github.com/users/n8willis/orgs","repos_url":"https://api.github.com/users/n8willis/repos","events_url":"https://api.github.com/users/n8willis/events{/privacy}","received_events_url":"https://api.github.com/users/n8willis/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-08-10T15:37:25Z","updated_at":"2023-08-10T15:37:25Z","body":"> @n8willis - not sure what you are getting at with your comment above, can you explain?\r\n\r\nDidn't mean to be unclear; I was replying to [this comment](https://github.com/spdx/license-list-XML/issues/2026#issuecomment-1650557815) from @copernicat , which seemed — to me — to question whether the license was relevant enough, based on it appearing in the one particular package (in one distro) cited in the original request:\r\n\r\n> If I am viewing this correctly, the upstream package is under GPL-3.0-only, and it contains one font, the TTYP0 font, under its own custom license, THE TTYP0 LICENSE. Does \"used in major distro\" apply to a small subcomponent and rise to the level we expect for new licenses?\r\n\r\nSo I was hoping to clarify that the license comes from a different upstream (the URL linked) and it is not unique to the Fedora package cited in the original request, and it is furthermore found in separate packages in other distributions.\r\n\r\n> Do you think this license should be added to SPDX?\r\n\r\nYes; for the reasons in the preceding paragraph. It's a singleton, but so are a lot of legacy font licenses that predate the OFL family.\r\n\r\nHope that's more straightforward in interpretation!\r\n\r\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1673467517/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1691005041","html_url":"https://github.com/spdx/license-list-XML/issues/2026#issuecomment-1691005041","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/2026","id":1691005041,"node_id"