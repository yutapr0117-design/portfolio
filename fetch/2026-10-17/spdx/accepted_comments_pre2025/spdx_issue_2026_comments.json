.com/users/swinslow/gists{/gist_id}","starred_url":"https://api.github.com/users/swinslow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/swinslow/subscriptions","organizations_url":"https://api.github.com/users/swinslow/orgs","repos_url":"https://api.github.com/users/swinslow/repos","events_url":"https://api.github.com/users/swinslow/events{/privacy}","received_events_url":"https://api.github.com/users/swinslow/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-07-13T15:29:00Z","updated_at":"2023-07-13T15:29:00Z","body":"+1 to add. As noted this is very close to the MIT license, with a few tweaks to the license grant language and an additional requirement to change the font name if modifying or adding glyphs (which as a term is generally consistent with other open-source or open-source-adjacent licenses).\r\n\r\n`TTYP0` as the ID and `TTYP0 License` look good to me.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1634451309/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1650557815","html_url":"https://github.com/spdx/license-list-XML/issues/2026#issuecomment-1650557815","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/2026","id":1650557815,"node_id":"IC_kwDOA0JFE85iYYN3","user":{"login":"copernicat","id":111796332,"node_id":"U_kgDOBqngbA","avatar_url":"https://avatars.githubusercontent.com/u/111796332?v=4","gravatar_id":"","url":"https://api.github.com/users/copernicat","html_url":"https://github.com/copernicat","followers_url":"https://api.github.com/users/copernicat/followers","following_url":"https://api.github.com/users/copernicat/following{/other_user}","gists_url":"https://api.github.com/users/copernicat/gis