[{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/867747224","html_url":"https://github.com/spdx/license-list-XML/issues/1273#issuecomment-867747224","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1273","id":867747224,"node_id":"MDEyOklzc3VlQ29tbWVudDg2Nzc0NzIyNA==","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-06-24T15:47:44Z","updated_at":"2021-06-24T15:47:44Z","body":"Can you please provide any missing info that would have been submitted by way of https://tools.spdx.org/app/submit_new_license/\r\nIt's fine if you don't use the form, but we still need all the same info!\r\nThanks!","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/867747224/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/885063164","html_url":"https://github.com/spdx/license-list-XML/issues/1273#is