[{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1549907147","html_url":"https://github.com/spdx/license-list-XML/issues/1971#issuecomment-1549907147","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1971","id":1549907147,"node_id":"IC_kwDOA0JFE85cYbTL","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-05-16T15:35:13Z","updated_at":"2023-05-16T15:35:13Z","body":"in Fedora, see https://gitlab.com/fedora/legal/fedora-license-data/-/issues/76","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1549907147/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1553936255","html_url":"https://github.com/spdx/license-list-XML/issues/1971#issuecomment-1553936255","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1971","id":1553936255,"node_id":"IC_kwDOA0JFE85cny9_","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-05-19T03:04:32Z","updated_at":"2023-05-19T03:04:32Z","body":"+1 to add, as it's a pretty benign exception ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1553936255/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1555952183","html_url":"https://github.com/spdx/license-list-XML/issues/1971#issuecomment-1555952183","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1971","id":1555952183,"node_id":"IC_kwDOA0JFE85cvfI3","user":{"login":"Pizza-Ria","id":46799628,"node_id":"MDQ6VXNlcjQ2Nzk5NjI4","avatar_url":"https://avatars.githubusercontent.com/u/46799628?v=4","gravatar_id":"","url":"https://api.github.com/users/Pizza-Ria","html_url":"https://github.com/Pizza-Ria","followers_url":"https://api.github.com/users/Pizza-Ria/followers","following_url":"https://api.github.com/users/Pizza-Ria/following{/other_user}","gists_url":"https://api.github.com/users/Pizza-Ria/gists{/gist_id}","starred_url":"https://api.github.com/users/Pizza-Ria/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Pizza-Ria/subscriptions","organizations_url":"https://api.github.com/users/Pizza-Ria/orgs","repos_url":"https://api.github.com/users/Pizza-Ria/repos","events_url":"https://api.github.com/users/Pizza-Ria/events{/privacy}","received_events_url":"https://api.github.com/users/Pizza-Ria/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-05-20T16:59:20Z","updated_at":"2023-05-20T16:59:20Z","body":"Isn't Asterisk under the GPLv2 as well (https://github.com/asterisk/asterisk/blob/master/LICENSE).  Just to be clear, this exception is saying that if you obtain alternative licensing terms for Asterisk then you can combine this module with it and use those alternative licensing terms? That strikes me as a bit extenuated since this is in the same repo as Asterisk ... maybe a solution for a poorly drafted private license + it seems very specific since it is attached to just the Asterisk project.  Per a snippet of @richardfontana's comment in the Fedora issue:  \"The question though is whether it just saying \"If you paid for a non-GPL license from Digium, you can ignore the GPL on this library\" which I would see as not worth capturing with an exception identifier.\"   He goes on to comment that this shouldn't be assumed but I'm having trouble coming up with a practical reason for this exception (per my general antagonism to clutter).  ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1555952183/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1556180299","html_url":"https://github.com/spdx/license-list-XML/issues/1971#issuecomment-1556180299","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1971","id":1556180299,"node_id":"IC_kwDOA0JFE85cwW1L","user":{"login":"musicinmybrain","id":6898909,"node_id":"MDQ6VXNlcjY4OTg5MDk=","avatar_url":"https://avatars.githubusercontent.com/u/6898909?v=4","gravatar_id":"","url":"https://api.github.com/users/musicinmybrain","html_url":"https://github.com/musicinmybrain","followers_url":"https://api.github.com/users/musicinmybrain/followers","following_url":"https://api.github.com/users/musicinmybrain/following{/other_user}","gists_url":"https://api.github.com/users/musicinmybrain/gists{/gist_id}","starred_url":"https://api.github.com/users/musicinmybrain/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/musicinmybrain/subscriptions","organizations_url":"https://api.github.com/users/musicinmybrain/orgs","repos_url":"https://api.github.com/users/musicinmybrain/repos","events_url":"https://api.github.com/users/musicinmybrain/events{/privacy}","received_events_url":"https://api.github.com/users/musicinmybrain/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-05-21T13:26:26Z","updated_at":"2023-05-21T13:26:26Z","body":"> Isn't Asterisk under the GPLv2 as well (https://github.com/asterisk/asterisk/blob/master/LICENSE).\r\n\r\nYes, Asterisk is GPLv2; I haven’t examined it closely, but I think it is `GPL-2.0-only`.\r\n\r\n> Just to be clear, this exception is saying that if you obtain alternative licensing terms for Asterisk then you can combine this module with it and use those alternative licensing terms? That strikes me as a bit extenuated since this is in the same repo as Asterisk ... maybe a solution for a poorly drafted private license + it seems very specific since it is attached to just the Asterisk project.\r\n\r\nTechnically, it’s not quite right to say that these projects are distributed in the same repository: [libpri](https://github.com/asterisk/libpri/) and [libss7](https://github.com/asterisk/libss7/) are in separate SCM repositories on GitHub under the [`asterisk` organization](https://github.com/asterisk), not in the main [asterisk repository](https://github.com/asterisk/asterisk). Similarly, their releases don’t currently appear to be distributed in the main [asterisk source tarballs](https://www.asterisk.org/downloads/), but have their own download directories under https://downloads.asterisk.org/pub/telephony/.\r\n\r\nIt *is* valid to say that all of these projects fall under the umbrella of the Asterisk organization, that they share some developers, and that all of their copyright statements appear to indicate Digium, Inc. as copyright holder.\r\n\r\nI’m not sure that any of these distinctions are terribly important here, but there they are.\r\n\r\n> Per a snippet of @richardfontana's comment in the Fedora issue: \"The question though is whether it just saying \"If you paid for a non-GPL license from Digium, you can ignore the GPL on this library\" which I would see as not worth capturing with an exception identifier.\" He goes on to comment that this shouldn't be assumed but I'm having trouble coming up with a practical reason for this exception (per my general antagonism to clutter).\r\n\r\nIt seems obvious to me that this exception was written with the intent that it would facilitate Digium’s proprietary/commercial license schemes. In principle, it could still come into play if Digium released a copy of Asterisk under an open-source license other than GPLv2, and included one of these libraries “in any form that would qualify as a 'combined work' or as a 'derivative work' (but not mere aggregation).” This seems unlikely to me, but the future is a big place.\r\n\r\nI don’t have a strong opinion on what should happen here. It would be a bit awkward, practically speaking, to have [`libpri-OpenH23-exception`](https://github.com/spdx/license-list-XML/issues/1939) but not this exception, but in the end I *personally* just need something to put in the `License` tags of the Fedora packages.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1556180299/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1556211485","html_url":"https://github.com/spdx/license-list-XML/issues/1971#issuecomment-1556211485","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1971","id":1556211485,"node_id":"IC_kwDOA0JFE85cwecd","user":{"login":"richardfontana","id":1179636,"node_id":"MDQ6VXNlcjExNzk2MzY=","avatar_url":"https://avatars.githubusercontent.com/u/1179636?v=4","gravatar_id":"","url":"https://api.github.com/users/richardfontana","html_url":"https://github.com/richardfontana","followers_url":"https://api.github.com/users/richardfontana/followers","following_url":"https://api.github.com/users/richardfontana/following{/other_user}","gists_url":"https://api.github.com/users/richardfontana/gists{/gist_id}","starred_url":"https://api.github.com/users/richardfontana/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/richardfontana/subscriptions","organizations_url":"https://api.github.com/users/richardfontana/orgs","repos_url":"https://api.github.com/users/richardfontana/repos","events_url":"https://api.github.com/users/richardfontana/events{/privacy}","received_events_url":"https://api.github.com/users/richardfontana/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-05-21T15:47:24Z","updated_at":"2023-05-21T15:47:24Z","body":"> I don’t have a strong opinion on what should happen here. It would be a bit awkward, practically speaking, to have [`libpri-OpenH23-exception`](https://github.com/spdx/license-list-XML/issues/1939) but not this exception, but in the end I _personally_ just need something to put in the `License` tags of the Fedora packages.\r\n\r\nTo be clear, a decision by SPDX not to create an identifier for a given license/exception has no bearing on whether that particular license/exception should be represented in some way in the Fedora license tag. \r\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1556211485/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1572723312","html_url":"https://github.com/spdx/license-list-XML/issues/1971#issuecomment-1572723312","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1971","id":1572723312,"node_id":"IC_kwDOA0JFE85dvdpw","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-06-01T20:19:44Z","updated_at":"2023-06-01T20:19:44Z","body":"@richardfontana - while that may be correct re: a decision by SPDX for inclusion is separate from a decision by Fedora as to whether this exception should be represented in some way in the Fedora license tag - the reason it was submitted to SPDX to begin with was to represent it in the Fedora license tag, so if you don't think it needs to be represented, then it didn't need to be submitted and the issue in Fedora states it's allowed.\r\n\r\nI have mixed feelings on this one, now that I'm thinking about it more deeply. It doesn't add much of an actual exception other than the scenario that @musicinmybrain explained which seems unlikely, but then... ??","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1572723312/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1572755856","html_url":"https://github.com/spdx/license-list-XML/issues/1971#issuecomment-1572755856","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1971","id":1572755856,"node_id":"IC_kwDOA0JFE85dvlmQ","user":{"login":"richardfontana","id":1179636,"node_id":"MDQ6VXNlcjExNzk2MzY=","avatar_url":"https://avatars.githubusercontent.com/u/1179636?v=4","gravatar_id":"","url":"https://api.github.com/users/richardfontana","html_url":"https://github.com/richardfontana","followers_url":"https://api.github.com/users/richardfontana/followers","following_url":"https://api.github.com/users/richardfontana/following{/other_user}","gists_url":"https://api.github.com/users/richardfontana/gists{/gist_id}","starred_url":"https://api.github.com/users/richardfontana/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/richardfontana/subscriptions","organizations_url":"https://api.github.com/users/richardfontana/orgs","repos_url":"https://api.github.com/users/richardfontana/repos","events_url":"https://api.github.com/users/richardfontana/events{/privacy}","received_events_url":"https://api.github.com/users/richardfontana/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-06-01T20:47:36Z","updated_at":"2023-06-01T20:47:36Z","body":"I think my view on it is: if someone wants to get Digium or the Asterisk maintainers on record saying \"oh, yes, this is just about use with proprietary versions of Asterisk and any other understanding would be preposterous\" or whatever, then we can just choose not to represent it in the Fedora license tag; otherwise we might as well follow the general Fedora practice by adding it to the Fedora license list and including it in the license tag. I'm also okay with delegating the decision to @musicinmybrain. However, this shouldn't be dependent on SPDX's decision. If SPDX decides not to add the exception, but @musicinmybrain wants to include it in the license tag, then we can use an `AdditionRef-` on the Fedora side. ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1572755856/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1573942877","html_url":"https://github.com/spdx/license-list-XML/issues/1971#issuecomment-1573942877","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1971","id":1573942877,"node_id":"IC_kwDOA0JFE85d0HZd","user":{"login":"musicinmybrain","id":6898909,"node_id":"MDQ6VXNlcjY4OTg5MDk=","avatar_url":"https://avatars.githubusercontent.com/u/6898909?v=4","gravatar_id":"","url":"https://api.github.com/users/musicinmybrain","html_url":"https://github.com/musicinmybrain","followers_url":"https://api.github.com/users/musicinmybrain/followers","following_url":"https://api.github.com/users/musicinmybrain/following{/other_user}","gists_url":"https://api.github.com/users/musicinmybrain/gists{/gist_id}","starred_url":"https://api.github.com/users/musicinmybrain/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/musicinmybrain/subscriptions","organizations_url":"https://api.github.com/users/musicinmybrain/orgs","repos_url":"https://api.github.com/users/musicinmybrain/repos","events_url":"https://api.github.com/users/musicinmybrain/events{/privacy}","received_events_url":"https://api.github.com/users/musicinmybrain/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-06-02T15:40:11Z","updated_at":"2023-06-02T15:40:11Z","body":"To be perfectly honest, it is not important to me what the SPDX decision is or what the Fedora decision is—I just want to form an acceptable license expression for both packages and move on with my life. I’m not saying it isn’t important to make a good decision, I’m just saying I’m not really invested in a particular outcome.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1573942877/reactions","total_count":1,"+1":0,"-1":0,"laugh":1,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1582628311","html_url":"https://github.com/spdx/license-list-XML/issues/1971#issuecomment-1582628311","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1971","id":1582628311,"node_id":"IC_kwDOA0JFE85eVP3X","user":{"login":"swinslow","id":678569,"node_id":"MDQ6VXNlcjY3ODU2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/678569?v=4","gravatar_id":"","url":"https://api.github.com/users/swinslow","html_url":"https://github.com/swinslow","followers_url":"https://api.github.com/users/swinslow/followers","following_url":"https://api.github.com/users/swinslow/following{/other_user}","gists_url":"https://api.github.com/users/swinslow/gists{/gist_id}","starred_url":"https://api.github.com/users/swinslow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/swinslow/subscriptions","organizations_url":"https://api.github.com/users/swinslow/orgs","repos_url":"https://api.github.com/users/swinslow/repos","events_url":"https://api.github.com/users/swinslow/events{/privacy}","received_events_url":"https://api.github.com/users/swinslow/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-06-08T13:58:50Z","updated_at":"2023-06-08T14:01:11Z","body":"I don't know what the other \"terms provided with that copy of Asterisk\" are, but given the discussion in this thread I gather it's likely their proprietary license terms.\r\n\r\nOn the one hand, as @Pizza-Ria noted it does feel a bit weird to have an exception on the list that's basically just \"you can use our alternate proprietary terms rather than the GPL.\" However, looking at the principles we've now established for reviewing exceptions, [here's what we've got](https://github.com/spdx/license-list-XML/blob/main/DOCS/license-inclusion-principles.md#license-exceptions):\r\n\r\n> Candidate submissions for the Exceptions List are considered for inclusion according to the following factors:\r\n> \r\n> 1. The exception is not a stand-alone license.\r\n> 2. The exception either:\r\n>   * grants an exception to a license condition; and/or\r\n>   * grants an addition permission beyond those granted in a license.\r\n> 3. The exception does not impose additional restrictions or limitations beyond those granted in the underlying license.\r\n> 4. The exception has actual, substantial use such that it is likely to be encountered.\r\n\r\nI think this meets those requirements, particularly given that I gather Asterisk is widely used (and in Fedora).\r\n\r\nSo although it's weird, I'm +1 to add it in light of the current principles.\r\n\r\n_edited to add link to exception inclusion principles_","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1582628311/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1583839753","html_url":"https://github.com/spdx/license-list-XML/issues/1971#issuecomment-1583839753","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1971","id":1583839753,"node_id":"IC_kwDOA0JFE85eZ3oJ","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-06-09T02:16:38Z","updated_at":"2023-06-09T02:16:38Z","body":"discussed on 6/8 call - acknowledged this is a borderline case, but will accept and use suggested name and id","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-li