gist_id}","starred_url":"https://api.github.com/users/swinslow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/swinslow/subscriptions","organizations_url":"https://api.github.com/users/swinslow/orgs","repos_url":"https://api.github.com/users/swinslow/repos","events_url":"https://api.github.com/users/swinslow/events{/privacy}","received_events_url":"https://api.github.com/users/swinslow/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-02-03T18:12:41Z","updated_at":"2022-02-03T18:12:41Z","body":"Thanks @silverhook, great to know! And thanks @jlovejoy, I'm assuming you're a +1 to add this given that you submitted it in the first place  :)","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1029264983/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1029265246","html_url":"https://github.com/spdx/license-list-XML/issues/1404#issuecomment-1029265246","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1404","id":1029265246,"node_id":"IC_kwDOA0JFE849WVde","user":{"login":"silverhook","id":3227264,"node_id":"MDQ6VXNlcjMyMjcyNjQ=","avatar_url":"https://avatars.githubusercontent.com/u/3227264?v=4","gravatar_id":"","url":"https://api.github.com/users/silverhook","html_url":"https://github.com/silverhook","followers_url":"https://api.github.com/users/silverhook/followers","following_url":"https://api.github.com/users/silverhook/following{/other_user}","gists_url":"https://api.github.com/users/silverhook/gists{/gist_id}","starred_url":"https://api.github.com/users/silverhook/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/silverhook/subscriptions","organizations_url":"https://api.github.com/users/silverhook/orgs","repos_url":"https://api.github.com/users/silverhook/repos","events_url":"https://api.github.com/users/silverhook/events{/privacy}","received_events_url":"https://api.github.com/users/silverhook/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-02-03T18:13:00Z","updated_at":"2022-02-03T18:13:00Z","body":"On the other hand, [according to Wikipedia](https://en.wikipedia.org/wiki/Arphic_Technology#Arphic_Public_License), there are two versions of the Arphic Public License:\r\n- from 1999 – the one we are talking about here; and\r\n- from 2010 – which does not allow commercial use and is therefore is not FOS(S)\r\n\r\nSo we definitely should figure out some versioning for it.","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1029265246/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1029266344","html_url":"https://github.com/spdx/license-list-XML/issues/1404#issuecomment-1029266344","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1404","id":1029266344,"node_id":"IC_kwDOA0JFE849WVuo","user":{"login":"swinslow","id":678569,"node_id":"MDQ6VXNlcjY3ODU2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/678569?v=4","gravatar_id":"","url":"https://api.github.com/users/swinslow","html_url":"https://github.com/swinslow","followers_url":"https://api.github.com/users/swinslow/followers","following_url":"https://api.github.com/users/swinslow/following{/other_user}","gists_url":"https://api.github.com/users/swinslow/gists{/gist_id}","starred_url":"https://api.github.com/users/swinslow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/swinslow/subscriptions","organizations_url":"https://api.github.com/users/swinslo