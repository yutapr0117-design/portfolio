ist-XML/blob/main/DOCS/request-new-license.md#accepted-license-process). ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1548920359/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1548923508","html_url":"https://github.com/spdx/license-list-XML/issues/1939#issuecomment-1548923508","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1939","id":1548923508,"node_id":"IC_kwDOA0JFE85cUrJ0","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-05-16T03:28:21Z","updated_at":"2023-05-16T03:28:21Z","body":"@musicinmybrain - your PR looked fine. You can't edit the submission, but have to make any edits directly to the XML file (if that makes sense). Then manually add the test .txt file to the PR (so yeah, the submission tool is still a bit manual, but we are working on improving that!)\r\n\r\nIn any case, I mad