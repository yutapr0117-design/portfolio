[{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1264513335","html_url":"https://github.com/spdx/license-list-XML/issues/1655#issuecomment-1264513335","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1655","id":1264513335,"node_id":"IC_kwDOA0JFE85LXvE3","user":{"login":"richardfontana","id":1179636,"node_id":"MDQ6VXNlcjExNzk2MzY=","avatar_url":"https://avatars.githubusercontent.com/u/1179636?v=4","gravatar_id":"","url":"https://api.github.com/users/richardfontana","html_url":"https://github.com/richardfontana","followers_url":"https://api.github.com/users/richardfontana/followers","following_url":"https://api.github.com/users/richardfontana/following{/other_user}","gists_url":"https://api.github.com/users/richardfontana/gists{/gist_id}","starred_url":"https://api.github.com/users/richardfontana/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/richardfontana/subscriptions","organizations_url":"https://api.github.com/users/richardfontana/orgs","repos_url":"https://api.github.com/users/richardfontana/repos","events_url":"https://api.github.com/users/richardfontana/events{/privacy}","received_events_url":"https://api.github.com/users/richardfontana/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-10-02T00:13:13Z","updated_at":"2022-10-02T00:13:13Z","body":"This is somewhat different from the old BSD license submitted in [another issue](https://github.com/spdx/license-list-XML/issues/1635). The text of this one:\r\n\r\n```\r\n * Copyright (c) 1987 Regents of the University of California.\r\n * All rights reserved.\r\n *\r\n * Redistribution and use in source and binary forms are permitted\r\n * provided that the above copyright notice and this paragraph are\r\n * duplicated in all such forms and that any documentation,\r\n * advertising materials, and other materials related to such\r\n * distribution and use acknowledge that the software was developed