[{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1572929870","html_url":"https://github.com/spdx/license-list-XML/issues/1991#issuecomment-1572929870","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1991","id":1572929870,"node_id":"IC_kwDOA0JFE85dwQFO","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-06-01T23:50:49Z","updated_at":"2023-06-01T23:50:49Z","body":"submitted on behalf of @xsuchy","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1572929870/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1582008887","html_url":"https://github.com/spdx/license-list-XML/issues/1991#issuecomment-1582008887","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1991","id":1582008887,"node_id":"IC_kwDOA0JFE85eS4o3","user":{"login":"BrianInglis","id":23089181,"node_id":"MDQ6VXNlcjIzMDg5MTgx","avatar_url":"https://avatars.githubusercontent.com/u/23089181?v=4","gravatar_id":"","url":"https://api.github.com/users/BrianInglis","html_url":"https://github.com/BrianInglis","followers_url":"https://api.github.com/users/BrianInglis/followers","following_url":"https://api.github.com/users/BrianInglis/following{/other_user}","gists_url":"https://api.github.com/users/BrianInglis/gists{/gist_id}","starred_url":"https://api.github.com/users/BrianInglis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BrianInglis/subscriptions","organizations_url":"https://api.github.com/users/BrianInglis/orgs","repos_url":"https://api.github.com/users/BrianInglis/repos","events_url":"https://api.github.com/users/BrianInglis/events{/privacy}","received_events_url":"https://api.github.com/users/BrianInglis/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-06-08T07:10:50Z","updated_at":"2023-06-08T07:26:15Z","body":"As stated in the licences in the files, the canonical locations for the files are https://git.savannah.gnu.org/cgit/config.git/plain/config.guess and https://git.savannah.gnu.org/cgit/config.git/plain/config.sub \r\nand they are included in all packages that have (for some value of) *recently* (since 2013-2016) run `autoupdate` or manually updated their *autotools* files. \r\nI did a quick scan and found those clauses in those files in the following package sources on my system: c-ares, curl, dejagnu, dialog, diffstat, file, fontconfig, gcl, htmldoc, iperf, libev, libmetalink, libpsl, libssh2, libwebp, libxslt, lrzip, lynx, ncurses, nettle, nghttp2, nghttp3, sharutils, tack, vttest, wget2, xorg-docs","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1582008887/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1582826265","html_url":"https://github.com/spdx/license-list-XML/issues/1991#issuecomment-1582826265","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1991","id":1582826265,"node_id":"IC_kwDOA0JFE85eWAMZ","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-06-08T15:29:02Z","updated_at":"2023-06-08T15:29:02Z","body":"@BrianInglis - are you saying that all of the packages you list above use this exception with that last sentence included, then?","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1582826265/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1582840099","html_url":"https://github.com/spdx/license-list-XML/issues/1991#issuecomment-1582840099","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1991","id":1582840099,"node_id":"IC_kwDOA0JFE85eWDkj","user":{"login":"swinslow","id":678569,"node_id":"MDQ6VXNlcjY3ODU2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/678569?v=4","gravatar_id":"","url":"https://api.github.com/users/swinslow","html_url":"https://github.com/swinslow","followers_url":"https://api.github.com/users/swinslow/followers","following_url":"https://api.github.com/users/swinslow/following{/other_user}","gists_url":"https://api.github.com/users/swinslow/gists{/gist_id}","starred_url":"https://api.github.com/users/swinslow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/swinslow/subscriptions","organizations_url":"https://api.github.com/users/swinslow/orgs","repos_url":"https://api.github.com/users/swinslow/repos","events_url":"https://api.github.com/users/swinslow/events{/privacy}","received_events_url":"https://api.github.com/users/swinslow/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-06-08T15:34:52Z","updated_at":"2023-06-08T15:34:52Z","body":"@jlovejoy I would lean towards adding it as a separate exception, primarily because `Autoconf-exception-generic` could in theory be used with GPL-2.0 as well; whereas the one here is explicitly for use only with GPL-3.0.\r\n\r\nPerhaps `GPL-3.0-Autoconf-exception-generic` as ID and \"Autoconf generic exception for GPL-3.0\" as name?","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1582840099/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1583199710","html_url":"https://github.com/spdx/license-list-XML/issues/1991#issuecomment-1583199710","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1991","id":1583199710,"node_id":"IC_kwDOA0JFE85eXbXe","user":{"login":"BrianInglis","id":23089181,"node_id":"MDQ6VXNlcjIzMDg5MTgx","avatar_url":"https://avatars.githubusercontent.com/u/23089181?v=4","gravatar_id":"","url":"https://api.github.com/users/BrianInglis","html_url":"https://github.com/BrianInglis","followers_url":"https://api.github.com/users/BrianInglis/followers","following_url":"https://api.github.com/users/BrianInglis/following{/other_user}","gists_url":"https://api.github.com/users/BrianInglis/gists{/gist_id}","starred_url":"https://api.github.com/users/BrianInglis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BrianInglis/subscriptions","organizations_url":"https://api.github.com/users/BrianInglis/orgs","repos_url":"https://api.github.com/users/BrianInglis/repos","events_url":"https://api.github.com/users/BrianInglis/events{/privacy}","received_events_url":"https://api.github.com/users/BrianInglis/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-06-08T19:17:47Z","updated_at":"2023-06-08T19:17:47Z","body":"> @BrianInglis - are you saying that all of the packages you list above use this exception with that last sentence included, then?\r\n\r\n@jlovejoy \r\nThose distributed GNU reference files for all GNU packages and versions, built using GNU autotools, on my system over the last decade, appear to be close variations (copyright years, timestamp dates, reference URLs updated over the last decade, plus code changes in the config scripts below the header comments). \r\nI would expect those GNU reference files to be included in sources for all GNU packages built using GNU autotools since 2013-2016, the date included depending on the GNU package maintainers' frequency of updating the GNU autotools they use, and perhaps deciding whether or not to update the GPL licence version.  \r\nGNU packages with those files dated prior to the 2013-2016 date range, depending on the GNU package maintainers' frequency of updating the GNU autotools they use, and perhaps deciding whether or not to update the GPL licence version, do not contain that exception text, being licensed under GPLv2/+, and containing the exception text:\r\n```\r\n# As a special exception to the GNU General Public License, if you\r\n# distribute this file as part of a program that contains a\r\n# configuration script generated by Autoconf, you may include it under\r\n# the same distribution terms that you use for the rest of that program.\r\n```\r\nThese earlier files are in older GNU packages and versions I happened to have kept around dated from 2005-2016. \r\nGNU packages and licences were probably all updated to GPLv3 after 2016. \r\n\r\nSee attached files (suffixed to distinguish and allow GH attach) and logs linked below.:\r\n[config.guess-GPLV2.txt](https://github.com/spdx/license-list-XML/files/11692141/config.guess-GPLV2.txt)\r\n[config.sub-GPLV2.txt](https://github.com/spdx/license-list-XML/files/11692143/config.sub-GPLV2.txt)\r\n\r\nExceptions text appears identical for all GNU packages and versions containing those GNU reference files on my system over the last decade in [guess-except.log](https://github.com/spdx/license-list-XML/files/11691965/guess-except.log)\r\n\r\nFile metadata for all GNU packages and versions containing those GNU reference files with that exception text on my system over the last decade in [guess-size-date.log](https://github.com/spdx/license-list-XML/files/11691970/guess-size-date.log)","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1583199710/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1583839195","html_url":"https://github.com/spdx/license-list-XML/issues/1991#issuecomment-1583839195","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1991","id":1583839195,"node_id":"IC_kwDOA0JFE85eZ3fb","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-06-09T02:15:43Z","updated_at":"2023-06-09T02:15:43Z","body":"@swinslow @richardfontana - we discussed this on call today (to accept), but I didn't make a note right away... \r\ncan you confirm/remember, I think we decided on `GPL-3.0-Autoconf-exception-generic`","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1583839195/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1583893128","html_url":"https://github.com/spdx/license-list-XML/issues/1991#issuecomment-1583893128","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1991","id":1583893128,"node_id":"IC_kwDOA0JFE85eaEqI","user":{"login":"richardfontana","id":1179636,"node_id":"MDQ6VXNlcjExNzk2MzY=","avatar_url":"https://avatars.githubusercontent.com/u/1179636?v=4","gravatar_id":"","url":"https://api.github.com/users/richardfontana","html_url":"https://github.com/richardfontana","followers_url":"https://api.github.com/users/richardfontana/followers","following_url":"https://api.github.com/users/richardfontana/following{/other_user}","gists_url":"https://api.github.com/users/richardfontana/gists{/gist_id}","starred_url":"https://api.github.com/users/richardfontana/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/richardfontana/subscriptions","organizations_url":"https://api.github.com/users/richardfontana/orgs","repos_url":"https://api.github.com/users/richardfontana/repos","events_url":"https://api.github.com/users/richardfontana/events{/privacy}","received_events_url":"https://api.github.com/users/richardfontana/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-06-09T03:09:21Z","updated_at":"2023-06-09T03:09:21Z","body":"I was multitasking and wasn't paying attention at that point :)\r\n\r\nI was about to suggest Autoconf-exception-generic-GPL-3.0 but maybe your version is better.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1583893128/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1583972661","html_url":"https://github.com/spdx/license-list-XML/issues/1991#issuecomment-1583972661","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1991","id":1583972661,"node_id":"IC_kwDOA0JFE85eaYE1","user":{"login":"BrianInglis","id":23089181,"node_id":"MDQ6VXNlcjIzMDg5MTgx","avatar_url":"https://avatars.githubusercontent.com/u/23089181?v=4","gravatar_id":"","url":"https://api.github.com/users/BrianInglis","html_url":"https://github.com/BrianInglis","followers_url":"https://api.github.com/users/BrianInglis/followers","following_url":"https://api.github.com/users/BrianInglis/following{/other_user}","gists_url":"https://api.github.com/users/BrianInglis/gists{/gist_id}","starred_url":"https://api.github.com/users/BrianInglis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BrianInglis/subscriptions","organizations_url":"https://api.github.com/users/BrianInglis/orgs","repos_url":"https://api.github.com/users/BrianInglis/repos","events_url":"https://api.github.com/users/BrianInglis/events{/privacy}","received_events_url":"https://api.github.com/users/BrianInglis/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-06-09T04:51:47Z","updated_at":"2023-06-09T04:51:47Z","body":"> I think we decided on `GPL-3.0-Autoconf-exception-generic`\r\n@jlovejoy \r\nIn which case the licences found in the same files in older GNU package releases might be named `GPL-2-or-later-Autoconf-exception-generic`, as some developers may choose *NOT* to update to GPL-3 for various reasons. ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1583972661/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1587761504","html_url":"https://github.com/spdx/license-list-XML/issues/1991#issuecomment-1587761504","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1991","id":1587761504,"node_id":"IC_kwDOA0JFE85eo1Fg","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-06-12T17:29:30Z","updated_at":"2023-06-12T17:29:30Z","body":"@BrianInglis - well, no, the idea is not to make up your own SPDX id, but use the corresponding id that matches (as that is defined by the SPDX matching guidelines) to the text that is associated with that id.\r\n\r\nOn that note, @swinslow @richardfontana - I realized we already have:\r\nhttps://spdx.org/licenses/Autoconf-exception-2.0.html\r\nhttps://spdx.org/licenses/Autoconf-exception-3.0.html (which was versioned and specifically written for GPL-3.0)\r\n\r\nand then \r\nhttps://spdx.org/licenses/Autoconf-exception-generic.html\r\n(@BrianInglis - this could/would be used with GPL-2.0 or any version for that matter)\r\n\r\nAnd this variant, is the same as the latter, but adds the sentence, \"This Exception is an additional permission under section 7 of the GNU General Public License, version 3 (\"GPLv3\").\"\r\n\r\nmaybe go with `Autoconf-exception-generic-3.0' to be sort of consistent?\r\n\r\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1587761504/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1588617387","html_url":"https://github.com/spdx/license-list-XML/issues/1991#issuecomment-1588617387","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1991","id":1588617387,"node_id":"IC_kwDOA0JFE85esGCr","user":{"login":"BrianInglis","id":23089181,"node_id":"MDQ6VXNlcjIzMDg5MTgx","avatar_url":"https://avatars.githubusercontent.com/u/23089181?v=4","gravatar_id":"","url":"https://api.github.com/users/BrianInglis","html_url":"https://github.com/BrianInglis","followers_url":"https://api.github.com/users/BrianInglis/followers","following_url":"https://api.github.com/users/BrianInglis/following{/other_user}","gists_url":"https://api.github.com/users/BrianInglis/gists{/gist_id}","starred_url":"https://api.github.com/users/BrianInglis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BrianInglis/subscriptions","organizations_url":"https://api.github.com/users/BrianInglis/orgs","repos_url":"https://api.github.com/users/BrianInglis/repos","events_url":"https://api.github.com/users/BrianInglis/events{/privacy}","received_events_url":"https://api.github.com/users/BrianInglis/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-06-13T06:19:02Z","updated_at":"2023-06-13T06:19:02Z","body":"Your referenced `autoconf` exceptions seem to be really old dating from 2006-2009 copyright years. \r\nIt appears that the best canonical/reference/standard URLs for all releases of these `config.{guess,sub}` files might be to the GNU Savannah config repo https://git.savannah.gnu.org/cgit/config.git files https://git.savannah.gnu.org/cgit/config.git/tree/config.guess https://git.savannah.gnu.org/cgit/config.git/tree/config.sub where we can see the commit history of annual copyright year and timestamp updates, early 2022 [Fix GPLv3 license headers to use a comma instead of semicolon](https://git.savannah.gnu.org/cgit/config.git/commit/?id=03087cbd5161db0ff94e578b02d318d0bba2742d) before *either version 3*, and late 2012 changing the licence from *GPLv2+* to *GPLv3+* [Bring up to GPLv3](\r\nhttps://git.savannah.gnu.org/cgit/config.git/commit/?id=a8066ce76892513ec1ead42d478b631218730acb). \r\n[The repo goes back to the initial creation by RMS in the last century, with updates from local ids, then *Cygnus*, later *RedHat*, contributions this century!]\r\n\r\nAs the header comments in these *config* files distributed in packages match the *Standard License Header* for *GPLv2/3+*, it appears we should add `GPL-2/3.0-or-later AND Autoconf-exception-generic/-3.0` as required to each of these packages? ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1588617387/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1601973624","html_url":"https://github.com/spdx/license-list-XML/issues/1991#issuecomment-1601973624","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1991","id":1601973624,"node_id":"IC_kwDOA0JFE85ffC14","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-06-22T03:49:40Z","updated_at":"2023-06-22T03:49:40Z","body":"@BrianInglis in this update https://git.savannah.gnu.org/cgit/config.git/commit/?id=a8066ce76892513ec1ead42d478b631218730acb\r\n\r\nPrior to this point the SPDX id would have been:\r\n`GPL-2.0-or-later WITH Autoconf-exception-generic`\r\n\r\nAfter the update, it would be:\r\n`GPL-3.0-or-later WITH <this is where we need a new name>`\r\n\r\nLooking at it like that, I'm thinking that `Autoconf-exception-generic-3.0` seems to make the most sense!","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1601973624/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1603232012","html_url":"https://github.com/spdx/license-list-XML/issues/1991#issuecomment-1603232012","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1991","id":1603232012,"node_id":"IC_kwDOA0JFE85fj2EM","user":{"login":"BrianInglis","id":23089181,"node_id":"MDQ6VXNlcjIzMDg5MTgx","avatar_url":"https://avatars.githubusercontent.com/u/23089181?v=4","gravatar_id":"","url":"https://api.github.com/users/BrianInglis","html_url":"https://github.com/BrianInglis","followers_url":"https://api.github.com/users/BrianInglis/followers","following_url":"https://api.github.com/users/BrianInglis/following{/other_user}","gists_url":"https://api.github.com/users/BrianInglis/gists{/gist_id}","starred_url":"https://api.github.com/users/BrianInglis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BrianInglis/subscriptions","organizations_url":"https://api.github.com/users/BrianInglis/orgs","repos_url":"https://api.github.com/users/BrianInglis/repos","events_url":"https://api.github.com/users/BrianInglis/events{/privacy}","received_events_url":"https://api.github.com/users/BrianInglis/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-06-22T19:52:37Z","updated_at":"2023-06-22T19:53:33Z","body":"++ Like! Thumbs up! Maybe `Autoconf-exception-generic-GPL-3.0`?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1603232012/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]