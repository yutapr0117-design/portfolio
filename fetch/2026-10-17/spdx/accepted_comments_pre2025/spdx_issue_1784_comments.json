":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-02-12T05:46:23Z","updated_at":"2023-02-12T05:46:29Z","body":"# License Inclusion Decision\r\n\r\n## Decision:\r\n\r\n- [x] approved\r\n- [ ] not approved\r\n\r\n## Name\r\n\r\nGNAT exception\r\n\r\n## License ID\r\n\r\nGNAT-exception\r\n\r\n## XML markup\r\n\r\nnone\r\n\r\n## Notes:\r\n\r\nnone\r\n\r\n## Additional rationale or notes on decision:\r\n\r\nnone","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1426949020/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1428260549","html_url":"https://github.com/spdx/license-list-XML/issues/1784#issuecomment-1428260549","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1784","id":1428260549,"node_id":"IC_kwDOA0JFE85VIYbF","user":{"login":"swinslow","id":678569,"node_id":"MDQ6VXNlcjY3ODU2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/678569?v=4","gravatar_id":"","url":"https://api.github.com/users/swinslow","html_url":"https://github.com/swinslow","followers_url":"https://api.github.com/users/swinslow/followers","following_url":"https://api.github.com/users/swinslow/following{/other_user}","gists_url":"https://api.github.com/users/swinslow/gists{/gist_id}","starred_url":"https://api.github.com/users/swinslow/starred{/owner}{/repo}","subscriptions_url":