y/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-09-08T20:54:02Z","updated_at":"2023-09-08T20:54:02Z","body":"given the comment above that no iPXE files use this, for naming and id, could we go with:\r\n\r\n`UBDL-exception`\r\n\r\nand\r\n\r\n`Unmodified Binary Distribution exception`\r\n\r\nI'm struggling with have the word \"license\" in the name of something on the exception list. But we do prefer to use the name or id that is used \"in the wild\" so that's why I was thinking including the L in the id is okay??\r\n\r\nHappy to have other thoughts though - from @mcb30  especially!\r\n\r\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1712211103/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1712216059","html_url":"https://github.com/spdx/license-list-XML/issues/2043#issuecomment-1712216059","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/2043","id":1712216059,"node_id":"IC_kwDOA0JFE85mDlf7","user":{"login":"mcb30","id":692245,"node_id":"MDQ6VXNlcjY5MjI0NQ==","avatar_url":"https://avatars.githubusercontent.com/u/692245?v=4","gravatar_id":"","url":"https://api.github.com/users/mcb30","html_url":"https://github.com/mcb30","followers_url":"https://api.github.com/users/mcb30/followers","following_url":"https://api.github.com/users/mcb30/following{/other_user}","gists_url":"https://api.github.com/users/mcb30/gists{/gist_id}","starred_url":"https://api.github.com/users/mcb30/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mcb30/subscriptions","organizations_url":"https://api.github.com/users/mcb30/orgs","repos_url":"https://api.github.com/users/mcb30/repos","events_url":"https://api.github.com/users/mcb30/events{/privacy}","received_events_url":"https://api.github.com/users/mcb30/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-09-08T20:59:42Z","updated_at":"2023-09-08T20:59:42Z","body":"The upstream name is definitely staying as Unmodified Binary Distribution Licence, since I don't want to go through the pain of recontacting everyone concerned to get consent for what would technically be a licensing change.\n\nThat said, I have no strong preference about its representation within the SPDX namespace, so I'm very happy to defer to a choice of SPDX name that maintains consistency within that namespace.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1712216059/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]