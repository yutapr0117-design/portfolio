art":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2455750788","html_url":"https://github.com/spdx/license-list-XML/issues/2560#issuecomment-2455750788","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/2560","id":2455750788,"node_id":"IC_kwDOA0JFE86SX8iE","user":{"login":"Pizza-Ria","id":46799628,"node_id":"MDQ6VXNlcjQ2Nzk5NjI4","avatar_url":"https://avatars.githubusercontent.com/u/46799628?v=4","gravatar_id":"","url":"https://api.github.com/users/Pizza-Ria","html_url":"https://github.com/Pizza-Ria","followers_url":"https://api.github.com/users/Pizza-Ria/followers","following_url":"https://api.github.com/users/Pizza-Ria/following{/other_user}","gists_url":"https://api.github.com/users/Pizza-Ria/gists{/gist_id}","starred_url":"https://api.github.com/users/Pizza-Ria/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Pizza-Ria/subscriptions","organizations_url":"https://api.github.com/users/Pizza-Ria/orgs","repos_url":"https://api.github.com/users/Pizza-Ria/repos","events_url":"https://api.github.com/users/Pizza-Ria/events{/privacy}","received_events_url":"https://api.github.com/users/Pizza-Ria/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-04T21:36:11Z","updated_at":"2024-11-04T21:36:28Z","body":"Not allowing GPL is a restriction on use.  That seems to take it out of OSD. It potentially restricts other software licensed under the GPL that, if combined, would copyleft a component with this license.  Not a fan but I did think the ask for a card was cute.  If it was allowed, it should be the Hallmark license.  My vote is \"no\".  ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2455750788/reactions","total_count":1,"+1":0,"-1":0,"laugh":1,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0