[{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/731308797","html_url":"https://github.com/spdx/license-list-XML/issues/1136#issuecomment-731308797","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1136","id":731308797,"node_id":"MDEyOklzc3VlQ29tbWVudDczMTMwODc5Nw==","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-11-20T17:44:40Z","updated_at":"2020-11-20T17:44:40Z","body":"@armijnhemel - can you add the info as per https://github.com/spdx/license-list-XML/blob/master/CONTRIBUTING.md \r\nthanks!","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/731308797/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/760446926","html_url":"https://github.com/spdx/license-list-XML/issues/1136#issuecomment-760446926","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1136","id":760446926,"node_id":"MDEyOklzc3VlQ29tbWVudDc2MDQ0NjkyNg==","user":{"login":"swinslow","id":678569,"node_id":"MDQ6VXNlcjY3ODU2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/678569?v=4","gravatar_id":"","url":"https://api.github.com/users/swinslow","html_url":"https://github.com/swinslow","followers_url":"https://api.github.com/users/swinslow/followers","following_url":"https://api.github.com/users/swinslow/following{/other_user}","gists_url":"https://api.github.com/users/swinslow/gists{/gist_id}","starred_url":"https://api.github.com/users/swinslow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/swinslow/subscriptions","organizations_url":"https://api.github.com/users/swinslow/orgs","repos_url":"https://api.github.com/users/swinslow/repos","events_url":"https://api.github.com/users/swinslow/events{/privacy}","received_events_url":"https://api.github.com/users/swinslow/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-01-14T20:08:25Z","updated_at":"2021-01-14T20:08:25Z","body":"Since I've picked this up, I'll include a more detailed response later, just noting that I've come across this one in the wild as well from code that I'm looking at.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/760446926/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/778851208","html_url":"https://github.com/spdx/license-list-XML/issues/1136#issuecomment-778851208","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1136","id":778851208,"node_id":"MDEyOklzc3VlQ29tbWVudDc3ODg1MTIwOA==","user":{"login":"swinslow","id":678569,"node_id":"MDQ6VXNlcjY3ODU2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/678569?v=4","gravatar_id":"","url":"https://api.github.com/users/swinslow","html_url":"https://github.com/swinslow","followers_url":"https://api.github.com/users/swinslow/followers","following_url":"https://api.github.com/users/swinslow/following{/other_user}","gists_url":"https://api.github.com/users/swinslow/gists{/gist_id}","starred_url":"https://api.github.com/users/swinslow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/swinslow/subscriptions","organizations_url":"https://api.github.com/users/swinslow/orgs","repos_url":"https://api.github.com/users/swinslow/repos","events_url":"https://api.github.com/users/swinslow/events{/privacy}","received_events_url":"https://api.github.com/users/swinslow/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-02-14T22:19:44Z","updated_at":"2021-02-14T22:19:44Z","body":"Here's the \"more detailed response\" I promised a while back.\r\n\r\nIn looking at whether or not to add a license to the SPDX License List, we evaluate them in light of the [SPDX license inclusion principles](https://github.com/spdx/license-list-XML/blob/master/DOCS/license-inclusion-principles.md). Here's my quick run-down of thoughts from holding those up to this license:\r\n\r\n**Definitive factors**: The license does appear to meet all of these, noting that it is not OSI-approved. I do not see any version number indicated, but where I have seen this in use (see below) it is with a 2003 copyright date, so I would propose using `NAIST-2003` as the identifier.\r\n\r\n**Other factors**: Given that, we look at the totality of the \"other factors\" listed in the inclusion principles:\r\n\r\n1. Although this license does not appear to be on any of the indicated lists, it appears to substantially comply with the OSD and the Free Software Definition. It appears to be a broadly permissive license with a lengthy warranty disclaimer notice.\r\n2. It is structured to be used specifically by NAIST, and appears to be specific to a particular piece of software (note the third paragraph of the license).\r\n3. I have encountered this license in the wild -- specifically, it is used by a component in [NodeJS ](https://nodejs.org/) and is listed in their [LICENSE file](https://github.com/nodejs/node/blob/4a19cc8947b1bba2b2d27816ec3d0edf9b28e503/LICENSE#L343). NodeJS is extremely widely used, and on that basis I think this easily meets the \"substantial use\" criteria.\r\n4. Not applicable, as item 1 above is met.\r\n5. I do not see any indication that the license steward is aware of this submission. Given that this is a historical license (with copyright date 2003), I do not know if we will have much luck tracking down a present steward for the license.\r\n\r\nLooking at the balance of the factors, although this is structured to be used primarily by NAIST themselves, given the other factors -- particularly its use in NodeJS -- I am in favor of adding this license to the SPDX License List.\r\n\r\nAs mentioned above, I think it should use the identifier `NAIST-2003`, so that there is at least some element of versioning in case we later learn about other versions of the license.\r\n\r\n@jlovejoy @kestewart Would you be able to take a quick look and give your +1? Thanks!","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/778851208/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/780313577","html_url":"https://github.com/spdx/license-list-XML/issues/1136#issuecomment-780313577","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1136","id":780313577,"node_id":"MDEyOklzc3VlQ29tbWVudDc4MDMxMzU3Nw==","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-02-17T05:38:42Z","updated_at":"2021-02-17T05:38:42Z","body":"+1 to add, I agree the wide use overcomes factor #2\r\n\r\n@swinslow  - you already prepared a PR for this, correct?","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/780313577/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/781501397","html_url":"https://github.com/spdx/license-list-XML/issues/1136#issuecomment-781501397","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1136","id":781501397,"node_id":"MDEyOklzc3VlQ29tbWVudDc4MTUwMTM5Nw==","user":{"login":"swinslow","id":678569,"node_id":"MDQ6VXNlcjY3ODU2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/678569?v=4","gravatar_id":"","url":"https://api.github.com/users/swinslow","html_url":"https://github.com/swinslow","followers_url":"https://api.github.com/users/swinslow/followers","following_url":"https://api.github.com/users/swinslow/following{/other_user}","gists_url":"https://api.github.com/users/swinslow/gists{/gist_id}","starred_url":"https://api.github.com/users/swinslow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/swinslow/subscriptions","organizations_url":"https://api.github.com/users/swinslow/orgs","repos_url":"https://api.github.com/users/swinslow/repos","events_url":"https://api.github.com/users/swinslow/events{/privacy}","received_events_url":"https://api.github.com/users/swinslow/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-02-18T17:16:34Z","updated_at":"2021-02-18T17:16:34Z","body":"Discussed on 2021-02-18 legal team call, no objections, agreed to add.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/781501397/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]