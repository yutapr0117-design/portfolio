lob/main/DOCS/request-new-license.md#accepted-license-process). ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1692073439/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1692971975","html_url":"https://github.com/spdx/license-list-XML/issues/2091#issuecomment-1692971975","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/2091","id":1692971975,"node_id":"IC_kwDOA0JFE85k6LPH","user":{"login":"xsuchy","id":85769,"node_id":"MDQ6VXNlcjg1NzY5","avatar_url":"https://avatars.githubusercontent.com/u/85769?v=4","gravatar_id":"","url":"https://api.github.com/users/xsuchy","html_url":"https://github.com/xsuchy","followers_url":"https://api.github.com/users/xsuchy/followers","following_url":"https://api.github.com/users/xsuchy/following{/other_user}","gists_url":"https://api.github.com/users/xsuchy/gists{/gist_id}","starred_url":"https://api.github.com/users/xsuchy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/xsuchy/subscriptions","organizations_url":"https://api.github.com/users/xsuchy/orgs","repos_url":"https://api.github.com/users/xsuchy/repos","events_url":"https://api.github.com/users/xsuchy/events{/privacy}","received_events_url":"https://api.github.com/users/xsuchy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-08-25T08:28:14Z","updated_at":"2023-08-25T08:28:14Z","body":"s/GNU Complier Exception/GNU Compiler Exception/","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1692971975/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}