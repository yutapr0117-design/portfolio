[{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1484055023","html_url":"https://github.com/spdx/license-list-XML/issues/1895#issuecomment-1484055023","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1895","id":1484055023,"node_id":"IC_kwDOA0JFE85YdOHv","user":{"login":"Doctor-love","id":2008673,"node_id":"MDQ6VXNlcjIwMDg2NzM=","avatar_url":"https://avatars.githubusercontent.com/u/2008673?v=4","gravatar_id":"","url":"https://api.github.com/users/Doctor-love","html_url":"https://github.com/Doctor-love","followers_url":"https://api.github.com/users/Doctor-love/followers","following_url":"https://api.github.com/users/Doctor-love/following{/other_user}","gists_url":"https://api.github.com/users/Doctor-love/gists{/gist_id}","starred_url":"https://api.github.com/users/Doctor-love/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Doctor-love/subscriptions","organizations_url":"https://api.github.com/users/Doctor-love/orgs","repos_url":"https://api.github.com/users/Doctor-love/repos","events_url":"https://api.github.com/users/Doctor-love/events{/privacy}","received_events_url":"https://api.github.com/users/Doctor-love/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-03-26T10:30:37Z","updated_at":"2023-03-26T10:30:37Z","body":"More information about the IGO license variants: https://wiki.creativecommons.org/wiki/Intergovernmental_Organizations","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1484055023/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1484137097","html_url":"https://github.com/spdx/license-list-XML/issues/1895#issuecomment-1484137097","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1895","id":1484137097,"node_id":"IC_kwDOA0JFE85YdiKJ","user":{"login":"swinslow","id":678569,"node_id":"MDQ6VXNlcjY3ODU2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/678569?v=4","gravatar_id":"","url":"https://api.github.com/users/swinslow","html_url":"https://github.com/swinslow","followers_url":"https://api.github.com/users/swinslow/followers","following_url":"https://api.github.com/users/swinslow/following{/other_user}","gists_url":"https://api.github.com/users/swinslow/gists{/gist_id}","starred_url":"https://api.github.com/users/swinslow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/swinslow/subscriptions","organizations_url":"https://api.github.com/users/swinslow/orgs","repos_url":"https://api.github.com/users/swinslow/repos","events_url":"https://api.github.com/users/swinslow/events{/privacy}","received_events_url":"https://api.github.com/users/swinslow/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-03-26T15:47:25Z","updated_at":"2023-03-26T15:47:25Z","body":"@Doctor-love Thanks for submitting. As a general practice, we will add special-purpose Creative Commons licenses to the SPDX License List when there is evidence of at least one substantial project or organization making use of it. Can you provide links to some projects or resources that are using CC-BY-SA-3.0-IGO?","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1484137097/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1484171941","html_url":"https://github.com/spdx/license-list-XML/issues/1895#issuecomment-1484171941","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1895","id":1484171941,"node_id":"IC_kwDOA0JFE85Ydqql","user":{"login":"Doctor-love","id":2008673,"node_id":"MDQ6VXNlcjIwMDg2NzM=","avatar_url":"https://avatars.githubusercontent.com/u/2008673?v=4","gravatar_id":"","url":"https://api.github.com/users/Doctor-love","html_url":"https://github.com/Doctor-love","followers_url":"https://api.github.com/users/Doctor-love/followers","following_url":"https://api.github.com/users/Doctor-love/following{/other_user}","gists_url":"https://api.github.com/users/Doctor-love/gists{/gist_id}","starred_url":"https://api.github.com/users/Doctor-love/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Doctor-love/subscriptions","organizations_url":"https://api.github.com/users/Doctor-love/orgs","repos_url":"https://api.github.com/users/Doctor-love/repos","events_url":"https://api.github.com/users/Doctor-love/events{/privacy}","received_events_url":"https://api.github.com/users/Doctor-love/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-03-26T17:56:13Z","updated_at":"2023-03-26T17:56:13Z","body":"Thanks for your great work with this project, @swinslow !\r\n\r\nMy own use-case is including [photos from the European Space Agency](https://www.flickr.com/photos/astro_alex/30029883687/in/album-72157673903921058/) in presentations and UIs, which are often IGO licensed.\r\n\r\nI find the reasoning for selectively adding CC licenses a bit odd - considering the release cycle for the SPDX license list and the time it takes for it to trickle down into tools like [REUSE](https://reuse.software/), seems like it would be easier for everyone (this project and its users) to just add the remaining ones - it's not like the few extra bytes is gonna hurt anyone and the chance for works being credited/properly reused increases. Could you elaborate a bit?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1484171941/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1484201691","html_url":"https://github.com/spdx/license-list-XML/issues/1895#issuecomment-1484201691","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1895","id":1484201691,"node_id":"IC_kwDOA0JFE85Ydx7b","user":{"login":"swinslow","id":678569,"node_id":"MDQ6VXNlcjY3ODU2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/678569?v=4","gravatar_id":"","url":"https://api.github.com/users/swinslow","html_url":"https://github.com/swinslow","followers_url":"https://api.github.com/users/swinslow/followers","following_url":"https://api.github.com/users/swinslow/following{/other_user}","gists_url":"https://api.github.com/users/swinslow/gists{/gist_id}","starred_url":"https://api.github.com/users/swinslow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/swinslow/subscriptions","organizations_url":"https://api.github.com/users/swinslow/orgs","repos_url":"https://api.github.com/users/swinslow/repos","events_url":"https://api.github.com/users/swinslow/events{/privacy}","received_events_url":"https://api.github.com/users/swinslow/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-03-26T19:40:56Z","updated_at":"2023-03-26T19:40:56Z","body":"Thanks @Doctor-love!\r\n\r\nAs a general matter for CC licenses, I gather there are a pretty staggering number of potential combinations of CC licenses, if all of the different possible country codes were implemented for each pre-4.0 variant. I believe https://wiki.creativecommons.org/wiki/CC_Ports_by_Jurisdiction is a list of the various jurisdictions, each with the various different versions and license attribute variations.\r\n\r\nThe main reason for the \"wait until someone asks for it\" informal policy is that the vast majority of use cases are already covered by the licenses that are currently on the list. Many of the combinations of the jurisdiction-specific older versions may not actually be used by anyone at present. When we become aware of an actual use, it's pretty easy at that point to get it added for the next release.\r\n\r\nIn this particular case, thanks for flagging the use by ESA of CC-BY-SA-3.0-IGO. I'm definitely +1 to add it here. @jlovejoy would you agree that we can go ahead and mark this as approved, given the above?\r\n\r\n@Doctor-love after it is approved, would you be willing to submit a PR with the XML file and test text file? Some details are available [here](https://github.com/spdx/license-list-XML/blob/main/DOCS/request-new-license.md#accepted-license-process) for after this issue is marked as approved.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1484201691/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1484215042","html_url":"https://github.com/spdx/license-list-XML/issues/1895#issuecomment-1484215042","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1895","id":1484215042,"node_id":"IC_kwDOA0JFE85Yd1MC","user":{"login":"Doctor-love","id":2008673,"node_id":"MDQ6VXNlcjIwMDg2NzM=","avatar_url":"https://avatars.githubusercontent.com/u/2008673?v=4","gravatar_id":"","url":"https://api.github.com/users/Doctor-love","html_url":"https://github.com/Doctor-love","followers_url":"https://api.github.com/users/Doctor-love/followers","following_url":"https://api.github.com/users/Doctor-love/following{/other_user}","gists_url":"https://api.github.com/users/Doctor-love/gists{/gist_id}","starred_url":"https://api.github.com/users/Doctor-love/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Doctor-love/subscriptions","organizations_url":"https://api.github.com/users/Doctor-love/orgs","repos_url":"https://api.github.com/users/Doctor-love/repos","events_url":"https://api.github.com/users/Doctor-love/events{/privacy}","received_events_url":"https://api.github.com/users/Doctor-love/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-03-26T20:33:39Z","updated_at":"2023-03-26T20:33:39Z","body":"Thanks for explaining your reasoning. Sure, I could submit a PR in that case! :-)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1484215042/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1500459499","html_url":"https://github.com/spdx/license-list-XML/issues/1895#issuecomment-1500459499","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1895","id":1500459499,"node_id":"IC_kwDOA0JFE85ZbzHr","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/receiv