2MjA=","avatar_url":"https://avatars.githubusercontent.com/u/4991620?v=4","gravatar_id":"","url":"https://api.github.com/users/DennisClark","html_url":"https://github.com/DennisClark","followers_url":"https://api.github.com/users/DennisClark/followers","following_url":"https://api.github.com/users/DennisClark/following{/other_user}","gists_url":"https://api.github.com/users/DennisClark/gists{/gist_id}","starred_url":"https://api.github.com/users/DennisClark/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DennisClark/subscriptions","organizations_url":"https://api.github.com/users/DennisClark/orgs","repos_url":"https://api.github.com/users/DennisClark/repos","events_url":"https://api.github.com/users/DennisClark/events{/privacy}","received_events_url":"https://api.github.com/users/DennisClark/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-06-08T22:40:18Z","updated_at":"2022-06-08T22:43:00Z","body":"It's used in http://ftp.debian.org/debian/pool/main/c/cminpack/cminpack_1.3.4.orig.tar.gz \r\nin the file CopyrightMINPACK.txt","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1150483209/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1150747513","html_url":"https://github.com/spdx/license-list-XML/issues/1522#issuecomment-1150747513","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1522","id":1150747513,"node_id":"IC_kwDOA0JFE85ElwN5","user":{"login":"pombredanne","id":675997,"node_id":"MDQ6VXNlcjY3NTk5Nw==","avatar_url":"https://avatars.githubusercontent.com/u/675997?v=4","gravatar_id":"","url":"https://api.github.com/users/pombredanne","html_url":"https://github.com/pombredanne","followers_url":"https://api.github.com/users/pombredanne/followers","following_url":"https://api.github.com/users/pombredanne/following{/other_user}","gists_url":"https://api.github.com/users/pombredanne/gists{/gist_id}","starred_url":"https://api.github.com/users/pombredanne/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pombredanne/subscriptions","organizations_url":"https://api.github.com/users/pombredanne/orgs","repos_url":"https://api.github.com/users/pombredanne/repos","events_url":"https://api.github.com/users/pombredanne/events{/privacy}","received_events_url":"https://api.github.com/users/pombredanne/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-06-09T07:01:56Z","updated_at":"2022-06-09T07:01:56Z","body":"@jlovejoy \r\n\r\n>  I'd be curious to know if you have any data on this license and where else it might be used!\r\n\r\n[`minpack`](https://scancode-licensedb.aboutcode.org/minpack.html) was added to SanCode by @DennisClark before it was called even ScanCode ;) ... but there is not much I could dig from its history beside that.  This is not super frequent:  we've see it pop up in actual codebases we audit either as-is or in libeigen/eige or Apache Commons Math that vendor some of it.\r\nhttps://github.com/apache/commons-math/blob/294589d7b478fe388b9a1c2e28aa37c02cb6fe18/commons-math-core/LICENCE#L239","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1150747513/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1151355292","html_url":"https://github.com/spdx/license-list-XML/issues/1522#issuecomment-1151355292","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1522","id":1151355292,"node_id":"IC_kwDOA0JFE85EoEmc","user":{"login":"seabass-labrax","id":79224200,"node_id":"MDQ6VXNlcjc5MjI0MjAw","avatar_url":"https://avatars.githubusercontent.com/u/79224200?v=4","gravatar_id":"","url":"https://api.github.com/users/seabass-labrax","html_url":"https://github.com/seabass-labrax","followers_url":"https://api.github.com/users/seabass-labrax/followers","following_url":"https://api.github.com/users/seabass-labrax/following{/other_user}","gists_url":"https://api.github.com/users/seabass-labrax/gists{/gist_id}","starred_url":"https://api.github.com/users/seabass-labrax/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/seabass-labrax/subscriptions","organizations_url":"https://api.github.com/users/seabass-labrax/orgs","repos_url":"https://api.github.com/users/seabass-labrax/repos","events_url":"https://api.github.com/users/seabass-labrax/events{/privacy}","received_events_url":"https://api.github.com/users/seabass-labrax/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-06-09T16:35:33Z","updated_at":"2022-06-09T16:35:33Z","body":"# New submission review\r\n\r\n## Has the license been approved by the OSI?\r\n*All OSI-approved license will be included on the SPDX License List, regardless of other factors*\r\n\r\nNo; it appears as though the license has never been submitted to the OSI for consideration.\r\n\r\n## Definitive factors\r\n*These must all be satisfied to allow inclusion in the license list*\r\n\r\n### Is the submitted license unique, that is, it does not match another license already on the License List as per the matching guidelines?\r\n\r\nYes, it is unique and not already in the SPDX License List.\r\n\r\n### If a software license, does it apply to source code and not only to executables?\r\n\r\nYes, it can apply to both source and binary distribution.\r\n\r\n### Does the license have identifiable and stable text, and is not in the midst of drafting?\r\n\r\nYes, it appears to be historical and stable; I can find only one variant. This starts with:\r\n\r\n> Minpack Copyright Notice (1999) University of Chicago.  All rights reserved\r\n\r\n### Has the license steward, if any, committed to versioning new versions in the future and to not modify it after addition to the list?\r\n\r\nUnknown.\r\n\r\n## Other factors for inclusion\r\n*Roughly in order of descending importance*\r\n\r\n### 1. Does the license substantially comply with one of the free/open content definitions?\r\n*Approval by the organisation that publishes the definition is not required*\r\n\r\nYes, it has been considered to fulfil both the Debian Free Software Guidelines and the Fedora licensing policy by those respective organisations.\r\n\r\n### 2. Is the license structured to be generally usable by anyone, and not specific to one organisation or project?\r\n\r\nYes. However, there are disclaimer and attribution notices specific to copyright holders; these may need to be marked as replaceable text.\r\n\r\n### 3. Does the license have substantial use such that it is likely to be encountered (ie. use in many projects, or in one significant project)?\r\n*For recently written licenses, definitive plans for it to be used in at least one or a few significant projects may satisfy this*\r\n\r\nYes, it applies to the widely-used mathematical library Eigen, which is included in all major free software distributions.\r\n\r\n### 4. Is the license primarily intended to facilitate the free distribution of content with limited restrictions?\r\n\r\nYes.\r\n\r\n### 5. Does the license steward support this submission, or is at least aware of and not in opposition of it?\r\n\r\nNo, there isn't any evidence that the license steward is aware of the submission. \r\n\r\n## Summary of factors / outcome\r\n*Comments on the totality of these \"other factors\" in light of the SPDX License List's overall goals and objectives*\r\n\r\nI would strongly be favour of this license's inclusion in the SPDX License List, given its wide use and categorisation as a permissive, historical free/open source software license.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1151355292/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1151664617","html_url":"https://github.com/spdx/license-list-XML/issues/1522#issuecomment-1151664617","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1522","id":1151664617,"node_id":"IC_kwDOA0JFE85EpQHp","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-06-09T22:00:39Z","updated_at":"2022-06-09T22:00:39Z","body":"Thanks @pombredanne @DennisClark and @seabass-labrax  for the additional help here!\r\n\r\nSo, looks like we have two votes to add it (from @swinslow and @seabass-labrax ) and I don't think my vote \"counts\" as I am the submitter - so can we get a third from someone else?","author_association":"MEMBER","pin":null,"reactions":{"u