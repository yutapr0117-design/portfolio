[{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/382800075","html_url":"https://github.com/spdx/license-list-XML/issues/616#issuecomment-382800075","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/616","id":382800075,"node_id":"MDEyOklzc3VlQ29tbWVudDM4MjgwMDA3NQ==","user":{"login":"bradleeedmondson","id":7350638,"node_id":"MDQ6VXNlcjczNTA2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/7350638?v=4","gravatar_id":"","url":"https://api.github.com/users/bradleeedmondson","html_url":"https://github.com/bradleeedmondson","followers_url":"https://api.github.com/users/bradleeedmondson/followers","following_url":"https://api.github.com/users/bradleeedmondson/following{/other_user}","gists_url":"https://api.github.com/users/bradleeedmondson/gists{/gist_id}","starred_url":"https://api.github.com/users/bradleeedmondson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bradleeedmondson/subscriptions","organizations_url":"https://api.github.com/users/bradleeedmondson/orgs","repos_url":"https://api.github.com/users/bradleeedmondson/repos","events_url":"https://api.github.com/users/bradleeedmondson/events{/privacy}","received_events_url":"https://api.github.com/users/bradleeedmondson/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-04-19T16:33:18Z","updated_at":"2018-04-19T16:33:18Z","body":"Discussed on legal call today.\r\n\r\nAppears to be used only in URW Base 35 Fonts package (google search for matching text shows only ~5 hits); however that package is included in Debian, so we will approve and add this exception to the SPDX License List. Approved.\r\n\r\nProposed name: AGPL-3.0 font exception PS-PDF\r\n\r\nProposed short identifier: AGPL-3.0-font-exception-ps-pdf\r\n\r\nNote that the PostScript and PDF document format appears to be a condition for triggering this exception.\r\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/382800075/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/382818693","html_url":"https://github.com/spdx/license-list-XML/issues/616#issuecomment-382818693","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/616","id":382818693,"node_id":"MDEyOklzc3VlQ29tbWVudDM4MjgxODY5Mw==","user":{"login":"bradleeedmondson","id":7350638,"node_id":"MDQ6VXNlcjczNTA2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/7350638?v=4","gravatar_id":"","url":"https://api.github.com/users/bradleeedmondson","html_url":"https://github.com/bradleeedmondson","followers_url":"https://api.github.com/users/bradleeedmondson/followers","following_url":"https://api.github.com/users/bradleeedmondson/following{/other_user}","gists_url":"https://api.github.com/users/bradleeedmondson/gists{/gist_id}","starred_url":"https://api.github.com/users/bradleeedmondson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bradleeedmondson/subscriptions","organizations_url":"https://api.github.com/users/bradleeedmondson/orgs","repos_url":"https://api.github.com/users/bradleeedmondson/repos","events_url":"https://api.github.com/users/bradleeedmondson/events{/privacy}","received_events_url":"https://api.github.com/users/bradleeedmondson/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-04-19T17:33:31Z","updated_at":"2018-04-19T17:33:31Z","body":"@wking Would you be able to file a PRs for the XML definition of this license?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/382818693/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/382819586","html_url":"https://github.com/spdx/license-list-XML/issues/616#issuecomment-382819586","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/616","id":382819586,"node_id":"MDEyOklzc3VlQ29tbWVudDM4MjgxOTU4Ng==","user":{"login":"wking","id":209920,"node_id":"MDQ6VXNlcjIwOTkyMA==","avatar_url":"https://avatars.githubusercontent.com/u/209920?v=4","gravatar_id":"","url":"https://api.github.com/users/wking","html_url":"https://github.com/wking","followers_url":"https://api.github.com/users/wking/followers","following_url":"https://api.github.com/users/wking/following{/other_user}","gists_url":"https://api.github.com/users/wking/gists{/gist_id}","starred_url":"https://api.github.com/users/wking/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wking/subscriptions","organizations_url":"https://api.github.com/users/wking/orgs","repos_url":"https://api.github.com/users/wking/repos","events_url":"https://api.github.com/users/wking/events{/privacy}","received_events_url":"https://api.github.com/users/wking/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-04-19T17:36:02Z","updated_at":"2018-04-19T17:36:02Z","body":"> Proposed short identifier: AGPL-3.0-font-exception-ps-pdf\r\n\r\nDo we want to stick a version number on that?  What happens if they update the text in the future in a way the SPDX considers legally distinct from the current text?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/382819586/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/382823148","html_url":"https://github.com/spdx/license-list-XML/issues/616#issuecomment-382823148","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/616","id":382823148,"node_id":"MDEyOklzc3VlQ29tbWVudDM4MjgyMzE0OA==","user":{"login":"bradleeedmondson","id":7350638,"node_id":"MDQ6VXNlcjczNTA2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/7350638?v=4","gravatar_id":"","url":"https://api.github.com/users/bradleeedmondson","html_url":"https://github.com/bradleeedmondson","followers_url":"https://api.github.com/users/bradleeedmondson/followers","following_url":"https://api.github.com/users/bradleeedmondson/following{/other_user}","gists_url":"https://api.github.com/users/bradleeedmondson/gists{/gist_id}","starred_url":"https://api.github.com/users/bradleeedmondson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bradleeedmondson/subscriptions","organizations_url":"https://api.github.com/users/bradleeedmondson/orgs","repos_url":"https://api.github.com/users/bradleeedmondson/repos","events_url":"https://api.github.com/users/bradleeedmondson/events{/privacy}","received_events_url":"https://api.github.com/users/bradleeedmondson/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-04-19T17:47:29Z","updated_at":"2018-04-19T17:47:29Z","body":"Ah, yes, good point. Now that you raise it, I think we should version just about everything we add to the list. (Perhaps we should make this an explicit directive going forward?) \r\n\r\nWe always list version number when the license author specifies versions, but it's not completely clear what to do when the author doesn't version their text. Rather than specify 1.0 for them, perhaps we should version by date, as we do with [some](https://github.com/spdx/license-list-XML/blob/master/src/Adobe-2006.xml) [license](https://github.com/spdx/license-list-XML/blob/master/src/W3C-19980720.xml) [files](https://github.com/spdx/license-list-XML/blob/master/src/W3C-20150513.xml)? \r\n\r\nHere, that would presumably resolve to:\r\n* Proposed name: AGPL-3.0 font exception PS-PDF 20170817 or AGPL-3.0 font exception PS-PDF 2017\r\n* Proposed short identifier: AGPL-3.0-font-exception-ps-pdf-20170817 or AGPL-3.0-font-exception-ps-pdf-2017\r\n\r\nThoughts, @wking ? \r\n\r\nAlso, some housekeeping: I believe @jlovejoy and @kestewart are traveling for conferences at the moment, so I'd like to give them at least a week to weigh in before finalizing/merging anything. But we can always get started with the PRs now.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/382823148/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/382824491","html_url":"https://github.com/spdx/license-list-XML/issues/616#issuecomment-382824491","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/616","id":382824491,"node_id":"MDEyOklzc3VlQ29tbWVudDM4MjgyNDQ5MQ==","user":{"login":"bradleeedmondson","id":7350638,"node_id":"MDQ6VXNlcjczNTA2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/7350638?v=4","gravatar_id":"","url":"https://api.github.com/users/bradleeedmondson","html_url":"https://github.com/bradleeedmondson","followers_url":"https://api.github.com/users/bradleeedmondson/followers","following_url":"https://api.github.com/users/bradleeedmondson/following{/other_user}","gists_url":"https://api.github.com/users/bradleeedmondson/gists{/gist_id}","starred_url":"https://api.github.com/users/bradleeedmondson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bradleeedmondson/subscriptions","organizations_url":"https://api.github.com/users/bradleeedmondson/orgs","repos_url":"https://api.github.com/users/bradleeedmondson/repos","events_url":"https://api.github.com/users/bradleeedmondson/events{/privacy}","received_events_url":"https://api.github.com/users/bradleeedmondson/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-04-19T17:51:47Z","updated_at":"2018-04-19T17:51:47Z","body":"Also, and this may need more discussion on the next legal call (hence the label re-added), but we'll need to explicitly decide how to cast the first sentence (required? optional? precluded?). For the legal team, is the exception:\r\n\r\n1.\r\n> The font and related files in this directory are distributed under the\r\n> GNU AFFERO GENERAL PUBLIC LICENSE Version 3 (see the file COPYING), with\r\n> the following exemption:\r\n> \r\n> As a special exception, permission is granted to include these font\r\n> programs in a Postscript or PDF file that consists of a document that\r\n> contains text to be displayed or printed using this font, regardless\r\n> of the conditions or license applying to the document itself.\r\n\r\nor 2.\r\n\r\n> &lt;optional&gt;The font and related files in this directory are distributed under the\r\n> GNU AFFERO GENERAL PUBLIC LICENSE Version 3 (see the file COPYING), with\r\n> the following exemption:&lt;/optional&gt;\r\n> \r\n> As a special exception, permission is granted to include these font\r\n> programs in a Postscript or PDF file that consists of a document that\r\n> contains text to be displayed or printed using this font, regardless\r\n> of the conditions or license applying to the document itself.\r\n\r\nor 3.\r\n\r\n> As a special exception, permission is granted to include these font\r\n> programs in a Postscript or PDF file that consists of a document that\r\n> contains text to be displayed or printed using this font, regardless\r\n> of the conditions or license applying to the document itself.\r\n\r\n\r\n\r\n\r\nIf we decide on case 3, which currently makes the most sense to me, since it allows combination with other licenses (not just AGPL3), then the name and short identifier would need to be updated.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/382824491/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/382833917","html_url":"https://github.com/spdx/license-list-XML/issues/616#issuecomment-382833917","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/616","id":382833917,"node_id":"MDEyOklzc3VlQ29tbWVudDM4MjgzMzkxNw==","user":{"login":"wking","id":209920,"node_id":"MDQ6VXNlcjIwOTkyMA==","avatar_url":"https://avatars.githubusercontent.com/u/209920?v=4","gravatar_id":"","url":"https://api.github.com/users/wking","html_url":"https://github.com/wking","followers_url":"https://api.github.com/users/wking/followers","following_url":"https://api.github.com/users/wking/following{/other_user}","gists_url":"https://api.github.com/users/wking/gists{/gist_id}","starred_url":"https://api.github.com/users/wking/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wking/subscriptions","organizations_url":"https://api.github.com/users/wking/orgs","repos_url":"https://api.github.com/users/wking/repos","events_url":"https://api.github.com/users/wking/events{/privacy}","received_events_url":"https://api.github.com/users/wking/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-04-19T18:22:19Z","updated_at":"2018-04-19T18:22:19Z","body":"On Thu, Apr 19, 2018 at 10:47:29AM -0700, Bradlee H. Edmndson wrote:\n> Ah, yes, good point. Now that you raise it, I think we should\n> version just about everything we add to the list. (Perhaps we should\n> make this an explicit directive going forward?)\n\nI think it needs to be a bit more flexible than an explicit directive.\nFor example, I think the recent MIT-0 (#632) is extremely unlikely to\nhave future text changes, since it's an almost mechanical pivot on the\nancient MIT.  I'm more worried about stability in license/exceptions\nthat seem to be greenfield work, are a few months old, and are only\nused by a handful of projects ;).\n\n> We always list version number when the license author specifies\n> versions, but it's not completely clear what to do when the author\n> doesn't version their text.\n\nIdeally we'd get the upstream steward to version their content (like\nwe did with the OpenJDK assembly exception [1]).  But that's more\ntroublesome for license/exception authors that only reach out to us\nlate in their process (or not at all).\n\n> Rather than specify 1.0 for them, perhaps we should version by date…\n>\n> Here, that would presumably resolve to:\n>\n> * Proposed name: AGPL-3.0 font exception PS-PDF 20170817 or AGPL-3.0\n>   font exception PS-PDF 2017\n> * Proposed short identifier: AGPL-3.0-font-exception-ps-pdf-20170817\n>   or AGPL-3.0-font-exception-ps-pdf-2017\n\nThose are both fine with me.  I'd also be fine leaving it unversioned\nif folks were convinced that there would never be future, legally\ndistinct, AGPL-3.0 font exceptions for Postscript and/or PDF.\n\nIncidentally, what's the motivation for the hyphen for PS-PDF?  I'd\nhave expected PS/PDF.\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/382833917/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/382835783","html_url":"https://github.com/spdx/license-list-XML/issues/616#issuecomment-382835783","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/616","id":382835783,"node_id":"MDEyOklzc3VlQ29tbWVudDM4MjgzNTc4Mw==","user":{"login":"wking","id":209920,"node_id":"MDQ6VXNlcjIwOTkyMA==","avatar_url":"https://avatars.githubusercontent.com/u/209920?v=4","gravatar_id":"","url":"https://api.github.com/users/wking","html_url":"https://github.com/wking","followers_url":"https://api.github.com/users/wking/followers","following_url":"https://api.github.com/users/wking/following{/other_user}","gists_url":"https://api.github.com/users/wking/gists{/gist_id}","starred_url":"https://api.github.com/users/wking/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wking/subscriptions","organizations_url":"https://api.github.com/users/wking/orgs","repos_url":"https://api.github.com/users/wking/repos","events_url":"https://api.github.com/users/wking/events{/privacy}","received_events_url":"https://api.github.com/users/wking/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-04-19T18:28:26Z","updated_at":"2018-04-19T18:28:26Z","body":"On Thu, Apr 19, 2018 at 05:51:47PM +0000, Bradlee H. Edmndson wrote:\n> Also… we'll need to explicitly decide how to cast the first sentence…\n> …\n> If we decide on case 3, which currently makes the most sense to me,\n> since it allows combination with other licenses (not just AGPL3),\n> then the name and short identifier would need to be updated.\n\nThis makes the most sense to me as well.  Basically this is the same\nsituation we had with the OpenJDK exception [1], where the text we're\ngiven is really adoption text associating content with the contract,\nwhere the adoption text happens to include at least a portion of the\ncontract text.  I think the correct markup would be something like:\n\n  <standardLicenseHeader>\n    <p>The font and related files in this directory are distributed\n      under the GNU AFFERO GENERAL PUBLIC LICENSE Version 3 (see the\n      file COPYING), with the following exemption:\n    </p>\n    <text>\n      <p>As a special exception, permission is granted to include\n        these font programs in a Postscript or PDF file that consists\n        of a document that contains text to be displayed or printed\n        using this font, regardless of the conditions or license\n        applying to the document itself.\n      </p>\n    </text>\n  </standardLicenseHeader>\n\nalthough you'd need a schema change to allow <text> within\n<standardLicenseHeader>.  Without a schema change, I think the best we\ncould do would be the not-DRY:\n\n  <text>\n    <p>As a special exception, permission is granted to include these\n      font programs in a Postscript or PDF file that consists of a\n      document that contains text to be displayed or printed using\n      this font, regardless of the conditions or license applying to\n      the document itself.\n    </p>\n  </text>\n  <standardLicenseHeader>\n    <p>The font and related files in this directory are distributed\n      under the GNU AFFERO GENERAL PUBLIC LICENSE Version 3 (see the\n      file COPYING), with the following exemption:\n    </p>\n    <p>As a special exception, permission is granted to include these\n      font programs in a Postscript or PDF file that consists of a\n      document that contains text to be displayed or printed using\n      this font, regardless of the conditions or license applying to\n      the document itself.\n    </p>\n  </standardLicenseHeader>\n\n[1]: https://github.com/spdx/license-list-XML/pull/625#discussion_r179531365\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/382835783/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/382838590","html_url":"https://github.com/spdx/license-list-XML/issues/616#issuecomment-382838590","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/616","id":382838590,"node_id":"MDEyOklzc3VlQ29tbWVudDM4MjgzODU5MA==","user":{"login":"bradleeedmondson","id":7350638,"node_id":"MDQ6VXNlcjczNTA2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/7350638?v=4","gravatar_id":"","url":"https://api.github.com/users/bradleeedmondson","html_url":"https://github.com/bradleeedmondson","followers_url":"https://api.github.com/users/bradleeedmondson/followers","following_url":"https://api.github.com/users/bradleeedmondson/following{/other_user}","gists_url":"https://api.github.com/users/bradleeedmondson/gists{/gist_id}","starred_url":"https://api.github.com/users/bradleeedmondson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bradleeedmondson/subscriptions","organizations_url":"https://api.github.com/users/bradleeedmondson/orgs","repos_url":"https://api.github.com/users/bradleeedmondson/repos","events_url":"https://api.github.com/users/bradleeedmondson/events{/privacy}","received_events_url":"https://api.github.com/users/bradleeedmondson/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-04-19T18:37:47Z","updated_at":"2018-04-19T18:42:29Z","body":"> Incidentally, what's the motivation for the hyphen for PS-PDF?  I'd\r\n> have expected PS/PDF.\r\n\r\nA good point -- I just assumed without checking that slashes were not allowed in SPDX identifiers. If they are, that's a better representation.\r\n\r\nEdit to add: And if we allow slashes in name but not in identifier, then we should at least use PS/PDF in name even if it has to get smashed to a hyphen in the identifier.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/382838590/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/382840265","html_url":"https://github.com/spdx/license-list-XML/issues/616#issuecomment-382840265","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/616","id":382840265,"node_id":"MDEyOklzc3VlQ29tbWVudDM4Mjg0MDI2NQ==","user":{"login":"wking","id":209920,"node_id":"MDQ6VXNlcjIwOTkyMA==","avatar_url":"https://avatars.githubusercontent.com/u/209920?v=4","gravatar_id":"","url":"https://api.github.com/users/wking","html_url":"https://github.com/wking","followers_url":"https://api.github.com/users/wking/followers","following_url":"https://api.github.com/users/wking/following{/other_user}","gists_url":"https://api.github.com/users/wking/gists{/gist_id}","starred_url":"https://api.github.com/users/wking/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wking/subscriptions","organizations_url":"https://api.github.com/users/wking/orgs","repos_url":"https://api.github.com/users/wking/repos","events_url":"https://api.github.com/users/wking/events{/privacy}","received_events_url":"https://api.github.com/users/wking/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-04-19T18:43:20Z","updated_at":"2018-04-19T18:43:20Z","body":"On Thu, Apr 19, 2018 at 06:37:47PM +0000, Bradlee H. Edmndson wrote:\n> > Incidentally, what's the motivation for the hyphen for PS-PDF?  I'd\n> > have expected PS/PDF.\n>\n> A good point -- I just assumed without checking that slashes were\n> not allowed in SPDX identifiers. If they are, that's a better\n> representation.\n\nThey are not allowed in identifiers [1], so I'm fine with PS-PDF\nthere.  But I'd prefer PS/PDF in the exception name.\n\n[1]: https://github.com/spdx/spdx-spec/blame/df26160783956ed87d78889dd1d4a53022e713eb/chapters/appendix-IV-SPDX-license-expressions.md#L11\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/382840265/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/382951343","html_url":"https://github.com/spdx/license-list-XML/issues/616#issuecomment-382951343","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/616","id":382951343,"node_id":"MDEyOklzc3VlQ29tbWVudDM4Mjk1MTM0Mw==","user":{"login":"bradleeedmondson","id":7350638,"node_id":"MDQ6VXNlcjczNTA2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/7350638?v=4","gravatar_id":"","url":"https://api.github.com/users/bradleeedmondson","html_url":"https://github.com/bradleeedmondson","followers_url":"https://api.github.com/users/bradleeedmondson/followers","following_url":"https://api.github.com/users/bradleeedmondson/following{/other_user}","gists_url":"https://api.github.com/users/bradleeedmondson/gists{/gist_id}","starred_url":"https://api.github.com/users/bradleeedmondson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bradleeedmondson/subscriptions","organizations_url":"https://api.github.com/users/bradleeedmondson/orgs","repos_url":"https://api.github.com/users/bradleeedmondson/repos","events_url":"https://api.github.com/users/bradleeedmondson/events{/privacy}","received_events_url":"https://api.github.com/users/bradleeedmondson/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-04-20T02:41:45Z","updated_at":"2018-04-20T02:53:13Z","body":"### PS/PDF\r\n> But I'd prefer PS/PDF in the exception name.\r\n\r\nAgreed. So the name should have PS/PDF and the identifier PS-PDF.\r\n\r\n### Markup\r\nI also agree with [your markup approach](https://github.com/spdx/license-list-XML/issues/616#issuecomment-382835783), but I think we can take it a step further and use &lt;alt&gt; for the license name (rather than leaving the happenstance of AGPL-3.0 per this request), and knock AGPL-3.0 out of the exception name and identifier. This may not be technically necessary now, but seems to be the best way to plan for future use in conjunction with other licenses, which it's my understanding the exceptions are intended to support.\r\n\r\n### Versioning\r\nI am not sure I fully understand and can accurately represent SPDX naming conventions w/r/t versioning (and they may have both explicit and unwritten aspects), so I would be happy to be overruled or corrected as appropriate. But my own current preference would be the following: \r\n\r\n- Ask the license text submitter for versioning information or author contact information, \r\n  - If we hear back within a reasonable time frame, and the author publicly specifies a version number, use that\r\n  - Otherwise, default to appending YYYYMMDD to indicate [something approaching version number]. \r\n\r\nI'll reach out to the submitter for this license to ask about authorship and versioning shortly.\r\n\r\n----\r\nEdit to add: asked submitter for version or authorship info [here](https://lists.spdx.org/pipermail/spdx-legal/2018-April/002565.html). Used 1-week clock, so if no response after approx. 2018-April-27, we can (probably) version with date (here, 20170817)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/382951343/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/393596266","html_url":"https://github.com/spdx/license-list-XML/issues/616#issuecomment-393596266","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/616","id":393596266,"node_id":"MDEyOklzc3VlQ29tbWVudDM5MzU5NjI2Ng==","user":{"login":"bradleeedmondson","id":7350638,"node_id":"MDQ6VXNlcjczNTA2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/7350638?v=4","gravatar_id":"","url":"https://api.github.com/users/bradleeedmondson","html_url":"https://github.com/bradleeedmondson","followers_url":"https://api.github.com/users/bradleeedmondson/followers","following_url":"https://api.github.com/users/bradleeedmondson/following{/other_user}","gists_url":"https://api.github.com/users/bradleeedmondson/gists{/gist_id}","starred_url":"https://api.github.com/users/bradleeedmondson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bradleeedmondson/subscriptions","organizations_url":"https://api.github.com/users/bradleeedmondson/orgs","repos_url":"https://api.github.com/users/bradleeedmondson/repos","events_url":"https://api.github.com/users/bradleeedmondson/events{/privacy}","received_events_url":"https://api.github.com/users/bradleeedmondson/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-05-31T16:42:27Z","updated_at":"2018-05-31T16:42:27Z","body":"I haven't heard anything back, and there was no response on the list, so let's go with versioning (in the name field) by date.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/393596266/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/393596497","html_url":"https://github.com/spdx/license-list-XML/issues/616#issuecomment-393596497","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/616","id":393596497,"node_id":"MDEyOklzc3VlQ29tbWVudDM5MzU5NjQ5Nw==","user":{"login":"bradleeedmondson","id":7350638,"node_id":"MDQ6VXNlcjczNTA2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/7350638?v=4","gravatar_id":"","url":"https://api.github.com/users/bradleeedmondson","html_url":"https://github.com/bradleeedmondson","followers_url":"https://api.github.com/users/bradleeedmondson/followers","following_url":"https://api.github.com/users/bradleeedmondson/following{/other_user}","gists_url":"https://api.github.com/users/bradleeedmondson/gists{/gist_id}","starred_url":"https://api.github.com/users/bradleeedmondson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bradleeedmondson/subscriptions","organizations_url":"https://api.github.com/users/bradleeedmondson/orgs","repos_url":"https://api.github.com/users/bradleeedmondson/repos","events_url":"https://api.github.com/users/bradleeedmondson/events{/privacy}","received_events_url":"https://api.github.com/users/bradleeedmondson/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-05-31T16:43:12Z","updated_at":"2018-05-31T16:43:12Z","body":"@wking Would you be able to file a PR for these?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/393596497/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/393904369","html_url":"https://github.com/spdx/license-list-XML/issues/616#issuecomment-393904369","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/616","id":393904369,"node_id":"MDEyOklzc3VlQ29tbWVudDM5MzkwNDM2OQ==","user":{"login":"StefanBruens","id":1158848,"node_id":"MDQ6VXNlcjExNTg4NDg=","avatar_url":"https://avatars.githubusercontent.com/u/1158848?v=4","gravatar_id":"","url":"https://api.github.com/users/StefanBruens","html_url":"https://github.com/StefanBruens","followers_url":"https://api.github.com/users/StefanBruens/followers","following_url":"https://api.github.com/users/StefanBruens/following{/other_user}","gists_url":"https://api.github.com/users/StefanBruens/gists{/gist_id}","starred_url":"https://api.github.com/users/StefanBruens/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/StefanBruens/subscriptions","organizations_url":"https://api.github.com/users/StefanBruens/orgs","repos_url":"https://api.github.com/users/StefanBruens/repos","events_url":"https://api.github.com/users/StefanBruens/events{/privacy}","received_events_url":"https://api.github.com/users/StefanBruens/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-06-01T14:50:00Z","updated_at":"2018-06-01T14:50:00Z","body":"@bradleeedmondson Sorry for the late answer.\r\nMy only relationship with the fonts/license is as a packager.\r\nCopyright holder of the fonts is the german font foundry \"URW++\".\r\nTo my knowledge, https://github.com/chris-liddell from Artifex/Ghostscript acts as a proxy here.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/393904369/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/397408524","html_url":"https://github.com/spdx/license-list-XML/issues/616#issuecomment-397408524","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/616","id":397408524,"node_id":"MDEyOklzc3VlQ29tbWVudDM5NzQwODUyNA==","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-06-14T19:18:06Z","updated_at":"2018-06-14T19:18:06Z","body":"re: the versioning issue: if we can get the author to provide such info, that is ideal. otherwise, if there is not one, and we don't know of other versions, I also think it's fine to not have a version - if and when a later version comes out, we can add a version number than as well. I think we have had this scenario.\r\nbut I don't feel super strong about any option only that if we use a date, that date should reflect the origin of the exception (I wasn't clear if that was the case here).\r\n\r\nIn any case, do you think we can get this wrapped up on the next week for v3.2 release?","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/397408524/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/403153501","html_url":"https://github.com/spdx/license-list-XML/issues/616#issuecomment-403153501","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/616","id":403153501,"node_id":"MDEyOklzc3VlQ29tbWVudDQwMzE1MzUwMQ==","user":{"login":"bradleeedmondson","id":7350638,"node_id":"MDQ6VXNlcjczNTA2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/7350638?v=4","gravatar_id":"","url":"https://api.github.com/users/bradleeedmondson","html_url":"https://github.com/bradleeedmondson","followers_url":"https://api.github.com/users/bradleeedmondson/followers","following_url":"https://api.github.com/users/bradleeedmondson/following{/other_user}","gists_url":"https://api.github.com/users/bradleeedmondson/gists{/gist_id}","starred_url":"https://api.github.com/users/bradleeedmondson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bradleeedmondson/subscriptions","organizations_url":"https://api.github.com/users/bradleeedmondson/orgs","repos_url":"https://api.github.com/users/bradleeedmondson/repos","events_url":"https://api.github.com/users/bradleeedmondson/events{/privacy}","received_events_url":"https://api.github.com/users/bradleeedmondson/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-07-06T21:39:57Z","updated_at":"2018-07-06T21:44:51Z","body":"Casting this now; decided to go with:\r\n * Proposed name: AGPL-3.0 font exception PS/PDF 20170817\r\n * Proposed short identifier: AGPL-3.0-font-exception-PS-or-PDF-20170817\r\n\r\nDecided not to mark this up as generalizable (i.e. leave in the AGPL-3 reference) for now.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/403153501/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/403155240","html_url":"https://github.com/spdx/license-list-XML/issues/616#issuecomment-403155240","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/616","id":403155240,"node_id":"MDEyOklzc3VlQ29tbWVudDQwMzE1NTI0MA==","user":{"login":"wking","id":209920,"node_id":"MDQ6VXNlcjIwOTkyMA==","avatar_url":"https://avatars.githubusercontent.com/u/209920?v=4","gravatar_id":"","url":"https://api.github.com/users/wking","html_url":"https://github.com/wking","followers_url":"https://api.github.com/users/wking/followers","following_url":"https://api.github.com/users/wking/following{/other_user}","gists_url":"https://api.github.com/users/wking/gists{/gist_id}","starred_url":"https://api.github.com/users/wking/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wking/subscriptions","organizations_url":"https://api.github.com/users/wking/orgs","repos_url":"https://api.github.com/users/wking/repos","events_url":"https://api.github.com/users/wking/events{/privacy}","received_events_url":"https://api.github.com/users/wking/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-07-06T21:49:30Z","updated_at":"2018-07-06T21:49:30Z","body":"> * Proposed short identifier: AGPL-3.0-font-exception-PS-or-PDF-20170817\r\n\r\nWith the `-20170817` versioning being so specific, we probably don't need the `AGPL-3.0-` prefix.  Do you really want `AGPL-3.0-only WITH AGPL-3.0-font-exception-PS-or-PDF-20170817`?\r\n\r\nAlso, I realize we have precedents for YYYYMMDD dates, but I think it would be easier to read if we stuck with the [standard][1] YYYY-MM-DD.\r\n\r\nBoth of these are minor nits; any of them would make reasonable names and/or short IDs.\r\n\r\n[1]: https://tools.ietf.org/html/rfc3339#section-5.6\r\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/403155240/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/403156805","html_url":"https://github.com/spdx/license-list-XML/issues/616#issuecomment-403156805","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/616","id":403156805,"node_id":"MDEyOklzc3VlQ29tbWVudDQwMzE1NjgwNQ==","user":{"login":"bradleeedmondson","id":7350638,"node_id":"MDQ6VXNlcjczNTA2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/7350638?v=4","gravatar_id":"","url":"https://api.github.com/users/bradleeedmondson","html_url":"https://github.com/bradleeedmondson","followers_url":"https://api.github.com/users/bradleeedmondson/followers","following_url":"https://api.github.com/users/bradleeedmondson/following{/other_user}","gists_url":"https://api.github.com/users/bradleeedmondson/gists{/gist_id}","starred_url":"https://api.github.com/users/bradleeedmondson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bradleeedmondson/subscriptions","organizations_url":"https://api.github.com/users/bradleeedmondson/orgs","repos_url":"https://api.github.com/users/bradleeedmondson/repos","events_url":"https://api.github.com/users/bradleeedmondson/events{/privacy}","received_events_url":"https://api.github.com/users/bradleeedmondson/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-07-06T21:58:10Z","updated_at":"2018-07-06T22:05:15Z","body":"> Do you really want AGPL-3.0-only WITH AGPL-3.0-font-exception-PS-or-PDF-20170817?\r\n\r\nNot wedded to it. But I did add the AGPL-3.0 prefix based on the first sentence. However, if I mark that up as optional, then it makes more sense to call this exception like so:\r\n\r\n* PD/PDF font exception (2017-08-17)\r\n* PS-or-PDF-font-exception-20170817\r\n-----------\r\nEdited to add: For dates I hear you, but I think internal consistency is more important. It looks like [1][2] we've used (YYYY) or (YYYY-MM-DD) in name and YYYYMMDD in identifier, so that's what I'll do here.\r\n\r\n[1] https://spdx.org/licenses/Unicode-DFS-2016.html\r\n[2] https://spdx.org/licenses/W3C-20150513.html\r\n\r\n----------\r\nLate update: be sure to ignore [3], hah\r\n\r\n[3] https://spdx.org/licenses/BSD-3-Clause-No-Nuclear-License-2014.html","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/403156805/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/404585680","html_url":"https://github.com/spdx/license-list-XML/issues/616#issuecomment-404585680","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/616","id":404585680,"node_id":"MDEyOklzc3VlQ29tbWVudDQwNDU4NTY4MA==","user":{"login":"bradleeedmondson","id":7350638,"node_id":"MDQ6VXNlcjczNTA2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/7350638?v=4","gravatar_id":"","url":"https://api.github.com/users/bradleeedmondson","html_url":"https://github.com/bradleeedmondson","followers_url":"https://api.github.com/users/bradleeedmondson/followers","following_url":"https://api.github.com/users/bradleeedmondson/following{/other_user}","gists_url":"https://api.github.com/users/bradleeedmondson/gists{/gist_id}","starred_url":"https://api.github.com/users/bradleeedmondson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bradleeedmondson/subscriptions","organizations_url":"https://api.github.com/users/bradleeedmondson/orgs","repos_url":"https://api.github.com/users/bradleeedmondson/repos","events_url":"https://api.github.com/users/bradleeedmondson/events{/privacy}","received_events_url":"https://api.github.com/users/bradleeedmondson/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-07-12T17:18:19Z","updated_at":"2018-07-12T17:18:19Z","body":"This exception was added for 3.2, so closing this issue.\r\n\r\nProposed to address some nits for 3.3 release in #669 ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/404585680/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]