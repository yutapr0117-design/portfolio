ring","id":61065894,"node_id":"MDQ6VXNlcjYxMDY1ODk0","avatar_url":"https://avatars.githubusercontent.com/u/61065894?v=4","gravatar_id":"","url":"https://api.github.com/users/bgoldring","html_url":"https://github.com/bgoldring","followers_url":"https://api.github.com/users/bgoldring/followers","following_url":"https://api.github.com/users/bgoldring/following{/other_user}","gists_url":"https://api.github.com/users/bgoldring/gists{/gist_id}","starred_url":"https://api.github.com/users/bgoldring/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bgoldring/subscriptions","organizations_url":"https://api.github.com/users/bgoldring/orgs","repos_url":"https://api.github.com/users/bgoldring/repos","events_url":"https://api.github.com/users/bgoldring/events{/privacy}","received_events_url":"https://api.github.com/users/bgoldring/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-08-29T04:03:39Z","updated_at":"2020-08-29T04:03:39Z","body":"@swinslow This version of the LibGD license is only used for LibGD. I cannot find any indication that it is used for any other project, as well it is specifically drafted referencing \"gd\" in the license itself. As such, it appears this license was only intended to be used with LibGD. Based on that, and the SPDX guidelines for license inclusion I would be of the recommendation it's not fit for inclusion at this time until more widespread use with other projects can be identified.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/683232360/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/683257320","html_url":"https://github.com/spdx/license-list-XML/issues/1060#issuecomment-683257320","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1060","id":683257320,"node_id":"MDEyOklzc3VlQ29tbWVudDY4MzI1NzMyMA==","user":{"login":"lal12","id":14139770,"node_id":"MDQ6VXNlcjE0MTM5Nzcw","avatar_url":"https://avatars.githubusercontent.com/u/14139770?v=4","gravatar_id":"","url":"https://api.github.com/users/lal12","html_url":"https://github.com/lal12","followers_url":"https://api.github.com/users/lal12/followers","following_url":"https://api.github.com/users/lal12/following{/other_user}","gists_url":"https://api.github.com/users/lal12/gists{/gist_id}","starred_url":"https://api.github.com/users/lal12/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lal12/subscriptions","organizations_url":"https://api.github.com/users/lal12/orgs","repos_url":"https://api.github.com/users/lal12/repos","events_url":"https://api.github.com/users/lal12/events{/privacy}","received_events_url":"https://api.github.com/users/lal12/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-08-29T08:30:01Z","updated_at":"2020-08-29T08:30:01Z","body":"> @swinslow This version of the LibGD license is only used for LibGD. I cannot find any indication that it is used for any other project, as well it is specifically drafted referencing \"gd\" in the license itself. As such, it appears this license was only intended to be used with LibGD. Based on that, and the SPDX guidelines for license inclusion I would be of the recommendation it's not fit for inclusion at this time until more widespread use with other projects can be identified.\r\n\r\nI don't know about the guidelines, but it seems to me that this is the case for a bunch of licenses with SPDX identifier: libpng, ntp, php, postgresql, python, ssh-openssh, vim, libpng, libtiff, imagemagick.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/683257320/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confus