verga/followers","following_url":"https://api.github.com/users/mattiaverga/following{/other_user}","gists_url":"https://api.github.com/users/mattiaverga/gists{/gist_id}","starred_url":"https://api.github.com/users/mattiaverga/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mattiaverga/subscriptions","organizations_url":"https://api.github.com/users/mattiaverga/orgs","repos_url":"https://api.github.com/users/mattiaverga/repos","events_url":"https://api.github.com/users/mattiaverga/events{/privacy}","received_events_url":"https://api.github.com/users/mattiaverga/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-04-25T06:39:04Z","updated_at":"2023-04-25T06:39:04Z","body":"I think upstream relicensing to MIT will not occur anytime soon, so if you think that the current \"permission notice\" is acceptable as is we can proceed. I'm waiting for a comment in the PR about what to do with the link to upstream inside the license text, which is currently formatted as markup: should I use just plain text and, if so, should I completely remove the link or is there a way to provide it?\r\n\r\nBut if you're not sure you want to have this \"permission notice\" approved I can just retire the new package request to Fedora (nothing is already packaged and in repositories yet).","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1521230193/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1521676729","html_url":"https://github.com/spdx/license-list-XML/issues/1869#issuecomment-1521676729","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1869","id":1521676729,"node_id":"IC_kwDOA0JFE85asvG5","user":{"login":"musicinmybrain","id":6898909,"