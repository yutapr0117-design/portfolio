pi.github.com/users/bsdimp/events{/privacy}","received_events_url":"https://api.github.com/users/bsdimp/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-11-18T23:50:00Z","updated_at":"2022-11-18T23:50:00Z","body":"Makes me wonder if we should mark all 'email' addresses as 'optional' for matching purposes. Likewise for entity names?\r\n\r\n+1 from me for what that's worth. Fedora name is fine. I have nothing better.","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1320665805/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1331146189","html_url":"https://github.com/spdx/license-list-XML/issues/1611#issuecomment-1331146189","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1611","id":1331146189,"node_id":"IC_kwDOA0JFE85PV63N","user":{"login":"copernicat","id":111796332,"node_id":"U_kgDOBqngbA","avatar_url":"https://avatars.githubusercontent.com/u/111796332?v=4","gravatar_id":"","url":"https://api.github.com/users/copernicat","html_url":"https://github.com/copernicat","followers_url":"https://api.github.com/users/copernicat/followers","following_url":"https://api.github.com/users/copernicat/following{/other_user}","gists_url":"https://api.github.com/users/copernicat/gists{/gist_id}","starred_url":"https://api.github.com/users/copernicat/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/copernicat/subscriptions","organizations_url":"https://api.github.com/users/copernicat/orgs","repos_url":"https://api.github.com/users/copernicat/repos","events_url":"https://api.github.com/users/copernicat/events{/privacy}","received_events_url":"https://api.github.com/users/copernicat/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-11-29T18:58:59Z","updated_at":"2022-11-29T18:58:59Z","body":"Question: Because the license is so short, would allowing variation in the email address potentially cause this identifier to be applied in ways that don't make sense, e.g. to something that is not Time::ParseDate? On one hand, reuse is an advantage for a license identifier, but on the other, the name could be misleading. It differs from the license IDs BSD and MIT, for example, because it describes this particular package.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1331146189/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1333250799","html_url":"https://github.com/spdx/license-list-XML/issues/1611#issuecomment-1333250799","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1611","id":1333250799,"node_id":"IC_kwDOA0JFE85Pd8rv","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-12-01T05:57:18Z","updated_at":"2022-12-01T05:57:18Z","body":"generally, we have not added markup unless or until we find a real variation, for example in this case, this license with a different email address. I think that's probably fine for this license","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1333250799/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1336266974","html_url":"https://github.com/spdx/license-list-XML/issues/1611#issuecomment-1336266974","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1611","id":1336266974,"node_id":"IC_kwDOA0JFE85PpdDe","user":{"login":"swinslow","id":678569,"node_id":"MDQ6VXNlcjY3ODU2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/678569?v=4","gravatar_id":"","url":"https://api.github.com/users/swinslow","html_url":"https://github.com/swinslow","followers_url":"https://api.github.com/users/swinslow/followers","following_url":"https://api.github.com/users/swinslow/following{/other_user}","gists_url":"https://api.github.com/users/swinslow/gists{/gist_id}","starred_url":"https://api.github.com/users/swinslow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/swinslow/subscriptions","organizations_url":"https://api.github.com/users/swinslow/orgs","repos_url":"https://api.github.com/users/swinslow/repos","events_url":"https://api.github.com/users/swinslow/events{/privacy}","received_events_url":"https://api.github.com/users/swinslow/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-12-03T22:06:36Z","updated_at":"2022-12-03T22:06:48Z","body":"+1 to add. \r\n\r\nI don't have a particular preference for the identifier either, but I do note that it appears that it has been used by David Muir Sharnoff for several other Perl packages:\r\n* https://sources.debian.org/copyright/license/libnet-netmask-perl/1.9015-4/\r\n* https://github.com/muir/Net-SMTP-Receive\r\n* https://metacpan.org/release/MUIR/File-Slurp-2004.0904/view/lib/File/Slurp.pm\r\n\r\nEach of these also uses a different email address from the TPDL example, and additionally doesn't have a Google copyright (though both of these can be accommodated by markup of course).\r\n\r\nSince this license appears to be used by David Muir Sharnoff for a variety of projects, I could be convinced to use his name in the ID in the same manner that we did for [libutil-David-Nugent](https://spdx.org/licenses/libutil-David-Nugent.html) in 3.19. But if that would be disruptive to Fedora, then I could also be persuaded that just going with TPDL is fine.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1336266974/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1338764529","html_url":"https://github.com/spdx/license-list-XML/issues/1611#issuecomment-1338764529","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1611","id":1338764529,"node_id":"IC_kwDOA0JFE85Py-zx","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-12-06T05:07:50Z","updated_at":"2022-12-06T05:07:56Z","body":"# License Inclusion Decision\r\n\r\n## Decision:\r\n\r\n- [x] approved\r\n- [ ] not approved\r\n\r\n## License full name\r\n\r\nTime::ParseDate License \r\n\r\n## Short ID\r\n\r\nTPDL\r\n\r\n## XML markup\r\n\r\nfor email address only, markup for variations of:\r\ncpan@dave.sharnoff.org\r\nand \r\nmuir@idiom.org\r\n\r\n(do alt for now, then can generalize if need be?)","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1338764529/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]