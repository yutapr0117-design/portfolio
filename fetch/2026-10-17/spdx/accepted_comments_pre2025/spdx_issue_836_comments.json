ub.com/spdx/license-list-XML/issues/836#issuecomment-493137541","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/836","id":493137541,"node_id":"MDEyOklzc3VlQ29tbWVudDQ5MzEzNzU0MQ==","user":{"login":"bradleeedmondson","id":7350638,"node_id":"MDQ6VXNlcjczNTA2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/7350638?v=4","gravatar_id":"","url":"https://api.github.com/users/bradleeedmondson","html_url":"https://github.com/bradleeedmondson","followers_url":"https://api.github.com/users/bradleeedmondson/followers","following_url":"https://api.github.com/users/bradleeedmondson/following{/other_user}","gists_url":"https://api.github.com/users/bradleeedmondson/gists{/gist_id}","starred_url":"https://api.github.com/users/bradleeedmondson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bradleeedmondson/subscriptions","organizations_url":"https://api.github.com/users/bradleeedmondson/orgs","repos_url":"https://api.github.com/users/bradleeedmondson/repos","events_url":"https://api.github.com/users/bradleeedmondson/events{/privacy}","received_events_url":"https://api.github.com/users/bradleeedmondson/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-05-16T16:24:37Z","updated_at":"2019-05-16T16:24:37Z","body":"The links @mlinksva provides lead to two different license texts, the 2002 PD Dedication and the 2004 PD Dedication or Certification.\n\nIn my opinion, those are substantially different from each other (legally), so I think we'll need to add these as two different licenses with two different IDs.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/493137541/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/501719579","html_url":"https://github.com/spdx/license-list-XML/issues/836#issuecomment-501719579","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/836","id":501719579,"node_id":"MDEyOklzc3VlQ29tbWVudDUwMTcxOTU3OQ==","user":{"login":"swinslow","id":678569,"node_id":"MDQ6VXNlcjY3ODU2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/678569?v=4","gravatar_id":"","url":"https://api.github.com/users/swinslow","html_url":"https://github.com/swinslow","followers_url":"https://api.github.com/users/swinslow/followers","following_url":"https://api.github.com/users/swinslow/following{/other_user}","gists_url":"https://api.github.com/users/swinslow/gists{/gist_id}","starred_url":"https://api.github.com/users/swinslow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/swinslow/subscriptions","organizations_url":"https://api.github.com/users/swinslow/orgs","repos_url":"https://api.github.com/users/swinslow/repos","events_url":"https://api.github.com/users/swinslow/events{/privacy}","received_events_url":"https://api.github.com/users/swinslow/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-06-13T14:10:39Z","updated_at":"2019-06-13T14:10:39Z","body":"Agree with @bradleeedmondson -- these do appear to be two separate texts and should probably get two separate entries. We may want to get Creative Commons' input on the desired names and identifiers for these two entries, before they are added to the list.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/501719579/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/501739068","html_url":"https://github.com/spdx/license-list-XML/issues/836#issuecomment-501739068","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/836","id":501739068,"node_id":"MDEyOklzc3VlQ29tbWVudDUwMTczOTA2OA==","user":{"login":"pombredanne","id":675997,"node_id":"MDQ6VXNlcjY3NTk5Nw==","avatar_url":"https://avatars.githubusercontent.com/u/675997?v=4","gravatar_id":"","url":"https://api.github.com/users/pombredanne","html_url":"https://github.com/pombredanne","followers_url":"https://api.github.com/users/pombredanne/followers","following_url":"https://api.github.com/users/pombredanne/following{/other_user}","gists_url":"https://api.github.com/users/pombredanne/gists{/gist_id}","starred_url":"https://api.github.com/users/pombredanne/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pombredanne/subscriptions","organizations_url":"https://api.github.com/users/pombredanne/orgs","repos_url":"https://api.github.com/users/pombredanne/repos","events_url":"https://api.github.com/users/pombredanne/events{/privacy}","received_events_url":"https://api.github.com/users/pombredanne/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-06-13T14:56:00Z","updated_at":"2019-06-13T14:56:00Z","body":"@swinslow @bradleeedmondson so you confirm that the 2002 text reported by @mlinksva should be treated as separate license from the 2004 text?\r\n\r\nThe 2004 text is rather common. The 2002 text is rather uncommon: https://github.com/search?q=%22The+person+or+persons+who+have+associated+their+work+with+this+document%22&type=Code ... 9 files. And a few odds and ends: http://www.authorama.com/microsoft-research-drm-talk-7.html ... I am fine to treat it as a new license, but I am not sure this passes a usage threshold. ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/501739068/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https:/