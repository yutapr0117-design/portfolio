-XML/issues/1292#issuecomment-1029170972","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1292","id":1029170972,"node_id":"IC_kwDOA0JFE849V-cc","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-02-03T16:31:59Z","updated_at":"2022-02-03T16:31:59Z","body":"pinging @pombredanne again - would love to hear what you might be seeing via Scancode on these variants!","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1029170972/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/1050028180","html_url":"https://github.com/spdx/license-list-XML/issues/1292#issuecomment-1050028180","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1292","id":1050028180,"node_id":"IC_kwDOA0JFE84-liiU","user":{"login":"swinslow","id":678569,"node_id":"MDQ6VXNlcjY3ODU2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/678569?v=4","gravatar_id":"","url":"https://api.github.com/users/swinslow","html_url":"https://github.com/swinslow","followers_url":"https://api.github.com/users/swinslow/followers","following_url":"https://api.github.com/users/swinslow/following{/other_user}","gists_url":"https://api.github.com/users/swinslow/gists{/gist_id}","starred_url":"https://api.github.com/users/swinslow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/swinslow/subscriptions","organizations_url":"https://api.github.com/users/swinslow/orgs","repos_url":"https://api.github.com/users/swinslow/repos","events_url":"https://api.github.com/users/swinslow/events{/privacy}","received_events_url":"https://api.github.com/users/swinslow/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-02-24T16:22:26Z","updated_at":"2022-02-24T16:22:26Z","body":"Agree with @jlovejoy's summary [here](https://github.com/spdx/license-list-XML/issues/1292#issuecomment-890256652). The three variants we're aware of appear to be:\r\n\r\n1. [mpich2](https://spdx.org/licenses/mpich2.html) (already on SPDX license list);\r\n2. A variant of mpich2 that omits the \"This software was authored by\" reference, the GOVERNMENT LICENSE section and the first sentence of DISCLAIMER; and\r\n3. A variant which includes literally just the \"Permission is hereby granted...\" sentence (apparently followed by [BSD-3-Clause-Open-MPI](https://spdx.org/licenses/BSD-3-Clause-Open-MPI.html)).\r\n\r\nI'm +1 to add 2 and 3 as separate variants. For 3 I would just include the \"Permission is hereby granted\" sentence and not the rest since BSD-3-Clause-Open-MPI already exists.\r\n\r\nI wouldn't call any of these \"MIT-mpich2\". Probably something like \"mpich2-general\" for 2 and \"mpich2-permission-only\" for 3, though I don't feel strongly about either of those names.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/lice