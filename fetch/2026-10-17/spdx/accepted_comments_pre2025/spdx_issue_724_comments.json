winslow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/swinslow/subscriptions","organizations_url":"https://api.github.com/users/swinslow/orgs","repos_url":"https://api.github.com/users/swinslow/repos","events_url":"https://api.github.com/users/swinslow/events{/privacy}","received_events_url":"https://api.github.com/users/swinslow/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-03-21T17:06:03Z","updated_at":"2019-03-21T17:06:03Z","body":"This request was discussed on 2019-03-21 legal team call. Consensus was not yet reached on whether to add this as separate licenses from OFL-1.0 and OFL-1.1, and more discussion was desired. The team's intention is to dedicate more time for analyzing this on the next legal team call on 2019-04-04, with the aim of making a yes-or-no decision then.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/475318782/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/480122629","html_url":"https://github.com/spdx/license-list-XML/issues/724#issuecomment-480122629","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/724","id":480122629,"node_id":"MDEyOklzc3VlQ29tbWVudDQ4MDEyMjYyOQ==","user":{"login":"bradleeedmondson","id":7350638,"node_id":"MDQ6VXNlcjczNTA2Mzg=","avatar_url":"https://avatars.githubusercontent.com/u/7350638?v=4","gravatar_id":"","url":"https://api.github.com/users/bradleeedmondson","html_url":"https://github.com/bradleeedmondson","followers_url":"https://api.github.com/users/bradleeedmondson/followers","following_url":"https://api.github.com/users/bradleeedmondson/following{/other_user}","gists_url":"https://api.github.com/users/bradleeedmondson/gists{/gist_id}","starred_url":"https://api.github.com/users/bradleeedmondson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bradleeedmondson/subscriptions","organizations_url":"https://api.github.com/users/bradleeedmondson/orgs","repos_url":"https://api.github.com/users/bradleeedmondson/repos","events_url":"https://api.github.com/users/bradleeedmondson/events{/privacy}","received_events_url":"https://api.github.com/users/bradleeedmondson/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-04-05T01:55:26Z","updated_at":"2019-04-05T01:55:26Z","body":"Legal team volunteer here. We did not get the chance to discuss on today's call, but will look at this for the next release cycle (if it is accepted). ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/480122629/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/544057496","html_url":"https://github.com/spdx/license-list-XML/issues/724#issuecomment-544057496","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/724","id":544057496,"node_id":"MDEyOklzc3VlQ29tbWVudDU0NDA1NzQ5Ng==","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-10-19T02:27:04Z","updated_at":"2019-10-19T02:27:04Z","body":"oh dear, this is quite old - needs attention!","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/544057496/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/569972335","html_url":"https://github.com/spdx/license-list-XML/issues/724#issuecomment-569972335","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/724","id":569972335,"node_id":"MDEyOklzc3VlQ29tbWVudDU2OTk3MjMzNQ==","user":{"login":"swinslow","id":678569,"node_id":"MDQ6VXNlcjY3ODU2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/678569?v=4","gravatar_id":"","url":"https://api.github.com/users/swinslow","html_url":"https://github.com/swinslow","followers_url":"https://api.github.com/users/swinslow/followers","following_url":"https://api.github.com/users/swinslow/following{/other_user}","gists_url":"https://api.github.com/users/swinslow/gists{/gist_id}","starred_url":"https://api.github.com/users/swinslow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/swinslow/subscriptions","organizations_url":"https://api.github.com/users/swinslow/orgs","repos_url":"https://api.github.com/users/swinslow/repos","events_url":"https://api.github.com/users/swinslow/events{/privacy}","received_events_url":"https://api.github.com/users/swinslow/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-12-31T18:41:44Z","updated_at":"2019-12-31T18:41:44Z","body":"Circling back on this very old issue -- I think this is a path forward:\r\n\r\nI think it is appropriate to accommodate the RFN concept on the license list. However, I don't think it fits as an \"exception\" for the exceptions list. Given the way SPDX \"exceptions\" currently work, they're generally meant to be something that removes obligations or restriction. By contrast, treating RFN as an exception by saying `OFL-1.1 WITH RFN` is actually the opposite -- it's essentially _adding_ a restriction.\r\n\r\nSo instead, I'd propose adding separate license IDs on the main license list:\r\n* `OFL-1.1-RFN` -- use where licensed under OFL-1.1, when we know that there _is_ a RFN\r\n* `OFL-1.1-no-RFN` -- use where licensed under OFL-1.1, when we know that there _is not_ a RFN\r\n* `OFL-1.1` -- also keep existing ID, to mean that it is licensed under OFL-1.1, but when _we are not asserting anything about whether there is an RFN_\r\n\r\nand then the same pattern for OFL-1.0 as well.\r\n\r\nI think this approach (particularly the last bullet point) keeps things consistent with current uses and meanings of the existing OFL-1.1 identifier, but adds the -RFN and -no-RFN options to enable expressing those meanings if desired.\r\n\r\n@n8willis / @davelab6 -- any objections to this approach?\r\n@jlovejoy and others who commented -- any concerns with handling things this way?\r\n\r\nIf no objections, I'm happy to prepare a PR to add these. However, as a heads-up, there may also be a technical issue that would need to be resolved to handle it this way. I believe the license list publisher + test infrastructure will flag an error if it sees new licenses with identical texts (which would be the case here). We would just need to configure it to exclude these OFL instances, which I think we already do for a few that are known to have identical texts (e.g. GPL-3.0-only vs GPL-3.0-or-later). cc @goneall -- I may need a bit of help from you in sorting through this  :)","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/569972335/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/575218446","html_url":"https://github.com/spdx/license-list-XML/issues/724#issuecomment-575218446","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/724","id":575218446,"node_id":"MDEyOklzc3VlQ29tbWVudDU3NTIxODQ0Ng==","user":{"login":"swinslow","id":678569,"node_id":"MDQ6VXNlcjY3ODU2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/678569?v=4","gravatar_id":"","url":"https://api.github.com/users/swinslow","html_url":"https://github.com/swinslow","followers_url":"https://api.github.com/users/swinslow/followers","following_url":"https://api.github.com/users/swinslow/following{/other_user}","gists_url":"https://api.github.com/users/swinslow/gists{/gist_id}","starred_url":"https://api.github.com/users/swinslow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/swinslow/subscriptions","organizations_url":"https://api.github.com/users/swinslow/orgs","repos_url":"https://api.github.com/users/swinslow/repos","events_url":"https://api.github.com/users/swinslow/events{/privacy}","received_events_url":"https://api.github.com/users/swinslow/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-01-16T15:57:51Z","updated_at":"2020-01-16T15:57:51Z","body":"PR #965 submitted to address this; to be discussed on today's legal team call.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/575218446/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":