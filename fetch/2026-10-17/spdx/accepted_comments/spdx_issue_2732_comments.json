6094/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2884017308","html_url":"https://github.com/spdx/license-list-XML/issues/2732#issuecomment-2884017308","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/2732","id":2884017308,"node_id":"IC_kwDOA0JFE86r5pyc","user":{"login":"richardfontana","id":1179636,"node_id":"MDQ6VXNlcjExNzk2MzY=","avatar_url":"https://avatars.githubusercontent.com/u/1179636?v=4","gravatar_id":"","url":"https://api.github.com/users/richardfontana","html_url":"https://github.com/richardfontana","followers_url":"https://api.github.com/users/richardfontana/followers","following_url":"https://api.github.com/users/richardfontana/following{/other_user}","gists_url":"https://api.github.com/users/richardfontana/gists{/gist_id}","starred_url":"https://api.github.com/users/richardfontana/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/richardfontana/subscriptions","organizations_url":"https://api.github.com/users/richardfontana/orgs","repos_url":"https://api.github.com/users/richardfontana/repos","events_url":"https://api.github.com/users/richardfontana/events{/privacy}","received_events_url":"https://api.github.com/users/richardfontana/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-15T14:26:24Z","updated_at":"2025-05-15T14:26:24Z","body":"I think the only part of the inclusion criteria this license might not meet is \"The license has actual, substantial use such that it is likely to be encountered. Substantial use may be demonstrated via use in many projects, or in one or a few significant projects. For new licenses, there are definitive plans for the license to be used in one or a few significant projects.\"\n\nPresumably there is no \"actual, substantial use\" yet, but can evidence be provided of \"definitive plans\"? Given the common organizational connections with SPDX I wouldn't want to see this license treated inconsistently with the way SPDX has dealt with other new licenses having no Linux Foundation association. I believe there have been a number of new licenses submitted to SPDX that have ended up not being included in the license list primarily because of the lack of substantial use. ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2884017308/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2884324579","html_url":"https://github.com/spdx/license-list-XML/issues/2732#issuecomment-2884324579","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/2732","id":2884324579,"node_id":"IC_kwDOA0JFE86r60zj","user":{"login":"matthew-d-white","id":12001047,"node_id":"MDQ6VXNlcjEyMDAxMDQ3","avatar_url":"https://avatars.githubusercontent.com/u/12001047?v=4","gravatar_id":"","url":"https://api.github.com/users/matthew-d-white","html_url":"https://github.com/matthew-d-white","followers_url":"https://api.github.com/users/matthew-d-white/followers","following_url":"https://api.github.com/users/matthew-d-white/following{/other_user}","gists_url":"https://api.github.com/users/matthew-d-white/gists{/gist_id}","starred_url":"https://api.github.com/users/matthew-d-white/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/matthew-d-white/subscriptions","organizations_url":"https://api.github.com/users/matthew-d-white/orgs","repos_url":"https://api.github.com/users/matthew-d-white/repos","events_url":"https://api.github.com/users/matthew-d-white/events{/privacy}","received_events_url":"https://api.github.com/users/matthew-d-white/received_events","typ