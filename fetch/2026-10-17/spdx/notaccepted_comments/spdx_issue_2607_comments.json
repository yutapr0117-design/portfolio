[{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2459819084","html_url":"https://github.com/spdx/license-list-XML/issues/2607#issuecomment-2459819084","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/2607","id":2459819084,"node_id":"IC_kwDOA0JFE86SndxM","user":{"login":"swinslow","id":678569,"node_id":"MDQ6VXNlcjY3ODU2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/678569?v=4","gravatar_id":"","url":"https://api.github.com/users/swinslow","html_url":"https://github.com/swinslow","followers_url":"https://api.github.com/users/swinslow/followers","following_url":"https://api.github.com/users/swinslow/following{/other_user}","gists_url":"https://api.github.com/users/swinslow/gists{/gist_id}","starred_url":"https://api.github.com/users/swinslow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/swinslow/subscriptions","organizations_url":"https://api.github.com/users/swinslow/orgs","repos_url":"https://api.github.com/users/swinslow/repos","events_url":"https://api.github.com/users/swinslow/events{/privacy}","received_events_url":"https://api.github.com/users/swinslow/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-06T13:55:07Z","updated_at":"2024-11-06T13:55:07Z","body":"Can you please provide links to several projects in the wild (e.g., broader community projects, not just your own personal projects) that have been using this license?","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2459819084/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2459850858","html_url":"https://github.com/spdx/license-list-XML/issues/2607#issuecomment-2459850858","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/2607","id":2459850858,"node_id":"IC_kwDOA0JFE86Snlhq","user":{"login":"rastislavcore","id":537310,"node_id":"MDQ6VXNlcjUzNzMxMA==","avatar_url":"https://avatars.githubusercontent.com/u/537310?v=4","gravatar_id":"","url":"https://api.github.com/users/rastislavcore","html_url":"https://github.com/rastislavcore","followers_url":"https://api.github.com/users/rastislavcore/followers","following_url":"https://api.github.com/users/rastislavcore/following{/other_user}","gists_url":"https://api.github.com/users/rastislavcore/gists{/gist_id}","starred_url":"https://api.github.com/users/rastislavcore/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rastislavcore/subscriptions","organizations_url":"https://api.github.com/users/rastislavcore/orgs","repos_url":"https://api.github.com/users/rastislavcore/repos","events_url":"https://api.github.com/users/rastislavcore/events{/privacy}","received_events_url":"https://api.github.com/users/rastislavcore/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-06T14:07:44Z","updated_at":"2024-11-06T14:07:44Z","body":"Certainly! Here are several FOSS projects actively using this license:\r\n\r\n- https://github.com/DataLayerHost/txms-server\r\n- https://github.com/bchainhub/txms.js\r\n- https://github.com/bchainhub/remark-fediverse-user\r\n- https://github.com/core-laboratories/XmlGoaml\r\n- https://github.com/catchthatrabbit/pool-frontend\r\n- https://github.com/core-coin/pigeon\r\n\r\nThese projects demonstrate the license's utility across various open-source initiatives.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2459850858/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2465641686","html_url":"https://github.com/spdx/license-list-XML/issues/2607#issuecomment-2465641686","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/2607","id":2465641686,"node_id":"IC_kwDOA0JFE86S9rTW","user":{"login":"richardfontana","id":1179636,"node_id":"MDQ6VXNlcjExNzk2MzY=","avatar_url":"https://avatars.githubusercontent.com/u/1179636?v=4","gravatar_id":"","url":"https://api.github.com/users/richardfontana","html_url":"https://github.com/richardfontana","followers_url":"https://api.github.com/users/richardfontana/followers","following_url":"https://api.github.com/users/richardfontana/following{/other_user}","gists_url":"https://api.github.com/users/richardfontana/gists{/gist_id}","starred_url":"https://api.github.com/users/richardfontana/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/richardfontana/subscriptions","organizations_url":"https://api.github.com/users/richardfontana/orgs","repos_url":"https://api.github.com/users/richardfontana/repos","events_url":"https://api.github.com/users/richardfontana/events{/privacy}","received_events_url":"https://api.github.com/users/richardfontana/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-11-08T19:52:23Z","updated_at":"2024-11-08T19:56:42Z","body":"It looks like all ~but possibly [pigeon](https://github.com/core-coin/pigeon)~ the listed projects are connected to the issue opener. \r\n\r\nRegarding the assertion that these are FOSS/open source projects, that is an interesting question here (relevant because of the SPDX license inclusion criteria). The license is based on the MIT license but replaces the notice preservation paragraph with this clause:\r\n\r\n> All distribution of the Covered Software in Source Code Form, including any\r\nModifications and/or Contributions must be disclosed and publicly available.\r\n\r\nThis uses the capitalized terms \"Covered Software\", \"Source Code Form\", \"Modifications\" and \"Contributions\" without defining them (I wonder whether the license was influenced by certain well known open source licenses that do have these as defined terms?). \r\n\r\nAnyway, the truly noteworthy feature here is (as I read this) an attempt to require that all distribution of any sort be \"public\", i.e. presumably prohibiting merely distributing to one person. I'd assert that this fails traditional community standards for open source (which I would argue must *generally* permit you to choose your immediate distributees). Perhaps it's open to debate, but that debate hasn't been had anywhere as far as I am aware. \r\n\r\nI would say SPDX should not add this license because (a) the license is fundamentally unclear in using several undefined terms, (b) the license appears to only be used by projects associated with the issue opener and thus is not likely to be encountered, and (c) the license is possibly not FOSS for a fairly important (if under-explored) policy reason.\r\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2465641686/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2656493842","html_url":"https://github.com/spdx/license-list-XML/issues/2607#issuecomment-2656493842","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/2607","id":2656493842,"node_id":"IC_kwDOA0JFE86eVuES","user":{"login":"karsten-klein","id":20038021,"node_id":"MDQ6VXNlcjIwMDM4MDIx","avatar_url":"https://avatars.githubusercontent.com/u/20038021?v=4","gravatar_id":"","url":"https://api.github.com/users/karsten-klein","html_url":"https://github.com/karsten-klein","followers_url":"https://api.github.com/users/karsten-klein/followers","following_url":"https://api.github.com/users/karsten-klein/following{/other_user}","gists_url":"https://api.github.com/users/karsten-klein/gists{/gist_id}","starred_url":"https://api.github.com/users/karsten-klein/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/karsten-klein/subscriptions","organizations_url":"https://api.github.com/users/karsten-klein/orgs","repos_url":"https://api.github.com/users/karsten-klein/repos","events_url":"https://api.github.com/users/karsten-klein/events{/privacy}","received_events_url":"https://api.github.com/users/karsten-klein/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-13T12:45:34Z","updated_at":"2025-02-13T12:45:34Z","body":"**{metæffekt} Universe**\ncanonical name: [CORE License](https://github.com/org-metaeffekt/metaeffekt-universe/blob/main/src/main/resources/ae-universe/[c]/README.md#user-content-CORE-License:~:text=CORE%20License)\nshort name: CORE-License\nmarkers: No Warranty Marker\ncategory: CORE License\nOSI status: _none_\n\n**ScanCode**\nmatched id: [mit-0](https://github.com/nexB/scancode-toolkit/blob/develop/src/licensedcode/data/licenses/mit-0.LICENSE)\n\n**Comment**\n+1 to add due to differentiated obligation and induced risk.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2656493842/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2681783315","html_url":"https://github.com/spdx/license-list-XML/issues/2607#issuecomment-2681783315","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/2607","id":2681783315,"node_id":"IC_kwDOA0JFE86f2MQT","user":{"login":"rastislavcore","id":537310,"node_id":"MDQ6VXNlcjUzNzMxMA==","avatar_url":"https://avatars.githubusercontent.com/u/537310?v=4","gravatar_id":"","url":"https://api.github.com/users/rastislavcore","html_url":"https://github.com/rastislavcore","followers_url":"https://api.github.com/users/rastislavcore/followers","following_url":"https://api.github.com/users/rastislavcore/following{/other_user}","gists_url":"https://api.github.com/users/rastislavcore/gists{/gist_id}","starred_url":"https://api.github.com/users/rastislavcore/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rastislavcore/subscriptions","organizations_url":"https://api.github.com/users/rastislavcore/orgs","repos_url":"https://api.github.com/users/rastislavcore/repos","events_url":"https://api.github.com/users/rastislavcore/events{/privacy}","received_events_url":"https://api.github.com/users/rastislavcore/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-25T12:22:30Z","updated_at":"2025-02-25T12:22:30Z","body":"A relevant software reference that is unrelated to me as owner - author and developed independently by another author, whom I have no connection with, is [Blockchain Wallet Validator](https://github.com/sergical/blockchain-wallet-validator). This project provides a validation framework for blockchain wallet addresses across multiple networks. I did contribute to the project, to improve the quality.\n\nOther software distributions are gradually emerging, and there is significant potential for wider adoption in the future. As the ecosystem evolves, discussions on license clarity, compliance with FOSS principles, and broader community adoption will become increasingly important.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2681783315/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2707141766","html_url":"https://github.com/spdx/license-list-XML/issues/2607#issuecomment-2707141766","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/2607","id":2707141766,"node_id":"IC_kwDOA0JFE86hW7SG","user":{"login":"rastislavcore","id":537310,"node_id":"MDQ6VXNlcjUzNzMxMA==","avatar_url":"https://avatars.githubusercontent.com/u/537310?v=4","gravatar_id":"","url":"https://api.github.com/users/rastislavcore","html_url":"https://github.com/rastislavcore","followers_url":"https://api.github.com/users/rastislavcore/followers","following_url":"https://api.github.com/users/rastislavcore/following{/other_user}","gists_url":"https://api.github.com/users/rastislavcore/gists{/gist_id}","starred_url":"https://api.github.com/users/rastislavcore/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rastislavcore/subscriptions","organizations_url":"https://api.github.com/users/rastislavcore/orgs","repos_url":"https://api.github.com/users/rastislavcore/repos","events_url":"https://api.github.com/users/rastislavcore/events{/privacy}","received_events_url":"https://api.github.com/users/rastislavcore/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-07T18:36:22Z","updated_at":"2025-03-07T18:36:22Z","body":"We have updated the README file to provide additional insights into the licensing details. You can review the changes here: [Core License Repository](https://github.com/bchainhub/core-license).","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2707141766/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2759149137","html_url":"https://github.com/spdx/license-list-XML/issues/2607#issuecomment-2759149137","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/2607","id":2759149137,"node_id":"IC_kwDOA0JFE86kdUZR","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-27T19:12:30Z","updated_at":"2025-03-27T19:12:30Z","body":"While the rationale page at https://github.com/bchainhub/core-license/tree/main is a nice-to-have, it is not binding in terms of legal interpretation. It is the license text that stands and as noted, the use of 4 capitalized yet undefined terms makes the license difficult if not impossible to interpret as it suggests there is missing info or someone made a very basic drafting mistake of capitalizing terms without defining them. The SPDX license inclusion definitive factor D states, \"The license has identifiable and stable text; it is not in the midst of drafting.\" and while this does not mention poor or incomplete drafting, I would interpret \"stable\" text as being able to expand to this concept.  \n\nLegal drafting need to prioritize clarify first and foremost (this is coming from someone who spends a lot of time drafting and reviewing various forms of legal language, a task I do not consider anyone ever being a perfect expert at - feedback is always a gift in this task :)","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2759149137/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2759155660","html_url":"https://github.com/spdx/license-list-XML/issues/2607#issuecomment-2759155660","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/2607","id":2759155660,"node_id":"IC_kwDOA0JFE86kdV_M","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-27T19:15:42Z","updated_at":"2025-03-27T19:15:42Z","body":"I would also add from more of my own open source license/community perspective: we have enough less-than-perfectly drafted licenses in the open source software ecosystem that have been around for years and we are stuck sort of stuck with them. As a community, we should endeavor to not make more/new licenses that introduce new/more lack of clarity. To me, that is another form of \"license proliferation\"!","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2759155660/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2767524311","html_url":"https://github.com/spdx/license-list-XML/issues/2607#issuecomment-2767524311","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/2607","id":2767524311,"node_id":"IC_kwDOA0JFE86k9RHX","user":{"login":"Pizza-Ria","id":46799628,"node_id":"MDQ6VXNlcjQ2Nzk5NjI4","avatar_url":"https://avatars.githubusercontent.com/u/46799628?v=4","gravatar_id":"","url":"https://api.github.com/users/Pizza-Ria","html_url":"https://github.com/Pizza-Ria","followers_url":"https://api.github.com/users/Pizza-Ria/followers","following_url":"https://api.github.com/users/Pizza-Ria/following{/other_user}","gists_url":"https://api.github.com/users/Pizza-Ria/gists{/gist_id}","starred_url":"https://api.github.com/users/Pizza-Ria/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Pizza-Ria/subscriptions","organizations_url":"https://api.github.com/users/Pizza-Ria/orgs","repos_url":"https://api.github.com/users/Pizza-Ria/repos","events_url":"https://api.github.com/users/Pizza-Ria/events{/privacy}","received_events_url":"https://api.github.com/users/Pizza-Ria/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-31T22:06:55Z","updated_at":"2025-03-31T22:06:55Z","body":"+1 to @richardfontana & @jlovejoy - disinclined to add.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2767524311/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2819069143","html_url":"https://github.com/spdx/license-list-XML/issues/2607#issuecomment-2819069143","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/2607","id":2819069143,"node_id":"IC_kwDOA0JFE86oB5TX","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-21T17:24:24Z","updated_at":"2025-04-21T17:24:24Z","body":"given we have had 3 people weigh in, I'm going to mark this as not accepted at this time. If the license gets revised and more uptake, we can always reconsider. ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/2819069143/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]