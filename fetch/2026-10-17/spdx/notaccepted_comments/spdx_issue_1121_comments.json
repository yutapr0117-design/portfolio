ute Covered Software or Derivative Works under plain GPL terms without special permission from Licensor.\"\n\n—\nYou are receiving this because you were assigned.\nReply to this email directly, view it on GitHub<https://github.com/spdx/license-list-XML/issues/1121#issuecomment-774217286>, or unsubscribe<https://github.com/notifications/unsubscribe-auth/AEY4DBKS36LHUBRHB5DR3HLS5Q35FANCNFSM4SJD4OZQ>.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/774717228/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/774829853","html_url":"https://github.com/spdx/license-list-XML/issues/1121#issuecomment-774829853","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/1121","id":774829853,"node_id":"MDEyOklzc3VlQ29tbWVudDc3NDgyOTg1Mw==","user":{"login":"jlovejoy","id":5048659,"node_id":"MDQ6VXNlcjUwNDg2NTk=","avatar_url":"https://avatars.githubusercontent.com/u/5048659?v=4","gravatar_id":"","url":"https://api.github.com/users/jlovejoy","html_url":"https://github.com/jlovejoy","followers_url":"https://api.github.com/users/jlovejoy/followers","following_url":"https://api.github.com/users/jlovejoy/following{/other_user}","gists_url":"https://api.github.com/users/jlovejoy/gists{/gist_id}","starred_url":"https://api.github.com/users/jlovejoy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jlovejoy/subscriptions","organizations_url":"https://api.github.com/users/jlovejoy/orgs","repos_url":"https://api.github.com/users/jlovejoy/repos","events_url":"https://api.github.com/users/jlovejoy/events{/privacy}","received_events_url":"https://api.github.com/users/jlovejoy/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-02-08T02:44:46Z","updated_at"