[{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/483826006","html_url":"https://github.com/spdx/license-list-XML/issues/838#issuecomment-483826006","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/838","id":483826006,"node_id":"MDEyOklzc3VlQ29tbWVudDQ4MzgyNjAwNg==","user":{"login":"swinslow","id":678569,"node_id":"MDQ6VXNlcjY3ODU2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/678569?v=4","gravatar_id":"","url":"https://api.github.com/users/swinslow","html_url":"https://github.com/swinslow","followers_url":"https://api.github.com/users/swinslow/followers","following_url":"https://api.github.com/users/swinslow/following{/other_user}","gists_url":"https://api.github.com/users/swinslow/gists{/gist_id}","starred_url":"https://api.github.com/users/swinslow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/swinslow/subscriptions","organizations_url":"https://api.github.com/users/swinslow/orgs","repos_url":"https://api.github.com/users/swinslow/repos","events_url":"https://api.github.com/users/swinslow/events{/privacy}","received_events_url":"https://api.github.com/users/swinslow/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-04-16T20:13:56Z","updated_at":"2019-04-16T20:13:56Z","body":"I note that the license is limited to use and reproduction; prohibits modification; and also prohibits reverse engineering. Although it doesn't appear to be explicitly \"binary only\" like #839, it reads to me like that's the intention here.\r\n\r\nThis does not fit with the SPDX license inclusion principles (https://spdx.org/spdx-license-list/license-list-overview). I suggest this should be rejected and this issue should be closed.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/483826006/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/484049171","html_url":"https://github.com/spdx/license-list-XML/issues/838#issuecomment-484049171","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/838","id":484049171,"node_id":"MDEyOklzc3VlQ29tbWVudDQ4NDA0OTE3MQ==","user":{"login":"reversi-fun","id":2231549,"node_id":"MDQ6VXNlcjIyMzE1NDk=","avatar_url":"https://avatars.githubusercontent.com/u/2231549?v=4","gravatar_id":"","url":"https://api.github.com/users/reversi-fun","html_url":"https://github.com/reversi-fun","followers_url":"https://api.github.com/users/reversi-fun/followers","following_url":"https://api.github.com/users/reversi-fun/following{/other_user}","gists_url":"https://api.github.com/users/reversi-fun/gists{/gist_id}","starred_url":"https://api.github.com/users/reversi-fun/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/reversi-fun/subscriptions","organizations_url":"https://api.github.com/users/reversi-fun/orgs","repos_url":"https://api.github.com/users/reversi-fun/repos","events_url":"https://api.github.com/users/reversi-fun/events{/privacy}","received_events_url":"https://api.github.com/users/reversi-fun/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-04-17T11:44:50Z","updated_at":"2019-04-17T11:53:50Z","body":"Oh!\r\nHaving found a new license from the Intel site, I suggested adding it to the SPDX license list.\r\nBut The successor license of spdx/Intel(and spdx/Intel-ACPI) has disappeared.\r\n\r\nI would like to add more description, either in overview or somewhere.\r\n  https://spdx.org/spdx-license-list/license-list-overview\r\n * \"or later\":\r\n   The author of the license may also expect to apply the newer text.\r\n   You may feel obliged to search for newer license terms from  \"the name of the author\" or \"The URL\"  of the license.\r\n   But,New licenses may not be found from the spdx license.\r\n   Because new License is does not fit with the SPDX license inclusion principles.\r\n   For example, if the software license that configures linux changes to a firmware(\"binary only\") license.\r\n   Not all licenses for using Liunx are included in the spdx license list, as [calculate-linux/ipw3945](https://old.calculate-linux.org/packages/licenses/ipw3945).\r\n\r\n * \"The URL\" in \"Other web pages for this license\":\r\n   The URLs listed here may be broken, and may be just another/alias-name for the license name.\r\n   The change may not be possible because there may be data identifying the license name in the URL.\r\n   Inferring the name&text of the license from the URL, please know that there is a risk.\r\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/484049171/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/484577063","html_url":"https://github.com/spdx/license-list-XML/issues/838#issuecomment-484577063","issue_url":"https://api.github.com/repos/spdx/license-list-XML/issues/838","id":484577063,"node_id":"MDEyOklzc3VlQ29tbWVudDQ4NDU3NzA2Mw==","user":{"login":"swinslow","id":678569,"node_id":"MDQ6VXNlcjY3ODU2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/678569?v=4","gravatar_id":"","url":"https://api.github.com/users/swinslow","html_url":"https://github.com/swinslow","followers_url":"https://api.github.com/users/swinslow/followers","following_url":"https://api.github.com/users/swinslow/following{/other_user}","gists_url":"https://api.github.com/users/swinslow/gists{/gist_id}","starred_url":"https://api.github.com/users/swinslow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/swinslow/subscriptions","organizations_url":"https://api.github.com/users/swinslow/orgs","repos_url":"https://api.github.com/users/swinslow/repos","events_url":"https://api.github.com/users/swinslow/events{/privacy}","received_events_url":"https://api.github.com/users/swinslow/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-04-18T16:12:08Z","updated_at":"2019-04-18T16:12:08Z","body":"Discussed on 2019-04-18 Legal Team call, agreed that this should be rejected as being apparently binary-only and not allowing modifications or reverse-engineering. \r\n\r\nGiven that, the Legal Team believes this is intended for use as a binary-only, non-source license. If you can provide evidence that this is used for source code, we could reconsider.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/spdx/license-list-XML/issues/comments/484577063/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]