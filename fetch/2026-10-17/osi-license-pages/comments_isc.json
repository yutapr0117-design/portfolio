[{"id":277,"post":504,"parent":0,"author":7,"author_name":"sinuhe","author_url":"","date":"2010-01-08T00:23:21","date_gmt":"2010-01-08T00:23:21","content":{"rendered":"<p><strong>and\/or<\/strong><br \/>The original ISC license said &#8220;and distribute.&#8221; My understanding is that this addition was requested by rms for approval by the FSF, (I believe the issue was related to Pine, and the interpretation UW used). OpenBSD does not use and\/or, but instead uses the ISC license before this was modified. I think it should be clarified that the OpenBSD usage is a valid variation of the ISC License.<\/p>\n"},"link":"https:\/\/opensource.org\/license\/isc#comment-277","status":"approved","type":"comment","author_avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=48&d=mm&r=g","96":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=96&d=mm&r=g"},"meta":{"_wp_note_status":null,"protocol":"","webmention_target_url":"","webmention_source_url":"","webmention_target_fragment":"","webmention_last_modified":"","webmention_response_code":"","webmention_vouch_url":"","url":"","avatar":""},"acf":[],"_links":{"self":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments\/277","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments"}],"author":[{"embeddable":true,"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/users\/7"}],"up":[{"embeddable":true,"post_type":"license","href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/license\/504"}]}}]