[{"id":341,"post":395,"parent":0,"author":0,"author_name":"akole","author_url":"","date":"2012-03-13T17:52:54","date_gmt":"2012-03-13T17:52:54","content":{"rendered":"<p><strong>License inclusion term clarification<\/strong><br \/>May I enquire as to what specific forms are permissable to meet the &#8220;&#8230;The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software&#8230;&#8221; requirement?<\/p>\n<p>For example, does the notice need to appear within an application&#8217;s user interface somewhere?  If so, does it matter where?  If not, how specifically does it need to be incorporated?  Embedded within any file?  Only a separate file?  What about a a phone app, where this would be impractical?<\/p>\n<p>What about a hardware product where the code is compiled into firmware and there is no practical or desirable way of displaying the notice?<\/p>\n<p>Thanks in advance!<\/p>\n"},"link":"https:\/\/opensource.org\/license\/mit#comment-341","status":"approved","type":"comment","author_avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/9fc460c27e4b24a8fe3d024fbdd679ad99109d054bfb01693e7cd5a4bff02daf?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/9fc460c27e4b24a8fe3d024fbdd679ad99109d054bfb01693e7cd5a4bff02daf?s=48&d=mm&r=g","96":"https:\/\/secure.gravatar.com\/avatar\/9fc460c27e4b24a8fe3d024fbdd679ad99109d054bfb01693e7cd5a4bff02daf?s=96&d=mm&r=g"},"meta":{"_wp_note_status":null,"protocol":"","webmention_target_url":"","webmention_source_url":"","webmention_target_fragment":"","webmention_last_modified":"","webmention_response_code":"","webmention_vouch_url":"","url":"","avatar":""},"acf":[],"_links":{"self":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments\/341","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments"}],"up":[{"embeddable":true,"post_type":"license","href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/license\/395"}]}},{"id":340,"post":395,"parent":329,"author":0,"author_name":"Anne Mouse","author_url":"","date":"2012-03-05T15:58:32","date_gmt":"2012-03-05T15:58:32","content":{"rendered":"<p><strong>nope<\/strong><br \/>The part about &#8220;permit persons to whom the software is furnished&#8230;&#8221;  says that the license is sublicensable.  In other words, person A gives software to person B, and under this license, not only can person B do various stuff (e.g. modify), but also, person B has the authority to give the same permissions (or any subset of permissions, as person B chooses) to any person(s) C that B chooses.<\/p>\n<p>Assuming person A is the copyright holder, it would be a little bit pointless for person A to choose this license if he didn&#8217;t intend to include the source code.  The license gives B the *right* to modify, so one hopes that person A would also give person B the *power* to do so.  But the license doesn&#8217;t force A to give B the source.  It doesn&#8217;t force B to give C the source either, even if B gets the source from A.    Which makes sense, because B doesn&#8217;t have to pass along any of the rights (e.g., right to modify) that B doesn&#8217;t want to.<\/p>\n<p>If you choose this license, you are allowing anybody to take the source away and distribute only the binaries.<\/p>\n"},"link":"https:\/\/opensource.org\/license\/mit#comment-340","status":"approved","type":"comment","author_avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/52dc6bfa3bf3b08b8529fd4b9de63c2be0ac421c6e41e7646ddcb645766bb5ea?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/52dc6bfa3bf3b08b8529fd4b9de63c2be0ac421c6e41e7646ddcb645766bb5ea?s=48&d=mm&r=g","96":"https:\/\/secure.gravatar.com\/avatar\/52dc6bfa3bf3b08b8529fd4b9de63c2be0ac421c6e41e7646ddcb645766bb5ea?s=96&d=mm&r=g"},"meta":{"_wp_note_status":null,"protocol":"","webmention_target_url":"","webmention_source_url":"","webmention_target_fragment":"","webmention_last_modified":"","webmention_response_code":"","webmention_vouch_url":"","url":"","avatar":""},"acf":[],"_links":{"self":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments\/340","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments"}],"up":[{"embeddable":true,"post_type":"license","href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/license\/395"}],"in-reply-to":[{"embeddable":true,"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments\/329"}]}},{"id":339,"post":395,"parent":333,"author":0,"author_name":"Anne Mouse","author_url":"","date":"2012-03-05T15:40:05","date_gmt":"2012-03-05T15:40:05","content":{"rendered":"<p><strong>it&#8217;s included<\/strong><br \/>Look inside the FlexSlider download for a file named LICENSE.txt \ud83d\ude42<\/p>\n"},"link":"https:\/\/opensource.org\/license\/mit#comment-339","status":"approved","type":"comment","author_avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/52dc6bfa3bf3b08b8529fd4b9de63c2be0ac421c6e41e7646ddcb645766bb5ea?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/52dc6bfa3bf3b08b8529fd4b9de63c2be0ac421c6e41e7646ddcb645766bb5ea?s=48&d=mm&r=g","96":"https:\/\/secure.gravatar.com\/avatar\/52dc6bfa3bf3b08b8529fd4b9de63c2be0ac421c6e41e7646ddcb645766bb5ea?s=96&d=mm&r=g"},"meta":{"_wp_note_status":null,"protocol":"","webmention_target_url":"","webmention_source_url":"","webmention_target_fragment":"","webmention_last_modified":"","webmention_response_code":"","webmention_vouch_url":"","url":"","avatar":""},"acf":[],"_links":{"self":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments\/339","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments"}],"up":[{"embeddable":true,"post_type":"license","href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/license\/395"}],"in-reply-to":[{"embeddable":true,"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments\/333"}]}},{"id":338,"post":395,"parent":333,"author":0,"author_name":"HolyPhoenix","author_url":"","date":"2012-03-02T07:20:39","date_gmt":"2012-03-02T07:20:39","content":{"rendered":"<p><strong>Hi, I think you misunderstand what this is<\/strong><br \/>I am glad you are worried about making sure you don&#8217;t steal software.  The MIT license is what you agree to when you use the software, not something you have to purchase though.  So feel right ahead to use the slider, without purchasing anything.  Just make sure you follow the rules stated by the MIT License above our posts.  \ud83d\ude09<\/p>\n"},"link":"https:\/\/opensource.org\/license\/mit#comment-338","status":"approved","type":"comment","author_avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/2f86bc20c045900fb68c496c3ca7732b6634fa90a971cedb625dbf2e9b0ccbc2?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/2f86bc20c045900fb68c496c3ca7732b6634fa90a971cedb625dbf2e9b0ccbc2?s=48&d=mm&r=g","96":"https:\/\/secure.gravatar.com\/avatar\/2f86bc20c045900fb68c496c3ca7732b6634fa90a971cedb625dbf2e9b0ccbc2?s=96&d=mm&r=g"},"meta":{"_wp_note_status":null,"protocol":"","webmention_target_url":"","webmention_source_url":"","webmention_target_fragment":"","webmention_last_modified":"","webmention_response_code":"","webmention_vouch_url":"","url":"","avatar":""},"acf":[],"_links":{"self":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments\/338","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments"}],"up":[{"embeddable":true,"post_type":"license","href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/license\/395"}],"in-reply-to":[{"embeddable":true,"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments\/333"}]}},{"id":335,"post":395,"parent":282,"author":0,"author_name":"bloggertom","author_url":"","date":"2012-01-23T17:52:43","date_gmt":"2012-01-23T17:52:43","content":{"rendered":"<p><strong>Yes<\/strong><br \/>Your well within your right to do that so long as the MIT parts retain a copy of the license.<\/p>\n"},"link":"https:\/\/opensource.org\/license\/mit#comment-335","status":"approved","type":"comment","author_avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/6b20503b9e9786e418b5f330d9de7de5cdbaaae76f1586abddbb21d5c5f25989?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/6b20503b9e9786e418b5f330d9de7de5cdbaaae76f1586abddbb21d5c5f25989?s=48&d=mm&r=g","96":"https:\/\/secure.gravatar.com\/avatar\/6b20503b9e9786e418b5f330d9de7de5cdbaaae76f1586abddbb21d5c5f25989?s=96&d=mm&r=g"},"meta":{"_wp_note_status":null,"protocol":"","webmention_target_url":"","webmention_source_url":"","webmention_target_fragment":"","webmention_last_modified":"","webmention_response_code":"","webmention_vouch_url":"","url":"","avatar":""},"acf":[],"_links":{"self":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments\/335","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments"}],"up":[{"embeddable":true,"post_type":"license","href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/license\/395"}],"in-reply-to":[{"embeddable":true,"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments\/282"}]}},{"id":333,"post":395,"parent":0,"author":0,"author_name":"gthunen","author_url":"","date":"2012-01-17T20:49:13","date_gmt":"2012-01-17T20:49:13","content":{"rendered":"<p><strong>How do I obtain an MIT license?<\/strong><br \/>I&#8217;m a freelance graphic designer and would like to use the Flexslider widget on my site, but I need to first obtain an MIT license. How do I go about doing this?<\/p>\n"},"link":"https:\/\/opensource.org\/license\/mit#comment-333","status":"approved","type":"comment","author_avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/75f5983197c4b6c0cb21a1b6c9bb5825e3d72ebadb6c8d69013301636d8b1128?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/75f5983197c4b6c0cb21a1b6c9bb5825e3d72ebadb6c8d69013301636d8b1128?s=48&d=mm&r=g","96":"https:\/\/secure.gravatar.com\/avatar\/75f5983197c4b6c0cb21a1b6c9bb5825e3d72ebadb6c8d69013301636d8b1128?s=96&d=mm&r=g"},"meta":{"_wp_note_status":null,"protocol":"","webmention_target_url":"","webmention_source_url":"","webmention_target_fragment":"","webmention_last_modified":"","webmention_response_code":"","webmention_vouch_url":"","url":"","avatar":""},"acf":[],"_links":{"self":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments\/333","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments"}],"up":[{"embeddable":true,"post_type":"license","href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/license\/395"}],"children":[{"embeddable":true,"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments?parent=333"}]}},{"id":332,"post":395,"parent":0,"author":7,"author_name":"Anas R.","author_url":"","date":"2011-08-29T11:14:30","date_gmt":"2011-08-29T11:14:30","content":{"rendered":"<p><strong>Arabic Translation<\/strong><br \/>\u064a\u0645\u0643\u0646 \u0627\u0644\u0627\u0637\u0644\u0627\u0639 \u0639\u0644\u0649 \u0646\u0633\u062e\u0629 \u0645\u062a\u0631\u062c\u0645\u0629 \u0644\u0644\u0639\u0631\u0628\u064a\u0629 \u0639\u0644\u0649 \u0627\u0644\u0639\u0646\u0648\u0627\u0646:<br \/>\n<a href=\"http:\/\/os-licenses.richstyle.org\/MIT-ar.php\" rel=\"nofollow ugc\">http:\/\/os-licenses.richstyle.org\/MIT-ar.php<\/a><\/p>\n"},"link":"https:\/\/opensource.org\/license\/mit#comment-332","status":"approved","type":"comment","author_avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=48&d=mm&r=g","96":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=96&d=mm&r=g"},"meta":{"_wp_note_status":null,"protocol":"","webmention_target_url":"","webmention_source_url":"","webmention_target_fragment":"","webmention_last_modified":"","webmention_response_code":"","webmention_vouch_url":"","url":"","avatar":""},"acf":[],"_links":{"self":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments\/332","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments"}],"author":[{"embeddable":true,"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/users\/7"}],"up":[{"embeddable":true,"post_type":"license","href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/license\/395"}]}},{"id":331,"post":395,"parent":286,"author":7,"author_name":"ToolmakerSteve","author_url":"","date":"2011-08-18T09:04:32","date_gmt":"2011-08-18T09:04:32","content":{"rendered":"<p><strong>not copyleft because your changes may be different license<\/strong><br \/>I just realized a possible source of confusion:<\/p>\n<p>The MIT license is only required to be retained for the work that you incorporate. You are free to use DIFFERENT LICENSING TERMS for any work that you add. You do NOT have to release your modifications under the MIT license.<\/p>\n<p>If the MIT license stated that you had to release YOUR changes under the same license, then it would indeed be CopyLeft.  But it doesn&#8217;t. Perhaps it should be revised to explicitly state that the right to modify\/etc the software includes the right to use different licensing terms for the modified portions (as long as the original copyright is preserved\/made-visible for the included work).<\/p>\n"},"link":"https:\/\/opensource.org\/license\/mit#comment-331","status":"approved","type":"comment","author_avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=48&d=mm&r=g","96":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=96&d=mm&r=g"},"meta":{"_wp_note_status":null,"protocol":"","webmention_target_url":"","webmention_source_url":"","webmention_target_fragment":"","webmention_last_modified":"","webmention_response_code":"","webmention_vouch_url":"","url":"","avatar":""},"acf":[],"_links":{"self":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments\/331","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments"}],"author":[{"embeddable":true,"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/users\/7"}],"up":[{"embeddable":true,"post_type":"license","href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/license\/395"}],"in-reply-to":[{"embeddable":true,"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments\/286"}]}},{"id":330,"post":395,"parent":286,"author":7,"author_name":"ToolmakerSteve","author_url":"","date":"2011-08-18T08:35:43","date_gmt":"2011-08-18T08:35:43","content":{"rendered":"<p><strong>No, the MIT license is NOT &#8220;Copyleft&#8221;.<\/strong><br \/>No, the MIT license is NOT &#8220;Copyleft&#8221;.<\/p>\n<p>Copyleft licenses are designed for authors of &#8216;free&#8217; software, who wish to ensure that their work can ONLY be used in other &#8216;free&#8217; software.  Such an author chooses a path where everyone contributes &#8216;free&#8217; software, and no one can include such work in &#8216;un-free&#8217; software. [As always, referring to everyone&#8217;s ability to distribute, build on, modify, etc, the software, not to price.]<\/p>\n<p>The MIT license is different. It is for authors who are willing to have their work be widely used, in both &#8216;free&#8217; and commercial (proprietary) software. That is, it is fine with such an author if someone else makes use of their work, but feels that they are not in a position to offer such freedom.<\/p>\n<p>These are two philosophically different paths for sharing work with the broader community. Each path has its benefits.<\/p>\n<p>There is also a third alternative, represented by LGPL (The &#8220;Lesser Freedom&#8221; license). Here, the work itself must remain &#8216;free&#8217; &#8211; all modifications to it must be made available to everyone, but it can be *linked* with &#8216;non-free&#8217; work, as long as certain conditions are maintained.<\/p>\n<p>For example, I make my living developing custom software for clients. I (or my clients) have a business model that is not consistent with CopyLeft freedom. Therefore, I only use MIT licensed or LGPL licensed software.<\/p>\n"},"link":"https:\/\/opensource.org\/license\/mit#comment-330","status":"approved","type":"comment","author_avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=48&d=mm&r=g","96":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=96&d=mm&r=g"},"meta":{"_wp_note_status":null,"protocol":"","webmention_target_url":"","webmention_source_url":"","webmention_target_fragment":"","webmention_last_modified":"","webmention_response_code":"","webmention_vouch_url":"","url":"","avatar":""},"acf":[],"_links":{"self":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments\/330","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments"}],"author":[{"embeddable":true,"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/users\/7"}],"up":[{"embeddable":true,"post_type":"license","href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/license\/395"}],"in-reply-to":[{"embeddable":true,"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments\/286"}]}},{"id":329,"post":395,"parent":0,"author":7,"author_name":"mavc","author_url":"","date":"2011-07-12T14:25:19","date_gmt":"2011-07-12T14:25:19","content":{"rendered":"<p><strong>Requirement to provide the source code<\/strong><br \/>I&#8217;m referring to the following part-sentence:<br \/>\n&#8220;to permit persons to whom the Software is furnished to do so&#8221;<\/p>\n<p>Does this mean that person1, referred to in the text as &#8220;any person&#8221;, is required to give access to the complete source code to person2, referred to in the text as &#8220;persons to whom the Software is furnished&#8221;?<\/p>\n<p>I&#8217;m asking because it seems that you need the source code to &#8220;to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and\/or sell copies of the Software&#8221;, which is contradictory to the &#8220;without restriction&#8221; part?<\/p>\n"},"link":"https:\/\/opensource.org\/license\/mit#comment-329","status":"approved","type":"comment","author_avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=48&d=mm&r=g","96":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=96&d=mm&r=g"},"meta":{"_wp_note_status":null,"protocol":"","webmention_target_url":"","webmention_source_url":"","webmention_target_fragment":"","webmention_last_modified":"","webmention_response_code":"","webmention_vouch_url":"","url":"","avatar":""},"acf":[],"_links":{"self":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments\/329","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments"}],"author":[{"embeddable":true,"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/users\/7"}],"up":[{"embeddable":true,"post_type":"license","href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/license\/395"}],"children":[{"embeddable":true,"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments?parent=329"}]}},{"id":328,"post":395,"parent":286,"author":7,"author_name":"Sohmc","author_url":"","date":"2011-05-25T15:40:47","date_gmt":"2011-05-25T15:40:47","content":{"rendered":"<p><strong>MIT License is NOT Copyleft <\/strong><br \/>Copyleft refers to whether the license perpetuates to derivatives based on the licensed work.  For example, GPL license requires programs that use material from GPL licensed software to be licensed under the GPL.  MIT does not have this requirement.<\/p>\n"},"link":"https:\/\/opensource.org\/license\/mit#comment-328","status":"approved","type":"comment","author_avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=48&d=mm&r=g","96":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=96&d=mm&r=g"},"meta":{"_wp_note_status":null,"protocol":"","webmention_target_url":"","webmention_source_url":"","webmention_target_fragment":"","webmention_last_modified":"","webmention_response_code":"","webmention_vouch_url":"","url":"","avatar":""},"acf":[],"_links":{"self":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments\/328","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments"}],"author":[{"embeddable":true,"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/users\/7"}],"up":[{"embeddable":true,"post_type":"license","href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/license\/395"}],"in-reply-to":[{"embeddable":true,"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments\/286"}]}},{"id":286,"post":395,"parent":0,"author":7,"author_name":"opensourcefan","author_url":"","date":"2010-04-15T23:11:00","date_gmt":"2010-04-15T23:11:00","content":{"rendered":"<p><strong>Copyleft or not?<\/strong><br \/>>The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.<br \/>\nThen why does Wikipedia state (unreferenced) this license is NOT copyleft? Does Wikipedia need fixing? Is there a reliable source about this?<\/p>\n"},"link":"https:\/\/opensource.org\/license\/mit#comment-286","status":"approved","type":"comment","author_avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=48&d=mm&r=g","96":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=96&d=mm&r=g"},"meta":{"_wp_note_status":null,"protocol":"","webmention_target_url":"","webmention_source_url":"","webmention_target_fragment":"","webmention_last_modified":"","webmention_response_code":"","webmention_vouch_url":"","url":"","avatar":""},"acf":[],"_links":{"self":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments\/286","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments"}],"author":[{"embeddable":true,"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/users\/7"}],"up":[{"embeddable":true,"post_type":"license","href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/license\/395"}],"children":[{"embeddable":true,"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments?parent=286"}]}},{"id":282,"post":395,"parent":0,"author":7,"author_name":"aladdin","author_url":"","date":"2010-03-16T06:37:36","date_gmt":"2010-03-16T06:37:36","content":{"rendered":"<p><strong>Sublicensing<\/strong><br \/>If I obtain code under the MIT license, then make changes to it. Can I sub-license it under my own terms? Or do I have to still include their original MIT license with my software.<\/p>\n<p>Basically I&#8217;m creating software that contains MIT licensed code, but I want to sell it with my own sub-license for the end users so they can&#8217;t redistribute it for free.<\/p>\n"},"link":"https:\/\/opensource.org\/license\/mit#comment-282","status":"approved","type":"comment","author_avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=48&d=mm&r=g","96":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=96&d=mm&r=g"},"meta":{"_wp_note_status":null,"protocol":"","webmention_target_url":"","webmention_source_url":"","webmention_target_fragment":"","webmention_last_modified":"","webmention_response_code":"","webmention_vouch_url":"","url":"","avatar":""},"acf":[],"_links":{"self":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments\/282","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments"}],"author":[{"embeddable":true,"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/users\/7"}],"up":[{"embeddable":true,"post_type":"license","href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/license\/395"}],"children":[{"embeddable":true,"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments?parent=282"}]}},{"id":278,"post":395,"parent":0,"author":7,"author_name":"Samuel72","author_url":"","date":"2010-01-08T13:44:28","date_gmt":"2010-01-08T13:44:28","content":{"rendered":"<p><strong>How To Comply<\/strong><br \/>I&#8217;d like to use some MIT-licensed xml-parsing code in my iPhone game. This seems to require that I package the MIT license with the application. However, my iPhone app does not include extensive documentation and my demographic will not want legal notices shoved in their faces.<\/p>\n<p>My boss is afraid of using this code because our company is very small and doesn&#8217;t have the money for any type of legal battle. What is the best way to comply with the MIT license in an iPhone app without compromising user experience?<br \/>\n___________<br \/>\nSamuel Fattizi<\/p>\n"},"link":"https:\/\/opensource.org\/license\/mit#comment-278","status":"approved","type":"comment","author_avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=48&d=mm&r=g","96":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=96&d=mm&r=g"},"meta":{"_wp_note_status":null,"protocol":"","webmention_target_url":"","webmention_source_url":"","webmention_target_fragment":"","webmention_last_modified":"","webmention_response_code":"","webmention_vouch_url":"","url":"","avatar":""},"acf":[],"_links":{"self":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments\/278","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments"}],"author":[{"embeddable":true,"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/users\/7"}],"up":[{"embeddable":true,"post_type":"license","href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/license\/395"}]}},{"id":275,"post":395,"parent":270,"author":7,"author_name":"shlomif","author_url":"","date":"2009-12-28T14:47:45","date_gmt":"2009-12-28T14:47:45","content":{"rendered":"<p><strong>It&#8217;s perfectly OK.<\/strong><br \/>Feel free to use MIT\/X11 licensed code in your non-open-source apps. You are allowed to link to such code from your application or even change the licence of derivative works (see the permission to &#8220;sub-license&#8221;). What you may need to do is give attribution:<\/p>\n<p><a href=\"http:\/\/en.wikipedia.org\/wiki\/Attribution_%28copyright%29\" rel=\"nofollow ugc\">http:\/\/en.wikipedia.org\/wiki\/Attribution_%28copyright%29<\/a><\/p>\n<p>I.e: say &#8220;libfunctionality , Copyright by J. Random Hacker, 2009&#8221; somewhere. But it would be hard to avoid giving attribution in practically all copyrighted open source code out there.<\/p>\n<p>&#8212;&#8212;&#8212;&#8212;&#8212;&#8212;<\/p>\n<p>Shlomi Fish, <a href=\"http:\/\/www.shlomifish.org\/\" rel=\"nofollow ugc\">http:\/\/www.shlomifish.org\/<\/a><\/p>\n<p>When Chuck Norris uses Gentoo, &#8220;emerge kde&#8221; finishes in under a minute. A computer cannot afford to keep Chuck waiting for too long. <\/p>\n"},"link":"https:\/\/opensource.org\/license\/mit#comment-275","status":"approved","type":"comment","author_avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=48&d=mm&r=g","96":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=96&d=mm&r=g"},"meta":{"_wp_note_status":null,"protocol":"","webmention_target_url":"","webmention_source_url":"","webmention_target_fragment":"","webmention_last_modified":"","webmention_response_code":"","webmention_vouch_url":"","url":"","avatar":""},"acf":[],"_links":{"self":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments\/275","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments"}],"author":[{"embeddable":true,"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/users\/7"}],"up":[{"embeddable":true,"post_type":"license","href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/license\/395"}],"in-reply-to":[{"embeddable":true,"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments\/270"}]}},{"id":274,"post":395,"parent":271,"author":7,"author_name":"shlomif","author_url":"","date":"2009-12-28T14:41:31","date_gmt":"2009-12-28T14:41:31","content":{"rendered":"<p><strong>I think so.<\/strong><br \/>I am not a lawyer,  but I think it&#8217;s good enough. A lot of JavaScript out there does not put the entire licence blurb there to save space. Pedantics (like the Debian project) also need a &#8220;Copyright by Foo Bar, 2009&#8221; statement.<\/p>\n<p>Regarding the wrapper &#8211; it should be OK, but make sure you also reproduce the copyright blurb and a link to the one who originated it. I should note that MIT\/X11-licensed code can be sub-licensed to any other licence.<\/p>\n<p>&#8212;&#8212;&#8212;&#8212;&#8212;&#8212;<\/p>\n<p>Shlomi Fish, <a href=\"http:\/\/www.shlomifish.org\/\" rel=\"nofollow ugc\">http:\/\/www.shlomifish.org\/<\/a><\/p>\n<p>When Chuck Norris uses Gentoo, &#8220;emerge kde&#8221; finishes in under a minute. A computer cannot afford to keep Chuck waiting for too long. <\/p>\n"},"link":"https:\/\/opensource.org\/license\/mit#comment-274","status":"approved","type":"comment","author_avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=48&d=mm&r=g","96":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=96&d=mm&r=g"},"meta":{"_wp_note_status":null,"protocol":"","webmention_target_url":"","webmention_source_url":"","webmention_target_fragment":"","webmention_last_modified":"","webmention_response_code":"","webmention_vouch_url":"","url":"","avatar":""},"acf":[],"_links":{"self":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments\/274","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments"}],"author":[{"embeddable":true,"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/users\/7"}],"up":[{"embeddable":true,"post_type":"license","href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/license\/395"}],"in-reply-to":[{"embeddable":true,"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments\/271"}]}},{"id":271,"post":395,"parent":0,"author":7,"author_name":"searlea","author_url":"","date":"2009-07-28T07:47:07","date_gmt":"2009-07-28T07:47:07","content":{"rendered":"<p><strong>Referring to license via URL<\/strong><br \/>Is it sufficient to refer to the license via URL?  I want to modify and use some code that only refers to the license via:<\/p>\n<p>\/* Licensed under the MIT license: <a href=\"http:\/\/www.opensource.org\/licenses\/mit-license.php\" rel=\"nofollow ugc\">http:\/\/www.opensource.org\/licenses\/mit-license.php<\/a> *\/<\/p>\n<p>Is it OK to integrate code within a larger code-base (e.g. using some MIT-licensed JavaScript within a larger javascript library) with a wrapper \/ comment inserted in the appropriate place:<\/p>\n<p>\/* Function foobar derived from MIT-licensed code: <a href=\"http:\/\/www.opensource.org\/licenses\/mit-license.php\" rel=\"nofollow ugc\">http:\/\/www.opensource.org\/licenses\/mit-license.php<\/a> *\/<\/p>\n<p>Note: I&#8217;ve no idea of the legal significance of changing &#8220;Licensed under the MIT license&#8221; to &#8220;Derived from MIT licensed code&#8221; &#8211; hence the question.<\/p>\n"},"link":"https:\/\/opensource.org\/license\/mit#comment-271","status":"approved","type":"comment","author_avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=48&d=mm&r=g","96":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=96&d=mm&r=g"},"meta":{"_wp_note_status":null,"protocol":"","webmention_target_url":"","webmention_source_url":"","webmention_target_fragment":"","webmention_last_modified":"","webmention_response_code":"","webmention_vouch_url":"","url":"","avatar":""},"acf":[],"_links":{"self":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments\/271","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments"}],"author":[{"embeddable":true,"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/users\/7"}],"up":[{"embeddable":true,"post_type":"license","href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/license\/395"}],"children":[{"embeddable":true,"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments?parent=271"}]}},{"id":270,"post":395,"parent":0,"author":7,"author_name":"matthew123","author_url":"","date":"2009-07-27T16:18:31","date_gmt":"2009-07-27T16:18:31","content":{"rendered":"<p><strong>Another question<\/strong><br \/>If we are making a closed source application, selling this application for profit, include this license in the open source license file, are we breaking any laws?<\/p>\n<p>Thank you for your time.<\/p>\n"},"link":"https:\/\/opensource.org\/license\/mit#comment-270","status":"approved","type":"comment","author_avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=48&d=mm&r=g","96":"https:\/\/secure.gravatar.com\/avatar\/9eb338ef57c391b1cd603cdd2869d78fdc6a51c2fab313e989852da784194ea7?s=96&d=mm&r=g"},"meta":{"_wp_note_status":null,"protocol":"","webmention_target_url":"","webmention_source_url":"","webmention_target_fragment":"","webmention_last_modified":"","webmention_response_code":"","webmention_vouch_url":"","url":"","avatar":""},"acf":[],"_links":{"self":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments\/270","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/comments"}],"author":[{"embeddable":true,"href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/users\/7"}],"up":[{"embeddable":true,"post_type":"license","href":"https:\/\/opensource.org\/wp-json\/wp\/v2\/license\/395"}],"children":[{"embeddable":true,"href":"https:\/\/o